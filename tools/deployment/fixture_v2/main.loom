import deployment.fixture.orders
import deployment.fixture.notes
import deployment.fixture.report
import std.process.arguments
import std.result.Result

pub type Amount = Int where self > 0

pub record Order {
    id Int
    amount Amount
}

pub record Note {
    id Int
    body Text
}

fn make(id Int, amount Int) Result[Order, Text] {
    match Amount(amount) {
        Result.Ok(checked) => Result.Ok(Order {
                id = id
                amount = checked
            })
        Result.Err(_) => Result.Err("amount must be positive")
    }
}

fn main() {
    report(orders(arguments(), make, notes[Note]))
}
