import deployment.fixture.orders
import deployment.fixture.report
import std.process.arguments
import std.result.Result

pub type Amount = Int where self >= 0

pub record Order {
    id Int
    amount Amount
}

fn make(id Int, amount Int) Result[Order, Text] {
    match Amount(amount) {
        Result.Ok(checked) => Result.Ok(Order {
                id = id
                amount = checked
            })
        Result.Err(_) => Result.Err("amount must be nonnegative")
    }
}

pub fn cli() {
    report(orders(arguments(), make))
}

fn main() {
    cli()
}
