import std.loom.manifest.ConfigurationValue

fn dependency_fixture(origin Text, api Text, tests Bool, reordered Bool) Project {
    let owner = if reordered {
        1
    } else {
        0
    }
    let dependency = 1 - owner
    let root = if reordered {
        2
    } else {
        0
    }
    let child = 1
    let library = 2 - root
    let own_module = ModuleInstance {
        configuration = []
        name = "sample"
        source = "/module"
    }
    let dependency_module = ModuleInstance {
        configuration = []
        name = "library"
        source = origin
    }
    let application = Package {
        instance = owner
        relative = ""
        imports = [PackageImport {
                spelling = "library"
                target = library
            }]
    }
    let imported = Package {
        instance = dependency
        relative = ""
        imports = new[PackageImport]()
    }
    let packages = [application, Package {
            instance = owner
            relative = "child"
            imports = application.imports
        }, imported]
    if reordered {
        set(packages, 0, imported)
        set(packages, 2, application)
    }
    let files = new[SourceFile]()
    let texts = ["""
            import library.choose

            fn entry() Int {
                choose(1)
            }
            """, """
            import library.choose

            fn child() Int {
                choose(true)
            }
            """, api]
    let paths = ["/module/app.loom", "/module/child/child.loom", join_path(origin, "api.loom")]
    let owners = [root, child, library]
    var index = 0
    while index < length(texts) {
        let text = get(texts, index)
        push(files, SourceFile {
                package = get(owners, index)
                path = get(paths, index)
                text = text
                tree = package_tree(text)
                test_only = false
                trusted_std = false
            })
        index = index + 1
    }
    if tests {
        let text = """
            import library.choose

            test fn checked_private_scope() {
                assert choose(1) > 0
            }
            """
        push(files, SourceFile {
                package = child
                path = "/module/child/child_test.loom"
                text = text
                tree = package_tree(text)
                test_only = true
                trusted_std = false
            })
    }
    Project {
        files = files
        packages = packages
        modules = if reordered {
            [dependency_module, own_module]
        } else {
            [own_module, dependency_module]
        }
        root = root
    }
}

fn dependency_api() Text {
    """
        pub fn choose[T](value T) Int {
            discard value
            1
        }
        """
}

fn dependency_configured_fixture(values List[ConfigurationValue], tests Bool, reordered Bool) Project {
    let project = dependency_fixture("/cache/library", dependency_api(), tests, reordered)
    let owner = if reordered {
        0
    } else {
        1
    }
    set(project.modules, owner, ModuleInstance {
            configuration = values,
            ..get(project.modules, owner)
        })
    project
}

test fn dependency_review_reports_configuration_changes_with_identical_source_bytes() {
    let first = [ConfigurationValue {
            name = "mode"
            value = "search"
        }, ConfigurationValue {
            name = "empty"
            value = ""
        }]
    let same = [ConfigurationValue {
            name = "empty"
            value = ""
        }, ConfigurationValue {
            name = "mode"
            value = "search"
        }]
    let different = [ConfigurationValue {
            name = "mode"
            value = "export"
        }, ConfigurationValue {
            name = "empty"
            value = ""
        }]
    let before = dependency_configured_fixture(first, false, false)
    let before_tests = dependency_configured_fixture(first, true, false)
    let normalized = dependency_checked_review(before, before_tests,
        dependency_configured_fixture(same, false, true), dependency_configured_fixture(same, true, true))
    assert length(normalized.bindings) == 0
    let changed = dependency_checked_review(before, before_tests,
        dependency_configured_fixture(different, false, true), dependency_configured_fixture(different, true, true))
    assert length(changed.bindings) > 0
    var index = 0
    while index < length(changed.bindings) {
        let change = get(changed.bindings, index)
        assert change.view == DependencyBindingView.Lexical
        assert length(change.before) == 1 && length(change.after) == 1
        assert get(change.before, 0).source.path == get(change.after, 0).source.path
        assert get(change.before, 0).source.digest == get(change.after, 0).source.digest
        assert same_configuration(get(change.before, 0).source.module.configuration, first)
        assert same_configuration(get(change.after, 0).source.module.configuration, different)
        index = index + 1
    }
}

fn dependency_checked_review(before Project, before_tests Project,
    after Project, after_tests Project) DependencyReview {
    match review_dependencies(before, before_tests, after, after_tests) {
        Result.Ok(value) => value
        Result.Err(message) => {
            discard write_error(message)
            assert false
            DependencyReview {
                before = new[DependencySource]()
                after = new[DependencySource]()
                bindings = new[DependencyBindingChange]()
            }
        }
    }
}

test fn dependency_review_uses_module_origins_not_analysis_local_ids() {
    let before = dependency_fixture("/cache/library", dependency_api(), false, false)
    let before_tests = dependency_fixture("/cache/library", dependency_api(), true, false)
    let after = dependency_fixture("/cache/library", dependency_api(), false, true)
    let after_tests = dependency_fixture("/cache/library", dependency_api(), true, true)
    let unchanged = dependency_checked_review(before, before_tests, after, after_tests)
    assert length(unchanged.bindings) == 0
    assert length(unchanged.before) == 4 && length(unchanged.after) == 4
    let fork = dependency_checked_review(before, before_tests,
        dependency_fixture("/cache/fork", dependency_api(), false, true),
        dependency_fixture("/cache/fork", dependency_api(), true, true))
    assert length(fork.bindings) > 0
    var private_test = false
    var index = 0
    while index < length(fork.bindings) {
        let change = get(fork.bindings, index)
        assert change.view == DependencyBindingView.Lexical
        assert length(change.before) == 1 && length(change.after) == 1
        assert get(change.before, 0).source.module.source == "/cache/library"
        assert get(change.after, 0).source.module.source == "/cache/fork"
        private_test = private_test || (change.tests && change.package == "child" &&
            ends_with(change.path, "_test.loom"))
        index = index + 1
    }
    assert private_test
}

fn dependency_overload_fixture(updated Bool, tests Bool) Project {
    let api = concat(if updated {
            "pub fn input() Bool {\n    true\n}\n"
        } else {
            "pub fn input() Int {\n    1\n}\n"
        }, """
            pub fn choose(value Int) Int {
                value
            }
            """)
    let project = dependency_fixture("/cache/library", api, tests, false)
    let entry = get(project.files, 0)
    let text = std.text.replace(std.text.replace(entry.text,
            "import library.choose", "import library.choose\nimport library.input"),
        "choose(1)", "choose(input())")
    set(project.files, 0, SourceFile {
            text = text
            tree = package_tree(text)
            ..entry
        })
    let child = get(project.files, 1)
    let child_text = std.text.replace(child.text, "choose(true)", "choose(1)")
    set(project.files, 1, SourceFile {
            text = child_text
            tree = package_tree(child_text)
            ..child
        })
    if updated {
        let overload = """
            pub fn choose(value Bool) Int {
                if value { 2 } else { 0 }
            }
            """
        push(project.files, SourceFile {
                package = 2
                path = "/cache/library/overload.loom"
                text = overload
                tree = package_tree(overload)
                test_only = false
                trusted_std = false
            })
    }
    project
}

test fn dependency_review_reports_new_overload_selection_and_same_path_edits() {
    let before = dependency_fixture("/cache/library", dependency_api(), false, false)
    let before_tests = dependency_fixture("/cache/library", dependency_api(), true, false)
    let selected = dependency_checked_review(dependency_overload_fixture(false, false),
        dependency_overload_fixture(false, true), dependency_overload_fixture(true, false),
        dependency_overload_fixture(true, true))
    assert length(selected.bindings) > 0
    var root_call = false
    var index = 0
    while index < length(selected.bindings) {
        let change = get(selected.bindings, index)
        assert change.view == DependencyBindingView.Lexical
        assert length(change.before) == 1 && length(change.after) == 1
        assert ends_with(get(change.before, 0).source.path, "api.loom")
        root_call = root_call || (!change.tests && change.path == "/module/app.loom" &&
            ends_with(get(change.after, 0).source.path, "overload.loom"))
        index = index + 1
    }
    assert root_call
    let edited_api = std.text.replace(dependency_api(), "    1", "    2")
    let edited = dependency_checked_review(before, before_tests,
        dependency_fixture("/cache/library", edited_api, false, false),
        dependency_fixture("/cache/library", edited_api, true, false))
    assert length(edited.bindings) > 0
    let change = get(edited.bindings, 0)
    assert get(change.before, 0).source.path == get(change.after, 0).source.path
    assert get(change.before, 0).span.start == get(change.after, 0).span.start
    assert get(change.before, 0).source.digest != get(change.after, 0).source.digest
}

fn dependency_private_test(project Project) Project {
    let file = get(project.files, 3)
    let text = """
        import library.test_value

        test fn checked_private_scope() {
            assert test_value() > 0
        }
        """
    set(project.files, 3, SourceFile {
            text = text
            tree = package_tree(text)
            ..file
        })
    project
}

test fn dependency_review_rejects_unchecked_private_tests_and_application_edits() {
    let before = dependency_fixture("/cache/library", dependency_api(), false, false)
    let before_tests = dependency_fixture("/cache/library", dependency_api(), true, false)
    let incompatible = """
        pub fn choose(value Bool) Int {
            discard value
            1
        }
        """
    assert match review_dependencies(before, before_tests,
        dependency_fixture("/cache/library", incompatible, false, false),
        dependency_fixture("/cache/library", incompatible, true, false)) {
        Result.Err(message) => contains(message, "requires checked source")
        Result.Ok(_) => false
    }
    let changed = dependency_fixture("/cache/library", dependency_api(), false, false)
    let file = get(changed.files, 0)
    let text = std.text.replace(file.text, "choose(1)", "choose(2)")
    set(changed.files, 0, SourceFile {
            text = text
            tree = package_tree(text)
            ..file
        })
    assert match review_dependencies(before, before_tests, changed, before_tests) {
        Result.Err(message) => contains(message, "unchanged application source")
        Result.Ok(_) => false
    }
    let old_api = concat(dependency_api(), "pub fn test_value() Int {\n    1\n}\n")
    let new_api = concat(dependency_api(), "pub fn test_value() Bool {\n    true\n}\n")
    assert match review_dependencies(
        dependency_fixture("/cache/library", old_api, false, false),
        dependency_private_test(dependency_fixture("/cache/library", old_api, true, false)),
        dependency_fixture("/cache/library", new_api, false, false),
        dependency_private_test(dependency_fixture("/cache/library", new_api, true, false))) {
        Result.Err(message) => contains(message, "requires checked source")
        Result.Ok(_) => false
    }
}

test fn dependency_review_does_not_hide_unselected_source_or_stale_ast() {
    let project = dependency_fixture("/cache/library", dependency_api(), false, false)
    let original = get(project.files, 0)
    let text = concat(original.text, """

            fn selected[T](value T) T {
                comptime if true {
                    value
                } else {
                    value
                }
            }
            """)
    set(project.files, 0, SourceFile {
            text = text
            tree = package_tree(text)
            ..original
        })
    assert match review_dependencies(project, project, project, project) {
        Result.Err(message) => contains(message, "unaccounted source references")
        Result.Ok(_) => false
    }
    let stale = dependency_fixture("/cache/library", dependency_api(), false, false)
    let dependency = get(stale.files, 2)
    set(stale.files, 2, SourceFile {
            text = concat(dependency.text, "\n")
            ..dependency
        })
    assert match review_dependencies(stale, stale, stale, stale) {
        Result.Err(message) => contains(message, "text and AST disagree")
        Result.Ok(_) => false
    }
}

fn dependency_generic_method_fixture(origin Text, tests Bool, reordered Bool) Project {
    let api = """
        pub concept Read { fn read(self Self) Int }
        impl Read for Int { fn read(self Int) Int { self + 1 } }
        impl Read for Bool { fn read(self Bool) Int { 7 } }
        """
    let project = dependency_fixture(origin, api, tests, reordered)
    let owner = get(project.packages, project.root).instance
    var index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        if get(project.packages, file.package).instance == owner {
            let relative = get(project.packages, file.package).relative
            let text = if file.test_only {
                "test fn checked_private_scope() { assert child() > 0 }\n"
            } else if relative == "" {
                """
                import library.Read
                fn generic_read[T Read](value T) Int { value.read() }
                fn main() { assert generic_read(7) > 0 && generic_read(true) > 0 }
                """
            } else {
                """
                import library.Read
                fn child_read[T Read](value T) Int { value.read() }
                fn child() Int { child_read(7) + child_read(true) }
                """
            }
            set(project.files, index, SourceFile {
                    text = text,
                    tree = package_tree(text),
                    ..file
                })
        }
        index = index + 1
    }
    project
}

test fn dependency_generic_method_review_keeps_lexical_and_all_instance_targets() {
    let before = dependency_generic_method_fixture("/cache/library", false, false)
    let before_tests = dependency_generic_method_fixture("/cache/library", true, false)
    let unchanged = dependency_checked_review(before, before_tests,
        dependency_generic_method_fixture("/cache/library", false, true),
        dependency_generic_method_fixture("/cache/library", true, true))
    assert length(unchanged.bindings) == 0
    let changed = dependency_checked_review(before, before_tests,
        dependency_generic_method_fixture("/cache/fork", false, true),
        dependency_generic_method_fixture("/cache/fork", true, true))
    var lexical = false
    var observed = false
    var private_test = false
    var index = 0
    while index < length(changed.bindings) {
        let change = get(changed.bindings, index)
        if change.view == DependencyBindingView.Lexical {
            lexical = true
        }
        if change.view == DependencyBindingView.Observed {
            observed = true
            assert length(change.before) == 2 && length(change.after) == 2
            private_test = private_test || (change.tests && change.root == "child")
        }
        let sides = [change.before, change.after]
        var side = 0
        while side < 2 {
            let targets = get(sides, side)
            var target = 0
            while target < length(targets) {
                assert get(targets, target).source.module.source == if side == 0 {
                    "/cache/library"
                } else {
                    "/cache/fork"
                }
                target = target + 1
            }
            side = side + 1
        }
        index = index + 1
    }
    assert lexical && observed && private_test
}

fn dependency_default_methods(tests Bool) Project {
    let project = dependency_generic_method_fixture("/cache/library", tests, true)
    var index = 0
    while index < length(project.files) {
        let file = get(project.files, index)
        if !dependency_owned(project, file.package) {
            let text = """
                pub concept Read { fn read(self Self) Int { 7 } }
                impl Read for Int {}
                impl Read for Bool {}
                """
            set(project.files, index, SourceFile {
                    text = text,
                    tree = package_tree(text),
                    ..file
                })
        }
        index = index + 1
    }
    project
}

test fn dependency_review_reports_removed_distinct_observations_without_pairing_defaults() {
    let review = dependency_checked_review(
        dependency_generic_method_fixture("/cache/library", false, false),
        dependency_generic_method_fixture("/cache/library", true, false),
        dependency_default_methods(false), dependency_default_methods(true))
    var removed = false
    var index = 0
    while index < length(review.bindings) {
        let change = get(review.bindings, index)
        if change.view == DependencyBindingView.Observed {
            assert length(change.before) == 2 && length(change.after) == 0
            removed = true
        }
        index = index + 1
    }
    assert removed
}

fn dependency_generic_configuration(value Text, tests Bool, reordered Bool) Project {
    let project = dependency_generic_method_fixture("/cache/library", tests, reordered)
    var index = 0
    while index < length(project.modules) {
        let instance = get(project.modules, index)
        if instance.name == "library" {
            set(project.modules, index, ModuleInstance {
                    configuration = [ConfigurationValue {
                            name = "mode",
                            value = value
                        }],
                    ..instance
                })
        }
        index = index + 1
    }
    project
}

test fn dependency_generic_instances_keep_configuration_identity_with_equal_bytes() {
    let review = dependency_checked_review(
        dependency_generic_configuration("search", false, false),
        dependency_generic_configuration("search", true, false),
        dependency_generic_configuration("export", false, true),
        dependency_generic_configuration("export", true, true))
    var observed = false
    var index = 0
    while index < length(review.bindings) {
        let change = get(review.bindings, index)
        let count = if change.view == DependencyBindingView.Lexical {
            1
        } else {
            2
        }
        assert length(change.before) == count && length(change.after) == count
        observed = observed || change.view == DependencyBindingView.Observed
        var target = 0
        while target < count {
            let before = get(change.before, target).source
            let after = get(change.after, target).source
            assert before.path == after.path && before.digest == after.digest
            assert get(before.module.configuration, 0).value == "search"
            assert get(after.module.configuration, 0).value == "export"
            target = target + 1
        }
        index = index + 1
    }
    assert observed
}

test fn dependency_review_reports_added_distinct_observations_without_pairing_defaults() {
    let review = dependency_checked_review(
        dependency_default_methods(false), dependency_default_methods(true),
        dependency_generic_method_fixture("/cache/library", false, false),
        dependency_generic_method_fixture("/cache/library", true, false))
    var added = false
    var index = 0
    while index < length(review.bindings) {
        let change = get(review.bindings, index)
        if change.view == DependencyBindingView.Observed {
            assert length(change.before) == 0 && length(change.after) == 2
            added = true
        }
        index = index + 1
    }
    assert added
}
