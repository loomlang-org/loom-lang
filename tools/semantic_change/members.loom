import std.loom.source.Span

record MemberScope {
    id Text
    locator Text
    span Span
    body Span
}

fn member_scope_key(member MemberScope) Text {
    if member.id == "" { member.locator } else { concat("member ", member.id) }
}

// A rename edits tokens, never member order. Map the checked member anchor
// through those exact edits before restoring its revision-local locator.
fn renamed_scope(original Entry, scope Text, anchor Int) Result[Text, Text] {
    if scope == "" {
        return Result.Ok(scope)
    }
    var index = 0
    while index < length(original.members) {
        let member = get(original.members, index)
        if member.span.start - original.start == anchor {
            return Result.Ok(member_scope_key(member))
        }
        index = index + 1
    }
    Result.Err("renamed binding has no original checked member scope")
}

// An identified container owns checked API slots. These revision-local member
// locators are not new durable IDs or permission to merge concurrent bodies.
fn member_scopes(node Node, empty List[MemberScope]) Result[List[MemberScope], Text] {
    member_scopes(node, empty, new[Identity](), "", "")
}

fn member_scopes(node Node, empty List[MemberScope], identities List[Identity], owner Text, path Text) Result[List[MemberScope], Text] {
    if node.kind != NodeKind.Concept && node.kind != NodeKind.Impl {
        return Result.Ok(empty)
    }
    let members = new[MemberScope]()
    var index = 0
    while index < length(node.children) {
        let member = get(node.children, index)
        if member.kind == NodeKind.Function || member.kind == NodeKind.AssociatedType {
            var id = ""
            let key = declaration_key(member)?
            var identity = 0
            while identity < length(identities) {
                let candidate = get(identities, identity)
                if candidate.owner == owner && owner != "" && candidate.path == path &&
                candidate.kind == member.kind && candidate.name == member.value && candidate.key == key {
                    if id != "" { return Result.Err("ambiguous stable member identity") }
                    id = candidate.id
                }
                identity = identity + 1
            }
            let locator = concat(if member.kind == NodeKind.Function {
                    "fn "
                } else {
                    "type "
                }, concat(member.value, concat(" ", key)))
            var previous = 0
            while previous < length(members) {
                if get(members, previous).locator == locator {
                    return Result.Err("identified container has an ambiguous member locator")
                }
                previous = previous + 1
            }
            push(members, MemberScope {
                    id = id
                    locator = locator
                    span = member.span
                    body = member_body(member)
                })
        }
        index = index + 1
    }
    Result.Ok(members)
}

fn member_body(node Node) Span {
    if node.kind == NodeKind.Function {
        var index = 0
        while index < length(node.children) {
            let child = get(node.children, index)
            if child.kind == NodeKind.Block {
                return child.span
            }
            index = index + 1
        }
    }
    Span {
        start = -1
        end = -1
    }
}

fn scoped_target(entry Entry, package Int, location Span) Result[BindingTarget, Text] {
    var anchor = 0
    var scope = ""
    var index = 0
    while index < length(entry.members) {
        let member = get(entry.members, index)
        if location.start >= member.span.start && location.end <= member.span.end {
            if scope != "" {
                return Result.Err("checked definition has an ambiguous member scope")
            }
            scope = member_scope_key(member)
            anchor = member.span.start - entry.start
        }
        index = index + 1
    }
    Result.Ok(BindingTarget {
            id = entry.id
            package = package
            path = ""
            scope = scope
            anchor = anchor
            start = location.start - entry.start
            end = location.end - entry.start
        })
}
