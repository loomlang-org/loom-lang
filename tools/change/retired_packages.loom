// A source-free package can retain its existing sidecar as history. It owns
// no active declarations and never enters the checked import graph.
fn retired_relative(relative Text) Option[Text] {
    if relative == ".loom-ids" {
        return Option.Some("")
    }
    if ends_with(relative, "/.loom-ids") {
        return Option.Some(std.text.slice(relative, 0, std.text.length(relative) - 10))
    }
    Option.None
}

fn retired_path(relative Text) Text {
    if relative == "" {
        ".loom-ids"
    } else {
        concat(relative, "/.loom-ids")
    }
}

fn retired_header(bytes Bytes) Result[Header, Text] {
    let text = match decode_utf8(bytes) {
        Result.Ok(value) => value
        Result.Err(_) => {
            return Result.Err("retired package sidecar is not UTF-8")
        }
    }
    let value = header(text, "retired package .loom-ids")?
    if length(value.identities) != 0 || value.draft != "" || length(value.lineage) == 0 {
        return Result.Err("source-free identity sidecar must contain only resolved derivation history")
    }
    Result.Ok(value)
}

fn retired_metadata(snapshot ModuleSnapshot, relative Text) Result[Header, Text] {
    let index = asset_index(snapshot.assets, retired_path(relative))
    if index < 0 {
        return Result.Err("deleted package must retain its derivation history sidecar")
    }
    retired_header(get(snapshot.assets, index).bytes)
}

// Replay the existing allocator from the retained high-water mark. No former
// declaration can acquire its old ID just by reusing a name. This admits the
// explicit fresh refresh operation, not a guessed restoration of old identity.
fn reactivated_allocation(previous Header, candidates List[Identity], kept List[Identity],
    next Int) Result[Int, Text] {
    var sequence = next
    var index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        var id = ""
        var allocated = false
        while !allocated {
            if sequence >= 9223372036854775806 {
                return Result.Err("reactivated package identity allocator exhausted")
            }
            id = fresh_id(previous.package_name, candidate, sequence)
            sequence = sequence + 1
            allocated = !lineage_known(new[Identity](), previous.lineage, id) && identity_at(kept, id) < 0
        }
        push(kept, Identity {
                id = id
                ..candidate
            })
        index = index + 1
    }
    Result.Ok(sequence)
}

fn reactivated_package(previous Header, current Loaded) Result[Bool, Text] {
    if previous.package_name != current.revision.package_name {
        return Result.Err("reactivated package must retain its package identity")
    }
    let roots = declarations(current.revision.files)?
    let expected = new[Identity]()
    let next = reactivated_allocation(previous, roots, expected, previous.next)?
    let members = member_declarations(current.revision.files, expected)?
    let final_next = reactivated_allocation(previous, members, expected, next)?
    if final_next != current.next || length(expected) != length(current.revision.identities) {
        return Result.Err("retired package history needs fresh reactivation identities from its retained allocator")
    }
    var index = 0
    while index < length(expected) {
        let identity = get(expected, index)
        let actual = identity_at(current.revision.identities, identity.id)
        if actual < 0 || !same_declaration(identity, get(current.revision.identities, actual)) {
            return Result.Err("retired package history needs fresh reactivation identities from its retained allocator")
        }
        index = index + 1
    }
    let lineage = loaded_lineage(current)?
    discard join_lineage(previous.lineage, lineage, lineage, new[Identity]())?
    index = 0
    while index < length(lineage) {
        let origin = get(lineage, index)
        if lineage_index(previous.lineage, origin.id) < 0 {
            if identity_at(expected, origin.id) < 0 {
                return Result.Err("reactivated package has an origin without a fresh declaration")
            }
            var parent = 0
            while parent < length(origin.parents) {
                if !lineage_known(new[Identity](), previous.lineage, get(origin.parents, parent)) {
                    return Result.Err("reactivated package derivation needs a retained historical parent")
                }
                parent = parent + 1
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

// Ordinary asset edits still cannot remove or rewrite a retired scope. Active
// source needs the exact explicit fresh refresh, including all retained origins.
fn retain_retired_packages(base ModuleSnapshot, left ModuleSnapshot, right ModuleSnapshot) Result[Bool, Text] {
    var index = 0
    while index < length(base.assets) {
        let asset = get(base.assets, index)
        match retired_relative(asset.relative) {
            Option.Some(relative) => {
                let branches = [left, right]
                var side = 0
                while side < length(branches) {
                    let branch = get(branches, side)
                    match module_package(branch, relative) {
                        Result.Ok(active) => {
                            discard reactivated_package(retired_header(asset.bytes)?, active)?
                        }
                        Result.Err(_) => {
                            if !equal_asset(base.assets, index, branch.assets, asset_index(branch.assets, asset.relative)) {
                                return Result.Err("retired package history cannot be removed or rewritten")
                            }
                        }
                    }
                    side = side + 1
                }
                match module_package(left, relative) {
                    Result.Ok(a) => match module_package(right, relative) {
                        Result.Ok(b) => {
                            if a.sidecar != b.sidecar || files_stamp(a.revision.files) != files_stamp(b.revision.files) {
                                return Result.Err("concurrent package reactivation requires one explicit selected snapshot")
                            }
                        }
                        Result.Err(_) => {
                        }
                    }
                    Result.Err(_) => {
                    }
                }
            }
            Option.None => {
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn check_retired_deletion(base ModuleSnapshot, left ModuleSnapshot, right ModuleSnapshot,
    assets List[Asset], package ModulePackage) Result[Bool, Text] {
    // Each deleting branch must preserve all previously known origins. The
    // surviving branch can add history too; the chosen sidecar must retain it.
    let lineage = module_review_lineage(base, left, right, package.relative)?
    if length(lineage) == 0 {
        return Result.Ok(true)
    }
    let index = asset_index(assets, retired_path(package.relative))
    if index < 0 {
        return Result.Err("package deletion cannot discard derivation history; retain its resolved .loom-ids")
    }
    let retired = retired_header(get(assets, index).bytes)?
    let next = std.int.maximum(module_next(base, package.relative),
        std.int.maximum(module_next(left, package.relative), module_next(right, package.relative)))
    if retired.package_name != package.loaded.revision.package_name || retired.next != next ||
    lineage_rows(retired.lineage) != lineage_rows(lineage) {
        return Result.Err("retired package sidecar does not retain its package identity, allocator and complete lineage")
    }
    Result.Ok(true)
}

fn check_retired_assets(base ModuleSnapshot, assets List[Asset], removed List[Text]) Result[Bool, Text] {
    var index = 0
    while index < length(assets) {
        let asset = get(assets, index)
        match retired_relative(asset.relative) {
            Option.Some(relative) => {
                if asset_index(base.assets, asset.relative) < 0 && !module_relative_present(removed, relative) {
                    return Result.Err("new retired package history needs the actual removed baseline package")
                }
            }
            Option.None => {
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}
