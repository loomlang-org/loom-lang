import semantic_change.File
import semantic_change.Identity
import semantic_change.Revision
import semantic_change.declaration_key
import semantic_change.declaration_label
import semantic_change.declaration_supported
import std.loom.ast.NodeKind
import std.loom.manifest.segment
import std.loom.parser.parse
import std.bytes.new
import std.file.read_text
import std.file.write_text
import std.fs.create_dir
import std.fs.entry_kind
import std.fs.FileKind
import std.fs.remove_empty_dir
import std.fs.rename
import std.hash.sha256.hex
import std.int.to_text
import std.list.get
import std.list.length
import std.list.new
import std.list.push
import std.list.set
import std.result.Result
import std.text.concat
import std.text.contains
import std.text.ends_with

record Resolution {
    owner Text
    id Text
    path Text
    name Text
    key Text
    deletion Bool
}

fn lifecycle_word(value Text) Bool {
    value != "" && !contains(value, " ") && !contains(value, "\t") &&
    !contains(value, "\n") && !contains(value, "\r") && !contains(value, "\0")
}

fn lifecycle_leaf(value Text) Bool {
    lifecycle_word(value) && ends_with(value, ".loom") &&
    !contains(value, "/") && !contains(value, "\\")
}

fn declarations(files List[File]) Result[List[Identity], Text] {
    let found = new[Identity]()
    var file_index = 0
    while file_index < length(files) {
        let file = get(files, file_index)
        if !lifecycle_leaf(file.path) {
            return Result.Err("source path is not a safe root-level .loom filename")
        }
        let tree = match std.loom.parser.parse(file.text) {
            Result.Ok(tree) => tree,
            Result.Err(problem) => {
                return Result.Err(concat(concat("cannot parse ", file.path), concat(": ", problem.message)))
            }
        }
        var index = 0
        while index < length(tree.children) {
            let node = get(tree.children, index)
            if node.kind == NodeKind.Import {
                index = index + 1
                continue
            }
            let label = declaration_label(node)
            if !declaration_supported(node.kind) || !lifecycle_word(label) {
                return Result.Err(concat("unsupported or unnamed top-level declaration in ", file.path))
            }
            let key = declaration_key(node)?
            var previous = 0
            while previous < length(found) {
                let prior = get(found, previous)
                let keyed = prior.kind == node.kind && (node.kind == NodeKind.Function || node.kind == NodeKind.Impl)
                if prior.name == label && (!keyed || prior.key == key) {
                    return Result.Err(concat("duplicate or indistinguishable declaration: ", label))
                }
                previous = previous + 1
            }
            push(found, Identity {
                    owner = ""
                    id = ""
                    path = file.path
                    kind = node.kind
                    name = label
                    key = key
                })
            index = index + 1
        }
        file_index = file_index + 1
    }
    Result.Ok(found)
}

fn same_declaration(left Identity, right Identity) Bool {
    left.owner == right.owner && left.path == right.path && left.kind == right.kind && left.name == right.name && left.key == right.key
}

fn identity_at(identities List[Identity], id Text) Int {
    var index = 0
    while index < length(identities) {
        if get(identities, index).id == id {
            return index
        }
        index = index + 1
    }
    -1
}

fn candidate_at(candidates List[Identity], path Text, kind NodeKind, name Text, key Text) Int {
    candidate_at(candidates, "", path, kind, name, key)
}

fn candidate_at(candidates List[Identity], owner Text, path Text, kind NodeKind, name Text, key Text) Int {
    var index = 0
    while index < length(candidates) {
        let value = get(candidates, index)
        if value.owner == owner && value.path == path && value.kind == kind && value.name == name && value.key == key {
            return index
        }
        index = index + 1
    }
    -1
}

fn fresh_id(package_name Text, candidate Identity, sequence Int) Text {
    let bytes = std.bytes.new()
    frame(bytes, if candidate.owner == "" {
            "loom-stable-id-v1"
        } else {
            "loom-member-id-v1"
        })
    if candidate.owner != "" {
        frame(bytes, candidate.owner)
    }
    frame(bytes, package_name)
    frame(bytes, candidate.path)
    frame(bytes, kind_name(candidate.kind))
    frame(bytes, candidate.name)
    frame(bytes, candidate.key)
    frame(bytes, to_text(sequence))
    concat("d-", hex(bytes))
}

fn files_stamp(files List[File]) Text {
    let bytes = std.bytes.new()
    frame_files(bytes, files)
    hex(bytes)
}

// A private stage is created exclusively. The final rename publishes one
// complete sidecar; refresh retains the old bytes in stage/previous. Native
// rename may replace a racing target, so this is for trusted local workspaces.
fn publish_sidecar(directory Text, previous Text, updated Text, files List[File], existing Bool) Result[Text, Text] {
    let bytes = std.bytes.new()
    frame(bytes, "loom-sidecar-stage-v1")
    frame(bytes, previous)
    frame(bytes, updated)
    frame(bytes, files_stamp(files))
    let stage = path(directory, concat(".loom-ids-stage-", hex(bytes)))
    match create_dir(stage) {
        Result.Ok(_) => {
        }
        _ => {
            return Result.Err(concat("cannot create exclusive identity stage; inspect prior recovery state: ", stage))
        }
    }
    let staged = path(stage, "new")
    match std.file.write_text(staged, updated) {
        Result.Ok(_) => {
        }
        _ => {
            return Result.Err(concat("cannot write staged identities: ", stage))
        }
    }
    if existing {
        match std.file.write_text(path(stage, "previous"), previous) {
            Result.Ok(_) => {
            }
            _ => {
                return Result.Err(concat("cannot back up previous identities: ", stage))
            }
        }
    }
    if files_stamp(read_files(directory)?) != files_stamp(files) {
        return Result.Err(concat("source changed before identity publication; staged bytes remain at ", stage))
    }
    let target = path(directory, ".loom-ids")
    if existing {
        match entry_kind(target) {
            Result.Ok(FileKind.File) => {
            }
            _ => {
                return Result.Err(concat("identity sidecar changed before publication; staged bytes remain at ", stage))
            }
        }
        let current = match read_text(target) {
            Result.Ok(value) => value,
            Result.Err(_) => {
                return Result.Err(concat("cannot re-read identity sidecar; staged bytes remain at ", stage))
            }
        }
        if current != previous {
            return Result.Err(concat("identity sidecar changed before publication; staged bytes remain at ", stage))
        }
    } else {
        discard vacant(target)?
    }
    match rename(staged, target) {
        Result.Ok(_) => {
        }
        _ => {
            return Result.Err(concat("could not publish identities; staged bytes remain at ", stage))
        }
    }
    if !existing {
        discard remove_empty_dir(stage)
        return Result.Ok("identities initialized\n")
    }
    Result.Ok(concat("identities refreshed; previous sidecar retained at ", concat(path(stage, "previous"), "\n")))
}

fn initialize(package_name Text, directory Text) Result[Text, Text] {
    let parts = split(package_name, ".")
    var part = 0
    while part < length(parts) {
        if !segment(get(parts, part)) || (part == 0 && get(parts, part) == "std") {
            return Result.Err("init needs a dotted lowercase package name outside std")
        }
        part = part + 1
    }
    let target = path(directory, ".loom-ids")
    discard vacant(target)?
    let files = read_files(directory)?
    let candidates = declarations(files)?
    let identities = new[Identity]()
    var changes = ""
    var next = 1
    var index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        let id = fresh_id(package_name, candidate, next)
        push(identities, Identity {
                owner = ""
                id = id
                path = candidate.path
                kind = candidate.kind
                name = candidate.name
                key = candidate.key
            })
        changes = concat(changes, concat("added ", concat(id,
                    concat(" ", concat(candidate.path, concat(" ", concat(candidate.name, "\n")))))))
        next = next + 1
        index = index + 1
    }
    let root_sidecar = sidecar(Revision {
            package_name = package_name
            files = files
            identities = identities
        }, next)
    let updated = complete_member_sidecar("", root_sidecar, files, new[Resolution](), new[Derivation](), false)?
    Result.Ok(concat(publish_sidecar(directory, "", updated, files, false)?, changes))
}

fn resolutions(args List[Text], start Int) Result[(List[Resolution], Bool, List[Derivation]), Text] {
    let output = new[Resolution]()
    let derivations = new[Derivation]()
    var draft = false
    var index = start
    while index < length(args) {
        let option = get(args, index)
        if option == "--draft" {
            draft = true
            index = index + 1
            continue
        }
        let member = option == "--derive-member" || option == "--move-member"
        let shift = if member {
            1
        } else {
            0
        }
        if option == "--derive" || option == "--derive-member" {
            if index + 4 + shift >= length(args) {
                return Result.Err("derivation needs PARENT_ID [OWNER_ID for --derive-member] NEW_FILE NEW_NAME KEY")
            }
            let owner = if member {
                get(args, index + 2)
            } else {
                ""
            }
            if member && !lifecycle_word(owner) {
                return Result.Err("member derivation requires an explicit owner ID")
            }
            push(derivations, Derivation {
                    owner = owner
                    parent = get(args, index + 1)
                    path = get(args, index + 2 + shift)
                    name = get(args, index + 3 + shift)
                    key = get(args, index + 4 + shift)
                })
            index = index + 5 + shift
            continue
        }
        let deletion = option == "--delete"
        if (!deletion && option != "--move" && option != "--move-member") || index + if deletion {
            1
        } else {
            4 + shift
        } >= length(args) {
            return Result.Err("refresh options are --draft, --move ID FILE NAME KEY, --move-member ID OWNER FILE NAME KEY, --derive PARENT FILE NAME KEY, --derive-member PARENT OWNER FILE NAME KEY or --delete ID; scan DIR lists keys")
        }
        let id = get(args, index + 1)
        var previous = 0
        while previous < length(output) {
            if get(output, previous).id == id {
                return Result.Err("identity has more than one explicit resolution")
            }
            previous = previous + 1
        }
        let owner = if member {
            get(args, index + 2)
        } else {
            ""
        }
        if member && !lifecycle_word(owner) {
            return Result.Err("member move requires an explicit owner ID")
        }
        push(output, Resolution {
                owner = owner
                id = id
                path = if deletion {
                    ""
                } else {
                    get(args, index + 2 + shift)
                }
                name = if deletion {
                    ""
                } else {
                    get(args, index + 3 + shift)
                }
                key = if deletion {
                    ""
                } else {
                    get(args, index + 4 + shift)
                }
                deletion = deletion
            })
        index = index + if deletion {
            2
        } else {
            5 + shift
        }
    }
    Result.Ok((output, draft, derivations))
}

fn refresh(directory Text, options List[Resolution], save_draft Bool) Result[Text, Text] {
    refresh(directory, options, save_draft, new[Derivation]())
}

fn refresh(directory Text, supplied List[Resolution], save_draft Bool,
    supplied_derivations List[Derivation]) Result[Text, Text] {
    let state = read_state(directory)?
    let loaded = state.0
    if state.1.draft != "" && state.1.draft != files_stamp(loaded.revision.files) && !save_draft {
        return Result.Err("identity draft is stale; run refresh --draft before resolution")
    }
    let previous = root_identities(loaded.revision.identities)
    let candidates = declarations(loaded.revision.files)?
    let options = root_resolutions(loaded.revision.identities, supplied)
    let derivations = root_derivations(supplied_derivations)
    let selected = new[Text]()
    let old_used = new[Bool]()
    var index = 0
    while index < length(previous) {
        push(old_used, false)
        let prior = get(previous, index)
        if !lifecycle_word(prior.id) || !lifecycle_leaf(prior.path) || !lifecycle_word(prior.name) ||
        !lifecycle_word(prior.key) {
            return Result.Err("existing sidecar has an invalid declaration identity")
        }
        var earlier = 0
        while earlier < index {
            if prior.id == get(previous, earlier).id ||
            same_declaration(prior, get(previous, earlier)) {
                return Result.Err("existing sidecar has ambiguous or duplicate identities")
            }
            earlier = earlier + 1
        }
        index = index + 1
    }
    index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        var matched = -1
        var prior_index = 0
        while prior_index < length(previous) {
            let prior = get(previous, prior_index)
            var explicitly_deleted = false
            var option_index = 0
            while option_index < length(options) {
                let option = get(options, option_index)
                if option.id == prior.id && option.deletion {
                    explicitly_deleted = true
                }
                option_index = option_index + 1
            }
            if !explicitly_deleted && !pending_identity(state.1.pending, prior.id) && same_declaration(prior, candidate) {
                matched = prior_index
            }
            prior_index = prior_index + 1
        }
        push(selected, if matched >= 0 {
                get(previous, matched).id
            } else {
                ""
            })
        if matched >= 0 {
            set(old_used, matched, true)
        }
        index = index + 1
    }
    var changes = ""
    index = 0
    while index < length(options) {
        let option = get(options, index)
        if option.owner != "" {
            return Result.Err("--move-member requires an existing method identity")
        }
        let prior_index = identity_at(previous, option.id)
        if prior_index < 0 || get(old_used, prior_index) {
            return Result.Err("explicit resolution needs an unmatched existing identity")
        }
        if !option.deletion {
            let old_identity = get(previous, prior_index)
            let candidate = candidate_at(candidates, option.path, old_identity.kind, option.name, option.key)
            if candidate < 0 || get(selected, candidate) != "" {
                return Result.Err("--move target must be one unmatched declaration of the same kind")
            }
            set(selected, candidate, option.id)
            changes = concat(changes, concat("moved ", concat(option.id,
                        concat(" to ", concat(option.path, concat(" ", concat(option.name, "\n")))))))
        } else {
            changes = concat(changes, concat("deleted ", concat(option.id, "\n")))
        }
        set(old_used, prior_index, true)
        index = index + 1
    }
    let history = std.list.clone(state.1.lineage)
    let derived_targets = derivation_candidates(loaded.revision.identities, history, candidates, selected, derivations)?
    var remaining_old = 0
    var unresolved = false
    index = 0
    while index < length(previous) {
        if !get(old_used, index) {
            remaining_old = remaining_old + 1
            unresolved = unresolved || pending_identity(state.1.pending, get(previous, index).id)
        }
        index = index + 1
    }
    var remaining_new = 0
    index = 0
    while index < length(selected) {
        if get(selected, index) == "" {
            remaining_new = remaining_new + 1
        }
        index = index + 1
    }
    if remaining_old > 0 && save_draft {
        if length(derivations) != 0 {
            return Result.Err("resolve pending identities before recording derivation choices")
        }
        let root_sidecar = draft_sidecar(loaded, previous, candidates, selected, old_used, history)
        let updated = complete_member_sidecar(loaded.sidecar, root_sidecar, loaded.revision.files, supplied, supplied_derivations, save_draft)?
        let notice = concat("identity draft retained; unresolved declarations: ", concat(to_text(remaining_old), "\n"))
        if updated == loaded.sidecar {
            return Result.Ok(notice)
        }
        return Result.Ok(concat(publish_sidecar(directory, loaded.sidecar, updated, loaded.revision.files, true)?,
                concat(changes, notice)))
    }
    if (remaining_old > 0 && remaining_new > 0) || unresolved {
        return Result.Err("possible move, rename or signature edit: use --move ID NEW_FILE NEW_NAME KEY, or --delete ID before assigning new identities; scan DIR lists keys")
    }
    index = 0
    while index < length(previous) {
        if !get(old_used, index) {
            changes = concat(changes, concat("deleted ", concat(get(previous, index).id, "\n")))
        }
        index = index + 1
    }
    let identities = new[Identity]()
    var next = loaded.next
    index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        var id = get(selected, index)
        if id == "" {
            var allocated = false
            while !allocated {
                if next >= 9223372036854775806 {
                    return Result.Err("identity allocator exhausted")
                }
                id = fresh_id(loaded.revision.package_name, candidate, next)
                next = next + 1
                allocated = !lineage_known(previous, history, id) && identity_at(identities, id) < 0
            }
            changes = concat(changes, concat("added ", concat(id, concat(" ",
                            concat(candidate.path, concat(" ", concat(candidate.name, "\n")))))))
        }
        push(identities, Identity {
                owner = ""
                id = id
                path = candidate.path
                kind = candidate.kind
                name = candidate.name
                key = candidate.key
            })
        let parents = new[Text]()
        var derivation = 0
        while derivation < length(derivations) {
            if get(derived_targets, derivation) == index {
                push(parents, get(derivations, derivation).parent)
            }
            derivation = derivation + 1
        }
        if length(parents) != 0 {
            push(history, Lineage {
                    id = id
                    parents = parents
                })
            changes = concat(changes, concat("derived ", concat(id, concat(" from ", concat(join(parents, " "), "\n")))))
        }
        index = index + 1
    }
    let revised = Revision {
        package_name = loaded.revision.package_name
        files = loaded.revision.files
        identities = identities
    }
    let root_sidecar = sidecar(revised, next, normalized_lineage(history)?)
    let updated = complete_member_sidecar(loaded.sidecar, root_sidecar, loaded.revision.files, supplied, supplied_derivations, save_draft)?
    if updated == loaded.sidecar {
        return Result.Ok("identities unchanged\n")
    }
    let published = publish_sidecar(directory, loaded.sidecar, updated, loaded.revision.files, true)?
    Result.Ok(concat(published, concat(changes, if header(updated, "updated identities")?.draft == "" {
                    ""
                } else {
                    "identity draft retained; explicit member resolution required\n"
                })))
}

fn refresh_command(args List[Text]) Result[Text, Text] {
    let options = resolutions(args, 3)?
    refresh(get(args, 2), options.0, options.1, options.2)
}

fn scan(directory Text) Result[Text, Text] {
    let files = read_files(directory)?
    let candidates = declarations(files)?
    match entry_kind(path(directory, ".loom-ids")) {
        Result.Ok(FileKind.File) => {
            let state = read_state(directory)?
            let owners = new[Identity]()
            var index = 0
            while index < length(state.0.revision.identities) {
                let identity = get(state.0.revision.identities, index)
                if identity.owner == "" && !pending_identity(state.1.pending, identity.id) {
                    push(owners, identity)
                }
                index = index + 1
            }
            let members = member_declarations(files, owners)?
            index = 0
            while index < length(members) {
                push(candidates, get(members, index))
                index = index + 1
            }
        }
        Result.Err(FsError.NotFound) => {
        }
        _ => {
            return Result.Err("scan identities must be absent or a regular sidecar")
        }
    }
    var output = ""
    var index = 0
    while index < length(candidates) {
        let candidate = get(candidates, index)
        let locator = identity_locator(candidate)
        output = concat(output, concat(slice(locator, 0, length(locator) - 1), concat(if candidate.owner == "" {
                        ""
                    } else {
                        concat(" owner=", candidate.owner)
                    }, "\n")))
        index = index + 1
    }
    Result.Ok(output)
}
