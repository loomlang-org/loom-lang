import std.list.get
import std.list.set
import std.result.Result
import std.storage.Value
import std.storage.ValueKind
import std.storage.Column
import std.storage.Table
import std.storage.ColumnValue
import std.storage.CodecError
import std.storage.record_codec
import std.storage.encode_prepared_row
import std.storage.decode_prepared_row
import std.storage.encode_refined_column
import std.storage.decode_refined_column
import std.storage.sqlite_record_check
import std.storage.SqliteCheckError

pub type Amount = Int where self >= 0

impl ColumnValue for Amount {
    fn column_kind() ValueKind {
        ValueKind.Int
    }

    fn to_column(self Amount) Result[Value, CodecError] {
        encode_refined_column[Amount, Int](self)
    }

    fn from_column(value Value) Result[Amount, CodecError] {
        decode_refined_column[Amount, Int](value)
    }
}

pub record Note {
    id Int
    body Text
    amount Amount
}

record PrivateNote {
    body Text
}

type ValidNote = Note where self.id > 0

pub type IndexedNote = Note where self.id > 0 && self.id <= self.amount

pub type SqliteIdGuard = Note where self.id > 0

pub type SqliteAmountGuard = Note where self.amount > 0

pub type HiddenNote = PrivateNote where self.body != ""

type PrivateAmount = Int where self > 0

fn indexed_amount(value IndexedNote) Int
ensures result >= value.id {
    value.amount
}

fn round_trip() Result[Bool, CodecError] {
    assert match decode_refined_column[PrivateAmount, Int](Value.Int(1)) {
        Result.Err(CodecError.Rejected) => true
        _ => false
    }
    let table = Table {
        id = "notes"
        physical_name = "current_notes"
        columns = [
            Column {
                id = "body"
                physical_name = "note_body"
                kind = ValueKind.Text
                nullable = false
            },
            Column {
                id = "amount"
                physical_name = "total_cents"
                kind = ValueKind.Int
                nullable = false
            },
            Column {
                id = "note-id"
                physical_name = "id"
                kind = ValueKind.Int
                nullable = false
            }
        ]
    }
    assert match record_codec[PrivateNote](table) {
        Result.Err(CodecError.InvalidSchema) => true
        _ => false
    }
    assert match record_codec[ValidNote](table) {
        Result.Err(CodecError.InvalidSchema) => true
        _ => false
    }
    assert match record_codec[HiddenNote](table) {
        Result.Err(CodecError.InvalidSchema) => true
        _ => false
    }
    assert match sqlite_record_check[HiddenNote](table) {
        Result.Err(SqliteCheckError.UnsupportedType) => true
        _ => false
    }
    let codec = record_codec[Note](table, [("id", "note-id")])?
    assert match sqlite_record_check[SqliteIdGuard](table, [("id", "note-id")]) {
        Result.Ok(_) => true
        _ => false
    }
    // The custom Amount codec is valid, but its representation is not inferred
    // from an integer physical kind when translating a predicate on that field.
    discard record_codec[SqliteAmountGuard](table, [("id", "note-id")])?
    assert match sqlite_record_check[SqliteAmountGuard](table, [("id", "note-id")]) {
        Result.Err(SqliteCheckError.UnsupportedPredicate) => true
        _ => false
    }
    let row = encode_prepared_row(codec, Note {
            id = 7
            body = "hello"
            amount = Amount(1250)
        })?
    let decoded = decode_prepared_row(codec, row)?
    assert decoded.id == 7 && decoded.body == "hello" && decoded.amount == 1250
    assert match get(row, 2) {
        Value.Int(7) => true
        _ => false
    }
    set(row, 1, Value.Int(-1))
    assert match decode_prepared_row(codec, row) {
        Result.Err(CodecError.Rejected) => true
        _ => false
    }
    set(row, 1, Value.Int(1250))
    let refined = record_codec[IndexedNote](table, [("id", "note-id")])?
    let indexed = decode_prepared_row(refined, row)?
    assert indexed.id == 7 && indexed_amount(indexed) == 1250
    let encoded = encode_prepared_row(refined, indexed)?
    assert match get(encoded, 2) {
        Value.Int(7) => true
        _ => false
    }
    // All cells still satisfy their field types; the record relationship fails.
    set(row, 2, Value.Int(1251))
    assert match decode_prepared_row(refined, row) {
        Result.Err(CodecError.Rejected) => true
        _ => false
    }
    set(row, 2, Value.Int(0))
    assert match decode_prepared_row(refined, row) {
        Result.Err(CodecError.Rejected) => true
        _ => false
    }
    Result.Ok(true)
}

fn main() {
    assert match round_trip() {
        Result.Ok(ok) => ok
        Result.Err(_) => false
    }
}

test fn imported_record_codec_preserves_constraints() {
    main()
}
