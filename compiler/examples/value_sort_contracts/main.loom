import std.list.length
import std.list.sorted
import std.list.push

record Key {
    id Int
}

record Row {
    key Key
    amount Int
    active Bool
    label Text
}

fn same_row(first Row, second Row) Bool {
    first.key.id == second.key.id && first.amount == second.amount &&
    first.active == second.active && first.label == second.label
}

fn count(values List[Row], needle Row) Int {
    var index = 0
    var found = 0
    while index < length(values) {
        if same_row(values[index], needle) {
            found = found + 1
        }
        index = index + 1
    }
    found
}

fn same_counts(first List[Row], second List[Row]) Bool {
    var index = 0
    while index < length(first) {
        if count(first, first[index]) != count(second, first[index]) {
            return false
        }
        index = index + 1
    }
    true
}

fn permutation(first List[Row], second List[Row]) Bool {
    length(first) == length(second) && same_counts(first, second)
}

fn ascending(values List[Row]) Bool {
    var index = 1
    while index < length(values) {
        if values[index - 1].key.id > values[index].key.id {
            return false
        }
        index = index + 1
    }
    true
}

fn descending(values List[Row]) Bool {
    var index = 1
    while index < length(values) {
        if values[index - 1].key.id < values[index].key.id {
            return false
        }
        index = index + 1
    }
    true
}

pub fn sorted_rows(values List[Row], less fn(Row, Row) Bool) List[Row]
ensures permutation(old(values), result) {
    sorted(values, less)
}

pub fn sorted_ascending(values List[Row]) List[Row]
ensures ascending(result)
ensures permutation(old(values), result) {
    sorted(values, fn(a Row, b Row) Bool {
            if length(values) > 0 {
                values[0] = Row {
                    amount = 99,
                    ..a
                }
            }
            push(values, a)
            a.key.id < b.key.id
        })
}

pub fn sorted_descending(values List[Row]) List[Row]
ensures descending(result)
ensures permutation(old(values), result) {
    sorted(values, fn(a Row, b Row) Bool {
            if length(values) > 0 {
                values[0] = Row {
                    amount = 99,
                    ..a
                }
            }
            push(values, a)
            a.key.id > b.key.id
        })
}

fn exercise() {
    let first = Row {
        key = Key {
            id = 1
        },
        amount = 10,
        active = true,
        label = "first"
    }
    let second = Row {
        key = Key {
            id = 3
        },
        amount = 20,
        active = false,
        label = "second"
    }
    let original = [second, first, first]
    let arranged = sorted_rows(original, fn(a Row, b Row) Bool {
            original[0] = Row {
                amount = 99,
                ..first
            }
            push(original, second)
            a.key.id < b.key.id
        })
    assert length(arranged) == 3
    assert count(arranged, first) == 2 && count(arranged, second) == 1
    assert same_row(arranged[0], first) && same_row(arranged[2], second)
    assert length(original) > 3
}

fn exercise_ordered() {
    let first = Row {
        key = Key {
            id = 1
        },
        amount = 10,
        active = true,
        label = "first"
    }
    let second = Row {
        key = Key {
            id = 3
        },
        amount = 20,
        active = false,
        label = "second"
    }
    let ascending_input = [second, first, first]
    let increasing = sorted_ascending(ascending_input)
    assert length(increasing) == 3
    assert count(increasing, first) == 2 && count(increasing, second) == 1
    assert same_row(increasing[0], first) && same_row(increasing[2], second)
    assert length(ascending_input) > 3
    let descending_input = [first, second, first]
    let decreasing = sorted_descending(descending_input)
    assert length(decreasing) == 3
    assert count(decreasing, first) == 2 && count(decreasing, second) == 1
    assert same_row(decreasing[0], second) && same_row(decreasing[2], first)
    assert length(descending_input) > 3
}

fn main() {
    exercise()
    exercise_ordered()
}

test fn sorting_preserves_complete_immutable_rows() {
    exercise()
}

test fn sorting_orders_nested_keys_and_preserves_complete_rows() {
    exercise_ordered()
}
