import std.list.length
import std.list.sorted
import std.list.push

record Key {
    id Int
}

record Row {
    key Key
    amount Int
    active Bool
    label Text
}

fn same_row(first Row, second Row) Bool {
    first.key.id == second.key.id && first.amount == second.amount &&
    first.active == second.active && first.label == second.label
}

fn count(values List[Row], needle Row) Int {
    var index = 0
    var found = 0
    while index < length(values) {
        if same_row(values[index], needle) {
            found = found + 1
        }
        index = index + 1
    }
    found
}

fn same_counts(first List[Row], second List[Row]) Bool {
    var index = 0
    while index < length(first) {
        if count(first, first[index]) != count(second, first[index]) {
            return false
        }
        index = index + 1
    }
    true
}

fn permutation(first List[Row], second List[Row]) Bool {
    length(first) == length(second) && same_counts(first, second)
}

pub fn sorted_rows(values List[Row], less fn(Row, Row) Bool) List[Row]
ensures permutation(old(values), result) {
    sorted(values, less)
}

fn exercise() {
    let first = Row {
        key = Key {
            id = 1
        },
        amount = 10,
        active = true,
        label = "first"
    }
    let second = Row {
        key = Key {
            id = 3
        },
        amount = 20,
        active = false,
        label = "second"
    }
    let original = [second, first, first]
    let arranged = sorted_rows(original, fn(a Row, b Row) Bool {
            original[0] = Row {
                amount = 99,
                ..first
            }
            push(original, second)
            a.key.id < b.key.id
        })
    assert length(arranged) == 3
    assert count(arranged, first) == 2 && count(arranged, second) == 1
    assert same_row(arranged[0], first) && same_row(arranged[2], second)
    assert length(original) > 3
}

fn main() {
    exercise()
}

test fn sorting_preserves_complete_immutable_rows() {
    exercise()
}
