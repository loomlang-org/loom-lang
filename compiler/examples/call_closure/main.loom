import std.loom.project.load
import std.loom.analysis.Analysis
import std.loom.analysis.snapshot
import std.loom.analysis.analyze
import std.loom.analysis.call_closure
import std.process.arguments
import std.list.new
import std.list.get
import std.list.push
import std.list.length
import std.option.Option
import std.result.Result
import std.text.concat
import std.int.to_text
import std.io.write_text
import std.io.write_error

fn named(analysis Analysis, name Text) Int {
    let view = snapshot(analysis)
    var found = -1
    var index = 0
    while index < length(view.functions) {
        let symbol = get(view.functions, index)
        if symbol >= 0 {
            let declaration = get(view.bindings.symbols, symbol)
            if declaration.name == name &&
            get(view.bindings.files, declaration.file).package == view.source.root {
                assert found < 0
                found = index
            }
        }
        index = index + 1
    }
    assert found >= 0
    found
}

fn inspect(package Text, standard Text, cut Text) {
    match load(package, standard, false) {
        Result.Ok(project) => match analyze(project, false) {
            Result.Ok(analysis) => {
                let boundaries = new[Int]()
                if cut != "" {
                    push(boundaries, named(analysis, cut))
                }
                match call_closure(analysis, named(analysis, "main"), boundaries) {
                    Option.Some(report) => {
                        discard write_text(concat("calls ", concat(to_text(length(report.calls)), "\n")))
                        discard write_text(concat("operations ", concat(to_text(length(report.operations)), "\n")))
                        discard write_text(concat("issues ", concat(to_text(length(report.issues)), "\n")))
                    }
                    _ => {
                        assert false
                    }
                }
            }
            Result.Err(problem) => {
                discard write_error(problem.diagnostic.message)
                assert false
            }
        }
        Result.Err(problem) => {
            discard write_error(problem)
            assert false
        }
    }
}

fn main() {
    let args = arguments()
    assert length(args) == 4
    inspect(get(args, 1), get(args, 2), get(args, 3))
}
