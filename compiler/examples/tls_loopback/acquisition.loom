import std.net.tcp.connect
import std.net.tcp.close_stream
import std.net.tcp.read
import std.task.cancel
import std.task.deadline.after_ns
import std.task.Outcome

async fn cancelled_accept(listener ListenerHandle, options ServerOptions, address Text, before_connect Bool) {
    let connected = if before_connect {
        let pending = accept(listener, options)
        assert match cancel(pending) {
            Outcome.Cancelled => true
            _ => false
        }
        std.net.tcp.connect(address).await
    } else {
        let pending = accept(listener, options)
        let connected = std.net.tcp.connect(address).await
        assert match cancel(pending) {
            Outcome.Cancelled => true
            _ => false
        }
        connected
    }
    let peer = match connected {
        Result.Ok(value) => value
        _ => {
            assert false
            return
        }
    }
    defer {
        discard close_stream(peer)
    }
    // A completed connect need not have been accepted. Close the listener to
    // clear its backlog; this does not close an already accepted peer socket.
    assert match close_listener(listener) {
        Result.Ok(_) => true
        _ => false
    }
    // No ClientHello is sent. The accepting task must close any socket acquired
    // by its child, even when the handshake has not claimed that result yet.
    assert match after_ns(std.net.tcp.read(peer, new(), 1), 1000000000).await {
        Outcome.Completed(Result.Ok(count)) => count == 0
        Outcome.Completed(Result.Err(_)) => true
        _ => false
    }
}
