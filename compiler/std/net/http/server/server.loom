import std.result.Result
import std.option.Option
import std.stream.Stream
import std.net.http.Header
import std.net.http.Request
import std.net.http.Response
import std.net.http.Limits
import std.net.http.ReadError
import std.net.http.ProtocolError
import std.net.http.header_named
import std.net.http.reader
import std.net.http.open_request
import std.net.http.collect
import std.net.http.close_reader
import std.net.http.encode_response
import std.net.http.url.parse
import std.text.to_bytes
import std.text.concat
import std.text.length
import std.text.byte
import std.text.contains
import std.bytes.decode_utf8
import std.bytes.length
import std.bytes.new
import std.bytes.get
import std.bytes.push
import std.bytes.to_text
import std.bytes.clone
import std.list.new
import std.list.length
import std.list.push

pub record Options {
    secure Bool
    authorities List[Text]
    max_requests Int
    limits Limits
}

pub enum Rejection {
    Authority
    Target
    Unsupported
}

pub enum Error[E, F, H] {
    Options
    Rejected(Rejection)
    Input(ReadError[E])
    Output(F)
    Handler(H)
    Protocol(ProtocolError)
    Count
}

// Snapshot and validate policy before the Task can pull or invoke user code.
// The caller owns the transport and closes it after this Task drains.
pub fn serve[S Stream, E, F, H](source S, bytes fn(S.Item) Result[Bytes, E],
    sink fn(Bytes) Task[Result[Int, F]], handler fn(Request) Task[Result[Response, H]],
    configuration Options) Task[Result[Int, Error[E, F, H]]] {
    match prepare(configuration) {
        Option.Some(ready) => exchange(source, bytes, sink, handler, ready)
        Option.None => invalid[E, F, H]()
    }
}

async fn invalid[E, F, H]() Result[Int, Error[E, F, H]] {
    Result.Err(Error.Options)
}

async fn exchange[S Stream, E, F, H](source S, bytes fn(S.Item) Result[Bytes, E],
    sink fn(Bytes) Task[Result[Int, F]], handler fn(Request) Task[Result[Response, H]],
    configuration Options) Result[Int, Error[E, F, H]] {
    let input = reader(source, bytes, configuration.limits)
    defer {
        discard close_reader(input)
    }
    var count = 0
    while count < configuration.max_requests {
        scoped incoming = open_request(input, 16384).await
        match incoming {
            Result.Err(error) => {
                return Result.Err(Error.Input(error))
            }
            Result.Ok(Option.None) => {
                return Result.Ok(count)
            }
            Result.Ok(Option.Some(value)) => {
                let destination = match checked_target(value.method, value.target, value.headers, configuration) {
                    Result.Ok(target) => target
                    Result.Err(error) => {
                        return Result.Err(Error.Rejected(error))
                    }
                }
                let requested_close = match closes(value.headers) {
                    Result.Ok(value) => value
                    Result.Err(error) => {
                        return Result.Err(Error.Protocol(error))
                    }
                }
                let expecting = match continue_request(value.headers) {
                    Result.Ok(value) => value
                    Result.Err(error) => {
                        return Result.Err(Error.Rejected(error))
                    }
                }
                if expecting {
                    discard sent[E, F, H](Response {
                            status = 100
                            reason = to_bytes("Continue")
                            headers = []
                            body = std.bytes.new()
                            trailers = []
                        }, value.method, sink, configuration.limits).await?
                }
                let request = match collect(value).await {
                    Result.Ok(message) => Request {
                        target = destination.target
                        headers = routed_headers(message.headers, destination.authority)
                        ..message
                    }
                    Result.Err(error) => {
                        return Result.Err(Error.Input(error))
                    }
                }
                let response = match handler(request).await {
                    Result.Ok(message) => message
                    Result.Err(error) => {
                        return Result.Err(Error.Handler(error))
                    }
                }
                let headers = response_headers(response.headers)
                if response.status < 200 || has_header(headers, "Upgrade") {
                    return Result.Err(Error.Rejected(Rejection.Unsupported))
                }
                let response_close = match closes(headers) {
                    Result.Ok(value) => value
                    Result.Err(error) => {
                        return Result.Err(Error.Protocol(error))
                    }
                }
                let last = requested_close || response_close || count == configuration.max_requests - 1
                if last && !response_close {
                    push(headers, Header {
                            name = "Connection"
                            value = to_bytes("close")
                        })
                }
                discard sent[E, F, H](Response {
                        headers = headers
                        ..response
                    }, value.method, sink, configuration.limits).await?
                count = count + 1
                if last {
                    return Result.Ok(count)
                }
            }
        }
    }
    Result.Ok(count)
}

async fn sent[E, F, H](response Response, method Text, sink fn(Bytes) Task[Result[Int, F]],
    maximum Limits) Result[Bool, Error[E, F, H]] {
    let wire = match encode_response(response, method, maximum) {
        Result.Ok(value) => value
        Result.Err(error) => {
            return Result.Err(Error.Protocol(error))
        }
    }
    match sink(wire).await {
        Result.Ok(written) => {
            if written != std.bytes.length(wire) {
                return Result.Err(Error.Count)
            }
        }
        Result.Err(error) => {
            return Result.Err(Error.Output(error))
        }
    }
    Result.Ok(true)
}
