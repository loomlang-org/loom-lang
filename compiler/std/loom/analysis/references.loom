import std.loom.checking.source_declaration_query
import std.map.get
import std.map.insert

// Private lexical data belongs to this published analysis. No query exports
// these mutable token Lists. Exact source text guards reuse across lazy views.
record LexicalSource {
    text Text
    answer Result[List[Token], Text]
}

// One answer per requested source position. Missing, type-only and ambiguous
// inspections are retained, not interpreted as proof that a reference is absent.
pub record ReferenceEvidence {
    offset Int
    inspection Option[Inspection]
}

fn reference_tokens(analysis AnalysisState, file Int) Result[List[Token], Text] {
    lexical_tokens(analysis.bindings, analysis.lexical_sources, file)
}

fn lexical_tokens(bindings std.loom.binding.Program, sources std.map.Map[Int, LexicalSource], file Int) Result[List[Token], Text] {
    if file < 0 || file >= length(bindings.files) {
        return Result.Err("reference query has no source file")
    }
    let text = get(bindings.files, file).text
    match std.map.get(sources, file) {
        Option.Some(cached) => {
            if cached.text == text {
                return cached.answer
            }
        }
        Option.None => {
        }
    }
    let answer Result[List[Token], Text] = match lex(text) {
        Result.Ok(tokens) => Result.Ok(tokens)
        Result.Err(problem) => Result.Err(problem.message)
    }
    discard std.map.insert(sources, file, LexicalSource {
            text = text
            answer = answer
        })
    answer
}

fn reference_evidence(analysis AnalysisState, file Int, offsets List[Int], tokens Option[List[Token]]) List[ReferenceEvidence] {
    let references = new[ReferenceEvidence]()
    var index = 0
    while index < length(offsets) {
        let offset = get(offsets, index)
        push(references, ReferenceEvidence {
                offset = offset
                inspection = match tokens {
                    Option.Some(source) => checked_inspection(analysis, file, offset, source)
                    Option.None => Option.None
                }
            })
        index = index + 1
    }
    references
}

// A batch reuses one source token stream. Invalid sources still retain an
// unanswered entry for every requested position rather than dropping a site.
fn inspect_references(analysis AnalysisState, file Int, offsets List[Int]) List[ReferenceEvidence] {
    match reference_tokens(analysis, file) {
        Result.Ok(tokens) => reference_evidence(analysis, file, offsets, Option.Some(tokens))
        Result.Err(_) => reference_evidence(analysis, file, offsets, Option.None)
    }
}

// Scan exact source name tokens, excluding comments and text literals. This is
// candidate evidence, not complete semantic coverage of generated/static code.
// Consumers still need their own authority and unaccounted-use checks.
fn inspect_references(analysis AnalysisState, file Int, spelling Text) Result[List[ReferenceEvidence], Text] {
    let tokens = reference_tokens(analysis, file)?
    let offsets = new[Int]()
    var index = 0
    while index < length(tokens) {
        let token = get(tokens, index)
        if token.kind == Kind.Name && token.value == spelling {
            push(offsets, token.span.start)
        }
        index = index + 1
    }
    Result.Ok(reference_evidence(analysis, file, offsets, Option.Some(tokens)))
}

// Capture all ordinary callers in the selected module through a query-only
// queue. This cache is independent of navigation/abstract declaration queries.
fn inspect_source_references(analysis AnalysisState, file Int, offsets List[Int]) Result[List[ReferenceEvidence], Text] {
    if length(analysis.source_declarations) == 0 {
        let view = match source_declaration_query(analysis.bindings, analysis_query_inputs(analysis)) {
            Result.Ok(value) => value
            Result.Err(problem) => {
                return Result.Err(problem.diagnostic.message)
            }
        }
        push(analysis.source_declarations, view)
    }
    let view = get(analysis.source_declarations, 0)
    let tokens = reference_tokens(analysis, file)?
    let output = new[ReferenceEvidence]()
    var index = 0
    while index < length(offsets) {
        let offset = get(offsets, index)
        push(output, ReferenceEvidence {
                offset = offset,
                inspection = if source_body_view(analysis, view, file, offset) {
                    checked_inspection(analysis, file, offset, tokens, view)
                } else {
                    checked_inspection(analysis, file, offset, tokens, view.declarations)
                }
            })
        index = index + 1
    }
    Result.Ok(output)
}

// Preserve ordinary navigation and abstract/header selection. Only an ordinary
// source scope absent from executable IR uses this already-checked body view.
fn source_body_view(analysis AnalysisState, view CheckedQuery, file Int, offset Int) Bool {
    let scope = declaration_query_scope(analysis.bindings, file, offset)
    if scope.file < 0 || source_header_at(analysis, file, offset) {
        return false
    }
    var index = 0
    while index < length(analysis.program.functions) {
        let body = get(analysis.program.functions, index)
        let item = get(analysis.bindings.symbols, body.symbol)
        if item.file == file && inside(item.node.span, offset) {
            return false
        }
        index = index + 1
    }
    var matches = 0
    index = 0
    while index < length(view.functions) {
        let body = get(view.functions, index)
        let item = get(view.bindings.symbols, body.symbol)
        if item.file == file && same_span(item.node.span, scope.span) && !has(item.node, NodeKind.ExpansionId) {
            matches = matches + 1
        }
        index = index + 1
    }
    matches == 1
}
