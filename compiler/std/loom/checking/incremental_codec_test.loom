test fn snapshot_enum_tags_preserve_declaration_order_and_reject_unknowns() {
    assert cache_type_tag(TypeKind.Unit) == 0 && cache_type_tag(TypeKind.Rigid) == 19
    assert cache_expression_tag(ExprKind.Integer) == 0
    assert cache_expression_tag(ExprKind.ClosureEnvironment) == 40
    var index = 0
    while index < 20 {
        assert match cache_type_kind(index) {
            Result.Ok(kind) => cache_type_tag(kind) == index
            Result.Err(_) => false
        }
        index = index + 1
    }
    index = 0
    while index < 41 {
        assert match cache_expression_kind(index) {
            Result.Ok(kind) => cache_expression_tag(kind) == index
            Result.Err(_) => false
        }
        index = index + 1
    }
    assert match cache_type_kind(-1) {
        Result.Err(message) => message == "unknown cached type kind"
        Result.Ok(_) => false
    }
    assert match cache_expression_kind(41) {
        Result.Err(message) => message == "unknown cached expression kind"
        Result.Ok(_) => false
    }
}

test fn snapshot_numbers_keep_the_canonical_counted_encoding() {
    let values = [0, 1, -1, 9, 10, -10, 999, 1000, -1000,
        9223372036854775807, -9223372036854775808]
    let output = std.bytes.new()
    let expected = std.bytes.new()
    var index = 0
    while index < length(values) {
        let value = get(values, index)
        cache_int(output, value)
        cache_text(expected, std.int.to_text(value))
        index = index + 1
    }
    assert std.bytes.to_text(output) == std.bytes.to_text(expected)
    let reader = cache_reader(std.bytes.to_text(output))
    index = 0
    while index < length(values) {
        let value = get(values, index)
        assert match cache_read_int(reader) {
            Result.Ok(decoded) => decoded == value
            Result.Err(_) => false
        }
        index = index + 1
    }
    assert get(reader.cursor, 0) == std.text.length(reader.text)
}

test fn snapshot_fields_keep_short_long_empty_and_utf8_boundaries() {
    let values = ["", "0", "123456789", "1234567890", "雪", "after"]
    let output = std.bytes.new()
    var index = 0
    while index < length(values) {
        cache_text(output, get(values, index))
        index = index + 1
    }
    let reader = cache_reader(std.bytes.to_text(output))
    index = 0
    while index < length(values) {
        assert match cache_read_text(reader) {
            Result.Ok(value) => value == get(values, index)
            Result.Err(_) => false
        }
        index = index + 1
    }
    assert get(reader.cursor, 0) == std.text.length(reader.text)
}

test fn snapshot_field_lengths_preserve_existing_noncanonical_decimal_inputs() {
    let sources = ["+1\nx", "01\nx", "00\n", "-0\n"]
    let expected = ["x", "x", "", ""]
    var index = 0
    while index < length(sources) {
        let reader = cache_reader(get(sources, index))
        assert match cache_read_text(reader) {
            Result.Ok(value) => value == get(expected, index)
            Result.Err(_) => false
        }
        assert get(reader.cursor, 0) == std.text.length(reader.text)
        index = index + 1
    }
}

test fn snapshot_fields_reject_truncation_and_invalid_sizes_before_advancing() {
    let malformed = ["", "1", "-1\n", "x\nx", "9223372036854775807\nx",
        "9223372036854775808\nx", "-9223372036854775809\nx"]
    var index = 0
    while index < length(malformed) {
        let reader = cache_reader(get(malformed, index))
        assert match cache_read_text(reader) {
            Result.Err(_) => true
            Result.Ok(_) => false
        }
        assert get(reader.cursor, 0) == 0
        index = index + 1
    }
    let fields = ["", "123456789", "1234567890"]
    index = 0
    while index < length(fields) {
        let output = std.bytes.new()
        cache_text(output, get(fields, index))
        let text = std.bytes.to_text(output)
        var end = 0
        while end < std.text.length(text) {
            let reader = cache_reader(std.text.slice(text, 0, end))
            assert match cache_read_text(reader) {
                Result.Err(_) => true
                Result.Ok(_) => false
            }
            assert get(reader.cursor, 0) == 0
            end = end + 1
        }
        index = index + 1
    }
}
