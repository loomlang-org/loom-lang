import std.loom.proof.z3.backend

fn quantified_children_inputs() BuildInputs {
    with_proof_backend(build_inputs(no_input_reader), backend("z3"))
}

fn quantified_children_checked(source Text) Result[std.loom.typed.Program, Failure] {
    check_with_inputs(bind(fixture_project(list_constraint_files(source)), false)?, quantified_children_inputs())
}

fn quantified_children_accept(source Text) {
    match quantified_children_checked(source) {
        Result.Ok(_) => {
        }
        Result.Err(failed) => {
            discard write_error(failed.diagnostic.message)
            assert false
        }
    }
}

fn quantified_children_reject(source Text) {
    assert match quantified_children_checked(source) {
        Result.Ok(_) => false
        Result.Err(_) => true
    }
}

fn quantified_children_source() Text {
    """
    import std.list.length
    import std.list.push
    type Head = List[Int] where length(self) > 0 && self[0] > 0
    fn valid(values List[Head]) Bool {
        var index = 0
        while index < length(values) {
            if values[index][0] <= 0 { return false }
            index = index + 1
        }
        true
    }
    type Groups = List[Head] where valid(self)

    """
}

test fn quantified_children_keep_independent_predicates_under_legal_alias_writes() {
    quantified_children_accept(concat(quantified_children_source(), """
        pub fn publish(values List[Head]) Groups {
            Groups(values)
        }
        pub fn append(values Groups, child Head) {
            push(values, child)
        }
        pub fn observe(values List[Head]) Bool
        ensures result
        {
            valid(values)
        }
        fn main() {
            let child = Head([1])
            let raw = [child]
            let published = publish(raw)
            child[0] = 2
            push(raw, Head([3]))
            assert observe(published)
        }
        """))
    quantified_children_reject(concat(quantified_children_source(), """
        pub fn invalid(values Groups) {
            values[0][0] = 0
        }
        """))
    quantified_children_reject(concat(quantified_children_source(), """
        pub fn invalid(values Groups) List[Int] {
            values[0]
        }
        """))
    quantified_children_reject(std.text.join(std.text.split(quantified_children_source(),
                "if values[index][0] <= 0"), "if values[index][0] != 1"))
}

test fn quantified_children_do_not_need_a_recursive_element_whitelist() {
    quantified_children_accept("""
        import std.list.length
        type Head = List[Int] where length(self) > 0 && self[0] > 0
        record Node {
            head Head
            children List[Node]
        }
        fn valid(values List[Node]) Bool {
            var index = 0
            while index < length(values) {
                if values[index].head[0] <= 0 { return false }
                index = index + 1
            }
            true
        }
        type Nodes = List[Node] where valid(self)
        pub fn publish(values List[Node]) Nodes {
            Nodes(values)
        }
        """)
    quantified_children_accept("""
        import std.list.length
        type Head[T] = List[T] where length(self) > 0
        fn valid[T](values List[Head[T]]) Bool {
            var index = 0
            while index < length(values) {
                if length(values[index]) <= 0 { return false }
                index = index + 1
            }
            true
        }
        type Groups[T] = List[Head[T]] where valid(self)
        pub fn publish[T](values List[Head[T]]) Groups[T] {
            Groups(values)
        }
        """)
}

test fn quantified_children_reject_unprotected_contents_and_changed_dependencies() {
    let app = """
        import std.list.length
        import values.Head
        fn valid(values List[Head]) Bool {
            var index = 0
            while index < length(values) {
                if values[index][0] <= 0 { return false }
                index = index + 1
            }
            true
        }
        type Groups = List[Head] where valid(self)
        pub fn publish(values List[Head]) Groups { Groups(values) }
        """
    let provider = """
        import std.list.length
        pub type Head = List[Int] where length(self) > 0 && self[0] > 0
        """
    let files = list_constraint_files(app)
    push(files, source_file("values", provider, false))
    let cache = definition_cache()
    assert match check_project_cached(fixture_project(files), false, quantified_children_inputs(), cache) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    let restored = restored_definition_cache(cache)
    set(files, 0, source_file("app", concat(app, "\nfn unrelated() {\n}\n"), false))
    assert match check_project_cached(fixture_project(files), false, quantified_children_inputs(), restored) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert bodies_reused(restored) > 0
    set(files, length(files) - 1, source_file("values",
            std.text.join(std.text.split(provider, "self[0] > 0"), "self[0] >= 0"), false))
    assert match check_project_cached(fixture_project(files), false, quantified_children_inputs(), restored) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}
