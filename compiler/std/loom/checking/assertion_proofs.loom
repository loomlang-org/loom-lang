import std.loom.proof.AssertionCheck
import std.loom.proof.prove_contract

// Assert.index: 1 is proved for this check; 2 requires revalidation after body
// reuse. The condition stays intact for analysis, worker checks and snapshots.
fn has_assertion(value Expr, status Int) Bool {
    if value.kind == ExprKind.Assert && (status < 0 || value.index >= status) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if has_assertion(get(value.children, index), status) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        var item = 0
        while item < length(arm.body) {
            if has_assertion(get(arm.body, item), status) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn assertion_expressions(values List[Expr], identities List[Int], budget List[Int]) Result[List[Expr], Text] {
    let output = new[Expr]()
    var index = 0
    while index < length(values) {
        push(output, assertion_expression(get(values, index), identities, budget)?)
        index = index + 1
    }
    Result.Ok(output)
}

// Proof queues and emitted queues use the same checked source specialization
// identities. Raw queue indices and source locations alone are insufficient.
fn assertion_expression(value Expr, identities List[Int], budget List[Int]) Result[Expr, Text] {
    if get(budget, 0) <= 0 {
        return Result.Err("assertion identity budget exhausted")
    }
    set(budget, 0, get(budget, 0) - 1)
    var target = value.index
    if value.kind == ExprKind.Assert {
        target = -1
    }
    if value.kind == ExprKind.Call || value.kind == ExprKind.TaskCall ||
    value.kind == ExprKind.FunctionRef || value.kind == ExprKind.ClosureEnvironment {
        if target < 0 || target >= length(identities) || get(identities, target) < 0 {
            return Result.Err("assertion needs a checked source call identity")
        }
        target = get(identities, target)
    }
    let arms = new[Arm]()
    var index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        push(arms, Arm {
                body = assertion_expressions(arm.body, identities, budget)?
                ..arm
            })
        index = index + 1
    }
    Result.Ok(Expr {
            index = target
            children = assertion_expressions(value.children, identities, budget)?
            arms = arms
            ..value
        })
}

fn same_assertion_expression(left Expr, right Expr, budget List[Int]) Bool {
    if get(budget, 0) <= 0 || left.kind != right.kind || left.ty != right.ty ||
    left.text != right.text || left.index != right.index || left.falls != right.falls ||
    length(left.children) != length(right.children) || length(left.arms) != length(right.arms) {
        return false
    }
    set(budget, 0, get(budget, 0) - 1)
    var index = 0
    while index < length(left.children) {
        if !same_assertion_expression(get(left.children, index), get(right.children, index), budget) {
            return false
        }
        index = index + 1
    }
    index = 0
    while index < length(left.arms) {
        let a = get(left.arms, index)
        let b = get(right.arms, index)
        if a.variant != b.variant || a.whole != b.whole || !same(a.bindings, b.bindings) ||
        length(a.body) != length(b.body) {
            return false
        }
        var item = 0
        while item < length(a.body) {
            if !same_assertion_expression(get(a.body, item), get(b.body, item), budget) {
                return false
            }
            item = item + 1
        }
        index = index + 1
    }
    true
}

fn same_assertion(left Expr, right Expr) Bool {
    left.span.start == right.span.start && left.span.end == right.span.end &&
    same_assertion_expression(left, right, [2048])
}

fn assertion_keys(identities List[Int], checks List[AssertionCheck]) List[Expr] {
    let keys = new[AssertionCheck]()
    var index = 0
    var any = false
    while index < length(checks) {
        any = any || get(checks, index).proved
        index = index + 1
    }
    if !any {
        return []
    }
    index = 0
    while index < length(checks) {
        let check = get(checks, index)
        let key = match assertion_expression(check.expression, identities, [2048]) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return []
            }
        }
        push(keys, AssertionCheck {
                expression = key
                proved = check.proved
            })
        index = index + 1
    }
    let proved = new[Expr]()
    index = 0
    while index < length(keys) {
        let candidate = get(keys, index)
        var valid = candidate.proved
        var other = 0
        while valid && other < length(keys) {
            let observed = get(keys, other)
            if !observed.proved && same_assertion(candidate.expression, observed.expression) {
                valid = false
            }
            other = other + 1
        }
        if valid {
            push(proved, candidate.expression)
        }
        index = index + 1
    }
    proved
}

fn assertion_markers(value Expr, identities List[Int], keys List[Expr], reset Int, inherited_cleanup Bool) Expr {
    // Normal-return proofs omit fault/cancellation entries into cleanup.
    // Registration and normal-exit copies must retain the same source checks.
    let cleanup = inherited_cleanup || value.kind == ExprKind.Defer ||
    value.kind == ExprKind.Cleanup || value.kind == ExprKind.ResourceDrain
    var marker = value.index
    if value.kind == ExprKind.Assert {
        marker = if cleanup {
            -1
        } else {
            reset
        }
        if !cleanup && reset == -1 && length(keys) != 0 {
            match assertion_expression(value, identities, [2048]) {
                Result.Ok(key) => {
                    var index = 0
                    while index < length(keys) {
                        if same_assertion(key, get(keys, index)) {
                            marker = 1
                        }
                        index = index + 1
                    }
                }
                Result.Err(_) => {
                }
            }
        }
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, assertion_markers(get(value.children, index), identities, keys, reset, cleanup))
        index = index + 1
    }
    let arms = new[Arm]()
    index = 0
    while index < length(value.arms) {
        let arm = get(value.arms, index)
        let body = new[Expr]()
        var item = 0
        while item < length(arm.body) {
            push(body, assertion_markers(get(arm.body, item), identities, keys, reset, cleanup))
            item = item + 1
        }
        push(arms, Arm {
                body = body
                ..arm
            })
        index = index + 1
    }
    Expr {
        index = marker
        children = children
        arms = arms
        ..value
    }
}

fn with_assertion_keys(function Function, identities List[Int], keys List[Expr]) Function {
    if length(keys) == 0 && !has_assertion(function.body, 1) {
        return function
    }
    with_body(function, assertion_markers(function.body, identities, keys, -1, false))
}

fn with_assertion_proofs(function Function, identities List[Int], proof_ids List[Int], checks List[AssertionCheck]) Function {
    with_assertion_keys(function, identities, assertion_keys(proof_ids, checks))
}

fn without_assertion_proofs(function Function) Function {
    if !has_assertion(function.body, 1) {
        return function
    }
    with_body(function, assertion_markers(function.body, [], [], -1, false))
}

fn pending_assertion_proofs(function Function) Function {
    if !has_assertion(function.body, -1) {
        return function
    }
    with_body(function, assertion_markers(function.body, [], [], 2, false))
}

fn collect_assertion_proofs(value Expr, checks List[AssertionCheck]) {
    if value.kind == ExprKind.Assert && value.index == 1 {
        push(checks, AssertionCheck {
                expression = value
                proved = true
            })
    }
    var index = 0
    while index < length(value.children) {
        collect_assertion_proofs(get(value.children, index), checks)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            collect_assertion_proofs(get(body, item), checks)
            item = item + 1
        }
        index = index + 1
    }
}

fn retained_assertion_keys(env Environment, function Function) List[Expr] {
    if !has_assertion(function.body, 1) {
        return []
    }
    let checks = new[AssertionCheck]()
    collect_assertion_proofs(function.body, checks)
    assertion_keys(function_identities(env, length(env.pending)), checks)
}

fn proved_scalar_contract(context Context, types List[Type], function Function,
    backend ProofBackend, protected List[InputGuarantee]) Result[Function, Text] {
    if !has_assertion(function.body, -1) {
        discard verify_with_types(types, function, backend, protected)?
        return Result.Ok(function)
    }
    let evidence = prove_contract(types, function, backend, false, protected)?
    Result.Ok(with_assertion_proofs(function, [], [], evidence.assertions))
}

fn proved_helper_contract(context Context, program std.loom.typed.Program, proof Function,
    function Function, backend ProofBackend, protected List[InputGuarantee]) Result[Function, Text] {
    if !has_assertion(function.body, -1) {
        let conditions = verify_with_helpers(program, proof, backend, protected)?
        return Result.Ok(with_contracts(function, function.preconditions, conditions))
    }
    let evidence = prove_contract(program, proof, backend, false, protected)?
    Result.Ok(with_assertion_proofs(
            with_contracts(function, function.preconditions, evidence.postconditions),
            function_identities(context.env, length(context.env.pending)),
            program.function_identities, evidence.assertions))
}

// Fresh declarations already supplied their evidence during required checking.
// Only replayed or erased-family bodies need a new concrete observation pass.
fn revalidate_assertion_proofs(env Environment, program std.loom.typed.Program) {
    var index = 0
    while index < length(program.functions) {
        let function = get(program.functions, index)
        if has_assertion(function.body, 2) {
            var checked = without_assertion_proofs(function)
            if length(function.postconditions) != 0 {
                let types = match expanded_invariant_types(env, function) {
                    Result.Ok(types) => types
                    Result.Err(_) => env.types
                }
                match prove_contract(proof_types(program, types), checked,
                    get(env.inputs, 0).build.proof_backend, false, continuing_sequence_guarantees(env)) {
                    Result.Ok(evidence) => {
                        checked = with_assertion_proofs(checked,
                            program.function_identities, program.function_identities, evidence.assertions)
                    }
                    Result.Err(_) => {
                        // Required checking already succeeded with the source
                        // assertion intact. Unknown optional evidence keeps it.
                    }
                }
            }
            set(program.functions, index, checked)
        }
        index = index + 1
    }
}
