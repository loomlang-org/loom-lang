// Keys model immutable argument values, not a runtime tagged representation.
// A partial predicate has independent truth and successful-evaluation functions.
// No declaration claims that either function is true, total or terminating.
fn smt_predicate_keys(writer SmtWriter) {
    var index = 0
    while index < length(writer.names) {
        if get(writer.names, index) == "loom_pk" {
            return
        }
        index = index + 1
    }
    push(writer.names, "loom_pk")
    smt_append(writer.declarations, """
        (declare-datatypes ((loom_pk 0) (loom_pks 0))
          (((pk_int (pk_int_value Int))
            (pk_bool (pk_bool_value Bool))
            (pk_text (pk_text_value (Seq (_ BitVec 8))))
            (pk_record (pk_record_fields loom_pks))
            (pk_sum (pk_sum_type Int) (pk_sum_tag Int) (pk_sum_fields loom_pks))
            (pk_float_var (pk_float_id Int))
            (pk_float_literal (pk_float_spelling (Seq (_ BitVec 8))))
            (pk_float_apply (pk_float_operator (Seq (_ BitVec 8))) (pk_float_operands loom_pks))
            (pk_float_select (pk_float_array Int) (pk_float_path loom_pks) (pk_float_index Int)))
           ((pk_nil) (pk_cons (pk_head loom_pk) (pk_tail loom_pks)))))
        """)
    smt_append(writer.declarations, "\n")
}

fn smt_key_list(writer SmtWriter, values List[PredicateKey], depth Int) Result[Text, Text] {
    let output = std.bytes.new()
    var index = 0
    while index < length(values) {
        smt_append(output, concat("(pk_cons ", concat(smt_key(writer, get(values, index), depth + 1)?, " ")))
        index = index + 1
    }
    smt_append(output, "pk_nil")
    index = 0
    while index < length(values) {
        smt_append(output, ")")
        index = index + 1
    }
    Result.Ok(std.bytes.to_text(output))
}

// Floating-point origin equality is stronger than numerical equality. These
// keys may distinguish equal bits, but never identify different representations
// merely because IEEE comparisons equate them. Array indices remain symbolic.
fn smt_float_key(writer SmtWriter, value FloatValue, depth Int) Result[Text, Text] {
    discard smt_step(writer, depth)?
    match value {
        FloatValue.Variable(id) => Result.Ok(concat("(pk_float_var ", concat(std.int.to_text(id), ")")))
        FloatValue.Literal(text) => Result.Ok(concat("(pk_float_literal ",
                concat(smt_text(writer, TextValue.Literal(text), depth + 1)?, ")")))
        FloatValue.Select(identity, path, index) => {
            let keys = new[PredicateKey]()
            var field = 0
            while field < length(path) {
                push(keys, PredicateKey.Integer(IntegerTerm.Linear(constant(integer(get(path, field))))))
                field = field + 1
            }
            let output = std.bytes.new()
            smt_append(output, concat("(pk_float_select ", concat(std.int.to_text(identity), " ")))
            smt_append(output, concat(smt_key_list(writer, keys, depth + 1)?, " "))
            smt_append(output, concat(smt_linear(writer, index)?, ")"))
            Result.Ok(std.bytes.to_text(output))
        }
        FloatValue.Apply(operator, inputs) => {
            let keys = new[PredicateKey]()
            var index = 0
            while index < length(inputs) {
                push(keys, PredicateKey.Float(get(inputs, index)))
                index = index + 1
            }
            Result.Ok(concat("(pk_float_apply ",
                    concat(smt_text(writer, TextValue.Literal(operator), depth + 1)?,
                        concat(" ", concat(smt_key_list(writer, keys, depth + 1)?, ")")))))
        }
    }
}

fn smt_key(writer SmtWriter, value PredicateKey, depth Int) Result[Text, Text] {
    discard smt_step(writer, depth)?
    match value {
        PredicateKey.Integer(term) => Result.Ok(concat("(pk_int ", concat(smt_integer(writer, term, depth + 1)?, ")")))
        PredicateKey.Boolean(values) => {
            if length(values) != 1 {
                return Result.Err("invalid predicate Boolean key")
            }
            Result.Ok(concat("(pk_bool ", concat(smt_predicate(writer, get(values, 0), depth + 1)?, ")")))
        }
        PredicateKey.Text(term) => Result.Ok(concat("(pk_text ", concat(smt_text(writer, term, depth + 1)?, ")")))
        PredicateKey.Float(term) => smt_float_key(writer, term, depth + 1)
        PredicateKey.Record(fields) => Result.Ok(concat("(pk_record ", concat(smt_key_list(writer, fields, depth + 1)?, ")")))
        PredicateKey.Sum(ty, tag, fields) => {
            let selected = smt_linear(writer, tag)?
            var payload = "pk_nil"
            var index = length(fields)
            while index > 0 {
                index = index - 1
                payload = concat("(ite (= ", concat(selected, concat(" ",
                            concat(std.int.to_text(index), concat(") ",
                                    concat(smt_key_list(writer, get(fields, index), depth + 1)?,
                                        concat(" ", concat(payload, ")"))))))))
            }
            Result.Ok(concat("(pk_sum ", concat(std.int.to_text(ty),
                        concat(" ", concat(selected, concat(" ", concat(payload, ")")))))))
        }
    }
}

fn smt_application(writer SmtWriter, target Int, arguments List[PredicateKey], domain Bool,
    depth Int) Result[Text, Text] {
    smt_predicate_keys(writer)
    let name = concat(if domain {
            "loom_pd"
        } else {
            "loom_p"
        }, std.int.to_text(target))
    var index = 0
    while index < length(writer.names) && get(writer.names, index) != name {
        index = index + 1
    }
    if index == length(writer.names) {
        push(writer.names, name)
        smt_append(writer.declarations, concat("(declare-fun ", concat(name, " (loom_pks) Bool)\n")))
    }
    Result.Ok(concat("(", concat(name, concat(" ", concat(smt_key_list(writer, arguments, depth + 1)?, ")")))))
}
