fn loop_storage_primitive(proof Verification, value Expr) Text {
    if value.kind == ExprKind.Intrinsic {
        return sequence_operation(value.text)
    }
    if value.kind == ExprKind.Call && value.index >= 0 && value.index < length(proof.program.functions) {
        return sequence_operation(forwarded_list_operation(proof.program.functions,
                get(proof.program.functions, value.index), 0))
    }
    ""
}

record LoopStorageTargets {
    resized List[Int]
    modified List[Int]
    extent_preserved Bool
}

record LoopStoragePlan {
    expression Expr
    depth Int
    sites List[Expr]
}

// Cache checked syntax only. Every application resolves receivers, callback
// exposure and callee effects against the current symbolic state/program.
// The first traversal pays its ordinary work cost and validates the same depth.
fn loop_storage_nodes(proof Verification, value Expr, sites List[Expr], depth Int) Result[Bool, Text] {
    discard loop_step(proof)?
    if depth <= 0 {
        return Result.Err("loop extent analysis budget exhausted")
    }
    if cell_store_expression(proof.program, value) {
        return loop_storage_nodes(proof, cell_store_view(value), sites, depth - 1)
    }
    let kind = value.kind
    if kind == ExprKind.Call || kind == ExprKind.Intrinsic || kind == ExprKind.IndirectCall ||
    kind == ExprKind.FrameStore || kind == ExprKind.Await || kind == ExprKind.Suspend {
        push(sites, value)
    }
    var index = 0
    while index < length(value.children) {
        discard loop_storage_nodes(proof, get(value.children, index), sites, depth - 1)?
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            discard loop_storage_nodes(proof, get(body, item), sites, depth - 1)?
            item = item + 1
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn loop_storage_sites(proof Verification, value Expr, depth Int) Result[List[Expr], Text] {
    discard loop_step(proof)?
    var index = 0
    while index < length(proof.loop_storage_plans) {
        let plan = get(proof.loop_storage_plans, index)
        if depth >= plan.depth && exact_expression(value, plan.expression) {
            return Result.Ok(plan.sites)
        }
        index = index + 1
    }
    let sites = new[Expr]()
    discard loop_storage_nodes(proof, value, sites, depth)?
    if length(proof.loop_storage_plans) < 64 {
        push(proof.loop_storage_plans, LoopStoragePlan {
                expression = value
                depth = depth
                sites = sites
            })
    }
    Result.Ok(sites)
}

fn loop_storage_writes(proof Verification, value Expr, entry State, resized List[Int],
    modified List[Int], callbacks List[Int], depth Int) Result[Bool, Text] {
    let sites = loop_storage_sites(proof, value, depth)?
    var index = 0
    while index < length(sites) {
        discard loop_storage_write(proof, get(sites, index), entry, resized, modified, callbacks)?
        index = index + 1
    }
    Result.Ok(true)
}

fn loop_storage_write(proof Verification, value Expr, entry State, resized List[Int],
    modified List[Int], callbacks List[Int]) Result[Bool, Text] {
    discard loop_step(proof)?
    if value.kind == ExprKind.FrameStore {
        push(resized, -1)
        push(modified, -1)
    }
    let primitive = loop_storage_primitive(proof, value)
    if value.kind == ExprKind.Call && primitive == "" {
        if !extent_preserving(proof.program, value) {
            push(resized, -1)
        }
        if !elements_preserving(proof.program, value) {
            push(modified, -1)
        }
    }
    if value.kind == ExprKind.IndirectCall {
        var index = 0
        while index < length(callbacks) {
            push(resized, get(callbacks, index))
            push(modified, get(callbacks, index))
            index = index + 1
        }
    }
    if value.kind == ExprKind.Await || value.kind == ExprKind.Suspend ||
    primitive == "list_retain_range" || primitive == "task_drain" ||
    primitive == "task_cancel" || primitive == "task_ready_result" || primitive == "task_ready_outcome" {
        push(resized, -1)
        push(modified, -1)
    }
    let resize = primitive == "list_push" || primitive == "list_append" || primitive == "list_take"
    if (resize || primitive == "list_set" || primitive == "list_replace") && length(value.children) > 0 {
        let identity = match pure(get(value.children, 0), entry) {
            Result.Ok(receiver) => match receiver {
                Value.List(identity) => identity
                _ => -1
            }
            Result.Err(_) => -1
        }
        if resize {
            push(resized, identity)
        }
        push(modified, identity)
    }
    Result.Ok(true)
}

fn loop_storage_targets(proof Verification, value Expr, entry State, writes List[Bool]) Result[LoopStorageTargets, Text] {
    let resized = new[Int]()
    let modified = new[Int]()
    if length(entry.extents) == 0 || elements_preserving(proof.program, value) {
        return Result.Ok(LoopStorageTargets {
                resized = resized
                modified = modified
                extent_preserved = true
            })
    }
    let preserved = extent_preserving(proof.program, value)
    var index = 0
    while index < length(proof.function.locals) {
        if get(writes, index) && loop_list_type(proof, get(proof.function.locals, index).ty, 0) {
            // A rebound receiver can target a different alias on later iterations.
            return Result.Ok(LoopStorageTargets {
                    resized = if preserved {
                        resized
                    } else {
                        [-1]
                    }
                    modified = [-1]
                    extent_preserved = preserved
                })
        }
        index = index + 1
    }
    let callbacks = loop_callback_targets(proof, value, entry, writes)
    discard loop_storage_writes(proof, value, entry, resized, modified, callbacks, 64)?
    Result.Ok(LoopStorageTargets {
            resized = if preserved {
                []
            } else {
                resized
            }
            modified = modified
            extent_preserved = preserved
        })
}

fn loop_list_type(proof Verification, ty Int, depth Int) Bool {
    if depth >= 16 || ty < 0 || ty >= length(proof.program.types) {
        return false
    }
    let shape = get(proof.program.types, ty)
    if shape.kind == TypeKind.List || shape.kind == TypeKind.Bytes {
        return true
    }
    var index = 0
    while index < length(shape.fields) {
        if loop_list_type(proof, get(shape.fields, index).ty, depth + 1) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(shape.variants) {
        let fields = get(shape.variants, index).fields
        var field = 0
        while field < length(fields) {
            if loop_list_type(proof, get(fields, field), depth + 1) {
                return true
            }
            field = field + 1
        }
        index = index + 1
    }
    false
}

// A stable handle can still name resized storage. Reuse entry comparisons for
// those leaves even when no assignment writes the local that holds the handle.
fn loop_entry_storage_candidates(proof Verification, candidates List[LoopCandidate], index Int, path List[Int], initial Value, entry State, resized List[Int]) Result[Bool, Text] {
    discard loop_step(proof)?
    match initial {
        Value.List(identity) => {
            if extent_modified(list_state(identity, entry)?, entry, resized) {
                discard loop_entry_candidates(proof, candidates, index, path, initial, entry)?
            }
        }
        Value.Record(fields) => {
            var field = 0
            while field < length(fields) {
                let nested = std.list.clone(path)
                push(nested, field)
                discard loop_entry_storage_candidates(proof, candidates, index, nested, get(fields, field), entry, resized)?
                field = field + 1
            }
        }
        _ => {
        }
    }
    Result.Ok(true)
}

// Copy/build loops commonly advance an index with an output length. Propose
// only equalities true at entry; ordinary backedge induction must preserve them.
// Nonzero offsets matter only for possibly resized storage, avoiding speculative
// relationships between unrelated read-only lengths and mutable scalar locals.
fn loop_extent_candidates(proof Verification, candidates List[LoopCandidate], writes List[Bool], resized List[Int], entry State) Result[Bool, Text] {
    var extent = 0
    while extent < length(entry.extents) && length(candidates) < 64 {
        let identity = get(entry.extents, extent).identity
        var local = 0
        while local < length(writes) && length(candidates) < 64 {
            if get(writes, local) {
                discard loop_step(proof)?
                match get(entry.locals, local) {
                    Value.Number(_) => {
                        let initial = list_value_index(get(entry.locals, local))?
                        let offset = add_scaled(list_extent(identity, entry)?, initial, integer(-1))
                        if extent_modified(get(entry.extents, extent), entry, resized) ||
                        (length(offset.terms) == 0 && compare(offset.constant, integer(0)) == 0) {
                            discard loop_affine_pair(proof, candidates,
                                LoopObservation.Storage(identity), LoopObservation.Local(local, new[Int]()),
                                integer(1), integer(-1), entry)?
                        }
                    }
                    _ => {
                    }
                }
            }
            local = local + 1
        }
        extent = extent + 1
    }
    Result.Ok(true)
}
