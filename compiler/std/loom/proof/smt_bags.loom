// Finite histogram algebra: an in-range store removes the old occurrence and
// adds the new one. These are sequence laws, not trusted application lemmas.
fn smt_bag_function(writer SmtWriter) {
    var index = 0
    while index < length(writer.names) {
        if get(writer.names, index) == "loom_bag" {
            return
        }
        index = index + 1
    }
    push(writer.names, "loom_bag")
    smt_append(writer.declarations, "(declare-fun loom_bag ((Array Int Int) Int) (Array Int Int))\n")
}

fn smt_bag(writer SmtWriter, array Text, size Linear) Result[Text, Text] {
    smt_bag_function(writer)
    Result.Ok(concat("(loom_bag ", concat(array, concat(" ", concat(smt_linear(writer, size)?, ")")))))
}

fn bag_bound_scope(value Text, size Linear) Text {
    bag_bound_scope(value, [size])
}

// Scope is a union of bound identities, not an arithmetic combination of
// extents: opposite coefficients must not cancel a required binder.
fn bag_bound_scope(value Text, sizes List[Linear]) Text {
    let bindings = new[Int]()
    var size = 0
    while size < length(sizes) {
        let terms = get(sizes, size).terms
        var index = 0
        while index < length(terms) {
            let identity = get(terms, index).id
            var found = false
            var prior = 0
            while prior < length(bindings) && !found {
                found = get(bindings, prior) == identity
                prior = prior + 1
            }
            if identity < 0 && !found {
                push(bindings, identity)
            }
            index = index + 1
        }
        size = size + 1
    }
    if length(bindings) == 0 {
        return value
    }
    let output = std.bytes.new()
    smt_append(output, "(forall (")
    var index = 0
    while index < length(bindings) {
        smt_append(output, concat("(n", concat(std.int.to_text(get(bindings, index)), " Int)")))
        index = index + 1
    }
    smt_append(output, concat(") ", concat(value, ")")))
    std.bytes.to_text(output)
}

fn smt_count(writer SmtWriter, identity Int, inputs List[IntegerTerm], depth Int) Result[Text, Text] {
    if length(inputs) != 2 {
        return Result.Err("invalid histogram count operands")
    }
    let size = match get(inputs, 0) {
        IntegerTerm.Linear(size) => size
        _ => {
            return Result.Err("histogram count needs a linear extent")
        }
    }
    let array = smt_array(writer, identity, [])
    let bag = smt_bag(writer, array, size)?
    let needle = smt_integer(writer, get(inputs, 1), depth + 1)?
    let limit = smt_linear(writer, size)?
    var needs_scope = false
    var index = 0
    while index < length(writer.quantifiers) {
        let bound = concat("n", std.int.to_text(get(writer.quantifiers, index).identity))
        needs_scope = needs_scope || smt_mentions(needle, bound) || smt_mentions(limit, bound)
        index = index + 1
    }
    // Instantiate at the actual symbolic needle, under its original lexical
    // ranges. This is a closed law even when the needle reads an array or a
    // nested count. It need not constrain unrelated integers, and an empty
    // enclosing range imposes no law at all. No source value is sampled.
    let count = concat("(select ", concat(bag, concat(" ", concat(needle, ")"))))
    let output = std.bytes.new()
    smt_append(output, "(and (<= 0 ")
    smt_append(output, count)
    smt_append(output, ") (<= ")
    smt_append(output, count)
    smt_append(output, " (ite (>= ")
    smt_append(output, limit)
    smt_append(output, " 0) ")
    smt_append(output, limit)
    smt_append(output, " 0)))")
    var law = std.bytes.to_text(output)
    if needs_scope {
        // Retain the entire enclosing scope: an inner range may itself use an
        // outer binder absent from the needle. Wrap inside out so those bounds
        // are interpreted in their original scope.
        index = length(writer.quantifiers)
        while index > 0 {
            index = index - 1
            law = smt_binder(get(writer.quantifiers, index), law)
        }
    }
    smt_assert(writer, bag_bound_scope(law, size))
    Result.Ok(concat("(select ", concat(bag, concat(" ", concat(needle, ")")))))
}

fn count_extent(output List[Linear], size Linear) {
    var index = 0
    while index < length(output) {
        let prior = get(output, index)
        if compare(prior.constant, size.constant) == 0 && same_terms(prior.terms, size.terms) {
            return
        }
        index = index + 1
    }
    push(output, size)
}

fn count_term_extents(output List[Linear], term IntegerTerm, depth Int) {
    if depth <= 0 {
        return
    }
    match term {
        IntegerTerm.Function(value) => count_key_extents(output, value.arguments, depth - 1)
        IntegerTerm.TextLength(value) => count_text_extents(output, value, depth - 1)
        IntegerTerm.TextByte(value, bounds) => {
            count_text_extents(output, value, depth - 1)
            var index = 0
            while index < length(bounds) {
                count_term_extents(output, get(bounds, index), depth - 1)
                index = index + 1
            }
        }
        IntegerTerm.Count(_, inputs) => {
            if length(inputs) == 2 {
                match get(inputs, 0) {
                    IntegerTerm.Linear(size) => {
                        count_extent(output, size)
                    }
                    _ => {
                    }
                }
                count_term_extents(output, get(inputs, 1), depth - 1)
            }
        }
        IntegerTerm.Apply(_, inputs) => {
            var index = 0
            while index < length(inputs) {
                count_term_extents(output, get(inputs, index), depth - 1)
                index = index + 1
            }
        }
        _ => {
        }
    }
}

fn count_predicate_extents(output List[Linear], value Predicate, depth Int) {
    if depth <= 0 {
        return
    }
    match value {
        Predicate.Application(value, _) => count_key_extents(output, value.arguments, depth - 1)
        Predicate.ValueEqual(values) => count_key_extents(output, values, depth - 1)
        Predicate.TextEqual(first, second) => {
            count_text_extents(output, first, depth - 1)
            count_text_extents(output, second, depth - 1)
        }
        Predicate.FloatCompare(_, first, second) => {
            count_float_extents(output, first, depth - 1)
            count_float_extents(output, second, depth - 1)
        }
        Predicate.BagEqual(_, first, _, second) => {
            count_extent(output, first)
            count_extent(output, second)
        }
        Predicate.IntegerCompare(_, first, second) => {
            count_term_extents(output, first, depth - 1)
            count_term_extents(output, second, depth - 1)
        }
        Predicate.ArrayWrite(_, _, _, _, term) => {
            count_scalar_extents(output, term, depth - 1)
        }
        Predicate.ArrayRead(_, _, _, term, guards) => {
            count_scalar_extents(output, term, depth - 1)
            count_predicate_extents(output, get(guards, 0), depth - 1)
        }
        Predicate.Forall(_, _, _, conditions) => {
            count_predicate_extents(output, get(conditions, 0), depth - 1)
        }
        Predicate.And(values) => count_predicate_list(output, values, depth - 1)
        Predicate.Or(values) => count_predicate_list(output, values, depth - 1)
        Predicate.Equal(values) => count_predicate_list(output, values, depth - 1)
        Predicate.Not(values) => count_predicate_list(output, values, depth - 1)
        _ => {
        }
    }
}

fn count_key_extents(output List[Linear], keys List[PredicateKey], depth Int) {
    if depth <= 0 {
        return
    }
    var index = 0
    while index < length(keys) {
        match get(keys, index) {
            PredicateKey.Integer(term) => count_term_extents(output, term, depth - 1)
            PredicateKey.Text(term) => count_text_extents(output, term, depth - 1)
            PredicateKey.Float(term) => count_float_extents(output, term, depth - 1)
            PredicateKey.Boolean(values) => count_predicate_list(output, values, depth - 1)
            PredicateKey.Record(fields) => count_key_extents(output, fields, depth - 1)
            PredicateKey.Sum(_, tag, variants) => {
                count_term_extents(output, tag, depth - 1)
                var variant = 0
                while variant < length(variants) {
                    count_key_extents(output, get(variants, variant), depth - 1)
                    variant = variant + 1
                }
            }
        }
        index = index + 1
    }
}

fn count_scalar_extents(output List[Linear], value ArrayScalar, depth Int) {
    match value {
        ArrayScalar.Integer(term) => count_term_extents(output, term, depth)
        ArrayScalar.Boolean(values) => count_predicate_list(output, values, depth)
        ArrayScalar.Text(term) => count_text_extents(output, term, depth)
        ArrayScalar.Float(term) => count_float_extents(output, term, depth)
    }
}

fn count_text_extents(output List[Linear], value TextValue, depth Int) {
    if depth <= 0 {
        return
    }
    match value {
        TextValue.Function(value) => count_key_extents(output, value.arguments, depth - 1)
        TextValue.Joined(parts) => {
            var index = 0
            while index < length(parts) {
                count_text_extents(output, get(parts, index), depth - 1)
                index = index + 1
            }
        }
        TextValue.Slice(parts, bounds) => {
            var index = 0
            while index < length(parts) {
                count_text_extents(output, get(parts, index), depth - 1)
                index = index + 1
            }
            index = 0
            while index < length(bounds) {
                count_term_extents(output, get(bounds, index), depth - 1)
                index = index + 1
            }
        }
        _ => {
        }
    }
}

fn count_float_extents(output List[Linear], value FloatValue, depth Int) {
    if depth <= 0 {
        return
    }
    match value {
        FloatValue.Function(value) => count_key_extents(output, value.arguments, depth - 1)
        FloatValue.Apply(_, inputs) => {
            var index = 0
            while index < length(inputs) {
                count_float_extents(output, get(inputs, index), depth - 1)
                index = index + 1
            }
        }
        _ => {
        }
    }
}

fn count_predicate_list(output List[Linear], values List[Predicate], depth Int) {
    var index = 0
    while index < length(values) {
        count_predicate_extents(output, get(values, index), depth)
        index = index + 1
    }
}

fn smt_bag_store(writer SmtWriter, previous Text, stored Text, position Text, value Text, size Linear) Result[Text, Text] {
    let bag = smt_bag(writer, previous, size)?
    let prior_value = concat("(select ", concat(previous, concat(" ", concat(position, ")"))))
    let removed = concat("(store ", concat(bag, concat(" ", concat(prior_value,
                    concat(" (- (select ", concat(bag, concat(" ", concat(prior_value, ") 1))"))))))))
    let changed = concat("(store ", concat(removed, concat(" ", concat(value,
                    concat(" (+ (select ", concat(removed, concat(" ", concat(value, ") 1))"))))))))
    let limit = smt_linear(writer, size)?
    let condition = concat("(and (<= 0 ", concat(position, concat(") (< ", concat(position,
                    concat(" ", concat(limit, "))"))))))
    let update = concat("(= ", concat(smt_bag(writer, stored, size)?,
            concat(" (ite ", concat(condition, concat(" ", concat(changed, concat(" ", concat(bag, "))"))))))))
    Result.Ok(bag_bound_scope(update, size))
}
