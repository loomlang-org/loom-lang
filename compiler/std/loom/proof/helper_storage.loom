// A finite checked footprint retains private storage across source helpers.
// No names, unverified purity annotations or external implementation guesses
// confer locality. Unknown calls, captures and untracked payload stores fail shut.
fn local_storage_operation(program Program, primitive Text, arguments List[Expr]) Bool {
    let name = sequence_operation(primitive)
    if name == "list_new" || name == "list_new_capacity" || name == "list_len" || name == "list_get" || name == "list_take" {
        return true
    }
    let stored = list_stored_index(name)
    stored >= 0 && stored < length(arguments) && immutable_storage_type(program, get(arguments, stored).ty, 0)
}

fn immutable_storage_type(program Program, ty Int, depth Int) Bool {
    if scalar_type(ty) || ty == 0 {
        return true
    }
    if depth >= 16 || ty < 0 || ty >= length(program.types) {
        return false
    }
    let shape = get(program.types, ty)
    if shape.kind == TypeKind.Enum {
        var variant = 0
        while variant < length(shape.variants) {
            let fields = get(shape.variants, variant).fields
            var field = 0
            while field < length(fields) {
                if !immutable_storage_type(program, get(fields, field), depth + 1) {
                    return false
                }
                field = field + 1
            }
            variant = variant + 1
        }
        return true
    }
    if shape.kind != TypeKind.Refined && shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple {
        return false
    }
    var index = 0
    while index < length(shape.fields) {
        if !immutable_storage_type(program, get(shape.fields, index).ty, depth + 1) {
            return false
        }
        index = index + 1
    }
    true
}

// This selects an execution path, never an effect guarantee. Unknown calls,
// recursive scans and exhausted inspection retain the existing expansion.
fn direct_body_write(proof Verification, value Expr, budget List[Int]) Bool {
    if !conjunction_step(budget) || function_layout(value) {
        return false
    }
    if value.kind == ExprKind.FrameStore || cell_store_expression(proof.program, value) {
        return true
    }
    let operation = loop_storage_primitive(proof, value)
    if list_stored_index(operation) >= 0 || operation == "list_take" || operation == "list_retain_range" {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if direct_body_write(proof, get(value.children, index), budget) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if direct_body_write(proof, get(body, item), budget) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

// Closed inputs cannot carry a mutable graph into a callee. This frames
// unpublished caller storage, not the callee's purity or scheduling behavior.
fn closed_storage_inputs(program Program, params List[Int]) Bool {
    var index = 0
    while index < length(params) {
        if !immutable_storage_type(program, get(params, index), 0) {
            return false
        }
        index = index + 1
    }
    true
}

fn storage_local(program Program, body Expr) Bool {
    let budget = new[Int]()
    push(budget, 256)
    preserves_list_state(program, body, budget, StorageRequirement.Local)
}

// A fresh header may hold shared elements. Check its origin and publication,
// separately from verified lengths/contents and origins of nested elements.
fn private_factory(program Program, target Int) Bool {
    if target < 0 || target >= length(program.functions) {
        return false
    }
    let function = get(program.functions, target)
    if function.runtime_name != "" || function.is_async ||
    immutable_storage_type(program, function.result, 0) {
        return false
    }
    let inputs = new[Bool]()
    var closed = true
    var index = 0
    while index < length(function.params) {
        let immutable = immutable_storage_type(program, get(function.params, index), 0)
        push(inputs, immutable)
        closed = closed && immutable
        index = index + 1
    }
    let budget = new[Int]()
    push(budget, 256)
    let effects = new[Bool]()
    push(effects, true)
    let returned = factory_storage(program, target, inputs, closed, effects, budget, [], 0)
    returned && get(effects, 0)
}

// A fresh outer List may retain shared elements. This checks its header and
// publication separately, including successful async completion. Callers still
// validate element predicates and escape/write policy independently.
pub fn fresh_list_factory(program Program, target Int) Bool {
    if target < 0 || target >= length(program.functions) ||
    !proof_sequence_type(program, get(program.functions, target).result) {
        return false
    }
    private_factory(program, target) || private_factory_body(program, target)
}

fn storage_leaves(value Value) Int {
    match value {
        Value.List(_) => 1
        Value.Record(fields) => {
            var count = 0
            var index = 0
            while index < length(fields) && count < 2 {
                count = count + storage_leaves(get(fields, index))
                index = index + 1
            }
            count
        }
        _ => 0
    }
}

fn fresh_storage(value Value, state State) State {
    // A summary has independent symbolic fields, not allocation identities.
    // Multiple returned leaves may alias; do not infer their disjointness.
    fresh_storage(value, state, storage_leaves(value) <= 1)
}

fn fresh_storage(value Value, state State, distinct Bool) State {
    match value {
        Value.List(identity) => with_extent(identity, variable(identity), distinct, true, state)
        Value.Record(fields) => {
            var current = state
            var index = 0
            while index < length(fields) {
                current = fresh_storage(get(fields, index), current, distinct)
                index = index + 1
            }
            current
        }
        _ => state
    }
}
