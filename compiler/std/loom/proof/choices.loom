// Lift scalar choices before translating Boolean results into guarded clauses.
// Evaluation obligations stay in Expansion.checks; this is logical substitution,
// not permission to omit eager arguments or calculations in an executed branch.
fn choice_step(budget List[Int], depth Int) Result[Bool, Text] {
    if depth >= 64 || !conjunction_step(budget) {
        return Result.Err("helper choice expansion budget exhausted")
    }
    Result.Ok(true)
}

fn has_choice(value Expr) Bool {
    has_choice(value, [256], 0)
}

fn has_choice(value Expr, budget List[Int], depth Int) Bool {
    // Exhaustion cannot authorize hiding an unvisited choice during folding.
    if depth >= 64 || !conjunction_step(budget) {
        return true
    }
    if value.kind == ExprKind.If {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if has_choice(get(value.children, index), budget, depth + 1) {
            return true
        }
        index = index + 1
    }
    false
}

fn lifted_choice(condition Expr, yes Expr, no Expr, budget List[Int], depth Int) Result[Expr, Text] {
    discard choice_step(budget, depth)?
    if condition.kind == ExprKind.If {
        let guard = get(condition.children, 0)
        // The condition and result may share one earlier choice. Retain that
        // correlation when lifting the condition, rather than visiting an
        // impossible result arm (including an inactive enum payload).
        let left = lifted_choice(get(condition.children, 1),
            selected_choice(yes, guard, true, budget, depth + 1)?,
            selected_choice(no, guard, true, budget, depth + 1)?, budget, depth + 1)?
        let right = lifted_choice(get(condition.children, 2),
            selected_choice(yes, guard, false, budget, depth + 1)?,
            selected_choice(no, guard, false, budget, depth + 1)?, budget, depth + 1)?
        return Result.Ok(proof_choice(guard, left, right))
    }
    Result.Ok(proof_choice(condition, yes, no))
}

// Only an explicit entry sequence supplies a stable outer value across
// independent reads. Following a mutable child performs another ordinary read
// and cannot use this comparison. Observation identities elsewhere stay exact.
fn choice_entry_projection(left Expr, right Expr, depth Int) Bool {
    if depth >= 16 || left.ty != right.ty {
        return false
    }
    if exact_expression(left, right) {
        return true
    }
    if list_read_expression(left) && list_read_expression(right) &&
    length(left.children) == 2 && length(right.children) == 2 {
        let first = get(left.children, 0)
        let second = get(right.children, 0)
        return entry_list_expression(first) && first.index >= 0 &&
        entry_list_expression(second) && exact_expression(first, second) &&
        exact_expression(get(left.children, 1), get(right.children, 1))
    }
    if left.kind != right.kind || left.index != right.index || left.text != right.text ||
    length(left.children) != length(right.children) {
        return false
    }
    if (left.kind == ExprKind.Field || left.kind == ExprKind.Coerce) && length(left.children) == 1 {
        return choice_entry_projection(get(left.children, 0), get(right.children, 0), depth + 1)
    }
    if left.kind == ExprKind.Intrinsic && left.text == "proof_enum_payload" && length(left.children) == 3 {
        return exact_expression(get(left.children, 1), get(right.children, 1)) &&
        exact_expression(get(left.children, 2), get(right.children, 2)) &&
        choice_entry_projection(get(left.children, 0), get(right.children, 0), depth + 1)
    }
    false
}

fn choice_tag_equality(value Expr) Option[(Expr, Expr)] {
    if value.kind != ExprKind.Binary || value.text != "==" || length(value.children) != 2 {
        return Option.None
    }
    var tag = get(value.children, 0)
    var selected = get(value.children, 1)
    if tag.kind == ExprKind.Integer {
        tag = get(value.children, 1)
        selected = get(value.children, 0)
    }
    if tag.kind != ExprKind.Intrinsic || tag.text != "proof_enum_tag" ||
    length(tag.children) != 1 || selected.kind != ExprKind.Integer {
        return Option.None
    }
    Option.Some((get(tag.children, 0), selected))
}

fn selected_enum_guard(guard Expr, condition Expr, positive Bool) Option[Bool] {
    let inverted = guard.kind == ExprKind.Unary && guard.text == "!"
    let target = if inverted {
        get(guard.children, 0)
    } else {
        guard
    }
    let negated = condition.kind == ExprKind.Unary && condition.text == "!"
    let known = if negated {
        get(condition.children, 0)
    } else {
        condition
    }
    let holds = if negated {
        !positive
    } else {
        positive
    }
    let first, value = match choice_tag_equality(target) {
        Option.Some(pair) => pair
        Option.None => {
            return Option.None
        }
    }
    let second, observed = match choice_tag_equality(known) {
        Option.Some(pair) => pair
        Option.None => {
            return Option.None
        }
    }
    if !choice_entry_projection(first, second, 0) {
        return Option.None
    }
    let same = compare(decimal(value.text), decimal(observed.text)) == 0
    if !same && !holds {
        return Option.None
    }
    Option.Some(if inverted {
            !(same && holds)
        } else {
            same && holds
        })
}

fn selected_choice(value Expr, condition Expr, positive Bool, budget List[Int], depth Int) Result[Expr, Text] {
    if value.kind != ExprKind.If {
        return Result.Ok(value)
    }
    discard choice_step(budget, depth)?
    let guard = get(value.children, 0)
    if exact_expression(guard, condition) {
        return selected_choice(get(value.children, if positive {
                    1
                } else {
                    2
                }), condition, positive, budget, depth + 1)
    }
    if exact_expression(proof_not(guard), condition) {
        return selected_choice(get(value.children, if positive {
                    2
                } else {
                    1
                }), condition, positive, budget, depth + 1)
    }
    match selected_enum_guard(guard, condition, positive) {
        Option.Some(selected) => {
            return selected_choice(get(value.children, if selected {
                        1
                    } else {
                        2
                    }),
                condition, positive, budget, depth + 1)
        }
        Option.None => {
        }
    }
    Result.Ok(value)
}

fn lifted_operation(value Expr, children List[Expr], budget List[Int], depth Int) Result[Expr, Text] {
    discard choice_step(budget, depth)?
    let shape = proof_operation(value)
    var index = 0
    while index < length(children) {
        let child = get(children, index)
        if index == 1 && child.kind == ExprKind.If &&
        (shape.flow == OperandFlow.And || shape.flow == OperandFlow.Or) {
            // The right operand stays under its short-circuit guard.
            let and = shape.flow == OperandFlow.And
            return Result.Ok(proof_choice(get(children, 0), if and {
                        child
                    } else {
                        proof_bool(value, true)
                    },
                    if and {
                        proof_bool(value, false)
                    } else {
                        child
                    }))
        }
        if child.kind == ExprKind.If {
            let guard = get(child.children, 0)
            let yes = new[Expr]()
            let no = new[Expr]()
            var item = 0
            while item < length(children) {
                let operand = get(children, item)
                push(yes, selected_choice(operand, guard, true, budget, depth + 1)?)
                push(no, selected_choice(operand, guard, false, budget, depth + 1)?)
                item = item + 1
            }
            return Result.Ok(proof_choice(guard, lifted_operation(value, yes, budget, depth + 1)?,
                    lifted_operation(value, no, budget, depth + 1)?))
        }
        index = index + 1
    }
    if value.kind == ExprKind.Intrinsic && value.ty == 1 && length(children) == 2 &&
    (value.text == "proof_add" || value.text == "proof_sub") {
        return Result.Ok(count_binary(value, if value.text == "proof_add" {
                    "+"
                } else {
                    "-"
                },
                get(children, 0), get(children, 1)))
    }
    Result.Ok(proof_expr(value, value.kind, value.ty, value.text, value.index, children))
}

fn lifted_choices(value Expr, budget List[Int], depth Int) Result[Expr, Text] {
    discard choice_step(budget, depth)?
    let shape = proof_operation(value)
    if shape.arity < 0 {
        return Result.Err("unsupported operation in proof composition")
    }
    if shape.arity == 0 {
        return Result.Ok(value)
    }
    let children = new[Expr]()
    var index = 0
    while index < shape.arity {
        let child = lifted_choices(get(value.children, index), budget, depth + 1)?
        push(children, if quantified_expression(value) && index == 2 {
                choice_predicate(child, budget, depth + 1)?
            } else {
                child
            })
        index = index + 1
    }
    if shape.flow == OperandFlow.Choice {
        let guard = get(children, 0)
        return lifted_choice(guard, selected_choice(get(children, 1), guard, true, budget, depth + 1)?,
            selected_choice(get(children, 2), guard, false, budget, depth + 1)?, budget, depth + 1)
    }
    lifted_operation(value, children, budget, depth + 1)
}

fn choice_predicate(value Expr, budget List[Int], depth Int) Result[Expr, Text] {
    discard choice_step(budget, depth)?
    if value.kind != ExprKind.If {
        return Result.Ok(value)
    }
    let condition = get(value.children, 0)
    let yes = choice_predicate(get(value.children, 1), budget, depth + 1)?
    let no = choice_predicate(get(value.children, 2), budget, depth + 1)?
    if is_bool(no, false) {
        return Result.Ok(proof_and(condition, yes))
    }
    if is_bool(yes, false) {
        return Result.Ok(proof_and(proof_not(condition), no))
    }
    if is_bool(no, true) {
        return Result.Ok(guarded_value(condition, yes))
    }
    if is_bool(yes, true) {
        return Result.Ok(guarded_value(proof_not(condition), no))
    }
    Result.Ok(proof_and(guarded_value(condition, yes), guarded_value(proof_not(condition), no)))
}

fn normalized_predicate(value Expr) Result[Expr, Text] {
    if value.ty != 2 || !bounded_contract(value) {
        return Result.Err("helper predicate input expansion budget exhausted")
    }
    if !has_choice(value) {
        return Result.Ok(value)
    }
    let budget = new[Int]()
    push(budget, 2048)
    let output = choice_predicate(lifted_choices(value, budget, 0)?, budget, 0)?
    if !bounded_contract(output) {
        return Result.Err("helper predicate result expansion budget exhausted")
    }
    Result.Ok(output)
}
