import std.loom.eval.validate_closed

// A cell read copies its current value, whose children use the selected input
// projection. Sequence reads observe one outer version; following mutable
// elements needs the graph mode because child writes need not change parents.
fn function_input_read(program Program, primitive Text, params List[Int], output_type Int, mode FunctionInputs) Bool {
    if length(params) == 0 {
        return false
    }
    if primitive == "cell_get" {
        return capture_cell_type(program, get(params, 0))
    }
    if mode == FunctionInputs.Projected || !entry_list_type(program, get(params, 0), 0) {
        return false
    }
    let operation = sequence_operation(primitive)
    if operation == "list_len" {
        return output_type == 1
    }
    if operation == "list_get" {
        return mode == FunctionInputs.Graph || predicate_immutable_type(program, output_type, 0)
    }
    primitive == "bytes_utf8" || primitive == "bytes_text_copy"
}

fn function_sequence_shape(shape Expr) Bool {
    shape.kind == ExprKind.Intrinsic && shape.text == "proof_sequence"
}

fn function_graph_shape(shape Expr) Bool {
    shape.kind == ExprKind.Intrinsic && shape.text == "proof_graph"
}

fn function_cell_shape(shape Expr) Bool {
    shape.kind == ExprKind.Intrinsic && shape.text == "proof_cell_value"
}

fn function_cell_snapshot(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && value.text == "proof_cell_snapshot" && length(value.children) == 1
}

fn contains_versioned_input(value Expr) Bool {
    if function_sequence_shape(value) || function_graph_shape(value) || function_cell_shape(value) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if contains_versioned_input(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    false
}

// Prepare versions only at the actual invocation boundary, after every eager
// argument has executed. A shared unprotected sequence cannot stand for all
// the observations made during a multi-read source helper.
fn function_argument_state(proof Verification, shape Expr, value Value, state State) Result[State, Text] {
    if !contains_versioned_input(shape) {
        return Result.Ok(state)
    }
    if function_cell_shape(shape) {
        var current = state
        match value {
            Value.List(identity) => {
                current = input_capture_cells(proof, shape.ty, value, current, 0)?
                if proof.shared && !stable_storage(list_state(identity, current)?) {
                    return Result.Err("capture function input is not proved interference-safe")
                }
            }
            _ => {
            }
        }
        current = function_argument_state(proof, get(shape.children, 0),
            cell_function_content(value, current)?, current)?
        if !immutable_snapshot(cell_function_argument(shape, value, current)?) {
            return Result.Err("capture function input needs a value snapshot")
        }
        return Result.Ok(current)
    }
    if function_graph_shape(shape) {
        match value {
            Value.Graph(_, _) => {
                return Result.Ok(state)
            }
            Value.List(_) => {
                if proof.shared {
                    return Result.Err("graph function input is not proved interference-safe")
                }
                if state.heap < 0 {
                    return Result.Ok(State {
                            heap = array_identity(proof)
                            ..state
                        })
                }
                return Result.Ok(state)
            }
            _ => {
                return Result.Err("graph function input needs a tracked root")
            }
        }
    }
    if function_sequence_shape(shape) {
        match value {
            Value.EntryList(_, _) => {
                return Result.Ok(state)
            }
            Value.List(identity) => {
                let extent = list_state(identity, state)?
                if proof.shared && !stable_storage(extent) {
                    return Result.Err("function input is not proved interference-safe")
                }
                return array_contents(proof, identity, state)
            }
            _ => {
                return Result.Err("function input needs a tracked sequence")
            }
        }
    }
    if shape.kind == ExprKind.Coerce {
        return function_argument_state(proof, get(shape.children, 0), value, state)
    }
    match value {
        Value.Record(fields) => {
            if shape.kind != ExprKind.Record {
                return Result.Ok(state)
            }
            var current = state
            var field = 0
            while field < length(fields) {
                current = function_argument_state(proof, get(get(shape.children, field).children, 0),
                    get(fields, field), current)?
                field = field + 1
            }
            Result.Ok(current)
        }
        Value.Sum(_, tag, payloads) => {
            if shape.kind != ExprKind.Variant {
                return Result.Ok(state)
            }
            var current = state
            var variant = 0
            while variant < length(payloads) {
                if function_payload_selected(tag, variant) {
                    let values = get(payloads, variant)
                    let shapes = get(shape.children, variant).children
                    var field = 0
                    while field < length(values) {
                        current = function_argument_state(proof, get(shapes, field), get(values, field), current)?
                        field = field + 1
                    }
                }
                variant = variant + 1
            }
            Result.Ok(current)
        }
        _ => Result.Ok(state)
    }
}

fn cell_function_content(value Value, state State) Result[Value, Text] {
    Result.Ok(match value {
            Value.List(identity) => known_element(identity, constant(integer(0)), state)?
            Value.Record(fields) => if length(fields) == 1 {
                get(fields, 0)
            } else {
                return Result.Err("capture function input needs one initialized value")
            }
            _ => {
                return Result.Err("capture function input needs a tracked cell or past snapshot")
            }
        })
}

fn cell_function_argument(shape Expr, value Value, state State) Result[Value, Text] {
    Result.Ok(Value.Record([function_argument(get(shape.children, 0), cell_function_content(value, state)?, state)?]))
}

fn sequence_function_argument(value Value, state State) Result[Value, Text] {
    match value {
        Value.EntryList(_, _) => {
            return Result.Ok(value)
        }
        Value.List(identity) => {
            let extent = list_state(identity, state)?
            if extent.contents >= 0 {
                return Result.Ok(Value.EntryList(extent.size, extent.contents))
            }
        }
        _ => {
        }
    }
    Result.Err("function input needs a known content version")
}

// Versions are proof symbols. Allocation/GC addresses and source execution
// clocks never enter an application key.
fn changed_heap(proof Verification, state State) State {
    if state.heap < 0 {
        return state
    }
    var version = array_identity(proof)
    if version == state.heap {
        version = array_identity(proof)
    }
    State {
        heap = version
        ..state
    }
}

fn graph_readonly_function(program Program, target Int) Bool {
    if target < 0 || target >= length(program.functions) {
        return false
    }
    let function = get(program.functions, target)
    if function.is_async || length(function.result_cleanup) != 0 ||
    !projected_function_inputs(program, target, [], [4096], 0, FunctionInputs.Graph) {
        return false
    }
    let arguments = new[Expr]()
    var index = 0
    while index < length(function.params) {
        push(arguments, proof_expr(function.body, ExprKind.Local, get(function.params, index), "", index, []))
        index = index + 1
    }
    match std.loom.eval.validate_closed(program,
        proof_expr(function.body, ExprKind.Call, function.result, "", target, arguments)) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

fn graph_readonly_expression(program Program, value Expr) Bool {
    if !projected_input_expression(program, value, [], [4096], 0, FunctionInputs.Graph) {
        return false
    }
    match std.loom.eval.validate_closed(program, value) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

fn graph_function_argument(value Value, state State) Result[Value, Text] {
    match value {
        Value.List(root) => if state.heap >= 0 {
            Result.Ok(Value.Graph(root, state.heap))
        } else {
            Result.Err("graph function input needs a prepared heap snapshot")
        }
        Value.Graph(_, _) => Result.Ok(value)
        _ => Result.Err("graph function input needs a tracked root")
    }
}
