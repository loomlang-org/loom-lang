test fn finite_histogram_algebra_cancels_only_identical_versions_and_prefixes() {
    let first = BagTerm {
        column = bag_column(10)
        size = variable(1)
        factor = integer(2)
    }
    let second = BagTerm {
        factor = integer(-3)
        ..first
    }
    let third = BagTerm {
        factor = integer(1)
        ..first
    }
    assert length(balanced_bag_terms([first, second, third])) == 0
    let changed = BagTerm {
        column = bag_column(11)
        ..third
    }
    assert length(balanced_bag_terms([first, second, changed])) == 2
    let prefix = BagTerm {
        size = variable(2)
        ..third
    }
    assert length(balanced_bag_terms([first, second, prefix])) == 2
    let field = BagTerm {
        column = BagColumn {
            contents = 10
            fields = [BagField {
                    path = [0, 1],
                    domain = ScalarDomain.Integer
                }]
        }
        ..third
    }
    assert length(balanced_bag_terms([first, second, field])) == 2
}
