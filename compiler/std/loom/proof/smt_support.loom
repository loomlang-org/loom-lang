import std.text.replace

record SmtSupportKey {
    value Text
    quantifiers List[SmtBinder]
}

record SmtSupportLaw {
    condition Text
    quantifiers List[SmtBinder]
}

// Every supported key has an index witness in the finite prefix. A property
// depending on that index only through one integer select therefore holds for
// every supported key. Keep the original premise, range, column and outer scope.
// SMT identifiers/literals are controlled by the encoder; replace a complete
// select term and reject any remaining occurrence of its bound index.
fn smt_support(writer SmtWriter, identity Int, start Linear, end Linear,
    condition Text, premise Text) Result[Bool, Text] {
    if !writer.extended || length(writer.counts) == 0 || length(start.terms) != 0 || compare(start.constant, integer(0)) != 0 || order_mentions(end, identity) {
        return Result.Ok(true)
    }
    var scope = 0
    while scope < length(writer.quantifiers) {
        if get(writer.quantifiers, scope).identity == identity {
            return Result.Ok(true)
        }
        scope = scope + 1
    }
    let name = concat("n", std.int.to_text(identity))
    let position = smt_linear(writer, variable(identity))?
    var index = 0
    while index < length(writer.columns) {
        discard smt_step(writer, 0)?
        let column = get(writer.columns, index)
        if column.domain == ScalarDomain.Integer {
            let array = smt_array(writer, column.identity, column.path)
            let selected = concat("(select ", concat(array, concat(" ", concat(position, ")"))))
            let property = std.text.replace(condition, selected, "loom_support_key")
            if property != condition && !smt_mentions(property, name) {
                let bag = smt_bag(writer, array, end)?
                let count = concat("(select ", concat(bag, " loom_support_key)"))
                let supported = smt_boolean_pair(">", count, "0")
                let implication = smt_boolean_pair("=>", supported, property)
                push(writer.support_laws, SmtSupportLaw {
                        condition = smt_boolean_pair("=>", premise, implication)
                        quantifiers = writer.quantifiers
                    })
                return Result.Ok(true)
            }
        }
        index = index + 1
    }
    Result.Ok(true)
}

fn smt_count_presence(writer SmtWriter, identity Int, size Linear,
    needle Text, count Text) Result[Bool, Text] {
    if !writer.extended {
        return Result.Ok(true)
    }
    discard smt_step(writer, 0)?
    push(writer.support_keys, SmtSupportKey {
            value = needle
            quantifiers = writer.quantifiers
        })
    // A matching in-prefix index witnesses a positive count. This supplies no
    // source access/evaluation fact, nor a witness merely from seeing a term.
    let end = smt_linear(writer, size)?
    let value = needle
    let array = smt_array(writer, identity, [])
    let index = "loom_occurrence_index"
    let selected = concat("(select ", concat(array, concat(" ", concat(index, ")"))))
    let lower = smt_boolean_pair("<=", "0", index)
    let upper = smt_boolean_pair("<", index, end)
    let member = smt_boolean_pair("=", selected, value)
    let bounded = smt_boolean_pair("and", lower, upper)
    let witness = smt_boolean_pair("and", bounded, member)
    let consequence = smt_boolean_pair(">", count, "0")
    let implication = smt_boolean_pair("=>", witness, consequence)
    let law = concat("(forall ((loom_occurrence_index Int)) ", concat(implication, ")"))
    smt_support_scope(writer, law)
    Result.Ok(true)
}

fn smt_support_scope(writer SmtWriter, original Text) {
    var law = original
    var scope = length(writer.quantifiers)
    while scope > 0 {
        scope = scope - 1
        law = smt_binder(get(writer.quantifiers, scope), law)
    }
    smt_assert(writer, law)
}

// Instantiate the universal support law at actual count keys. An unrestricted
// key quantifier creates unbounded model search for false candidate invariants.
// This remains the same finite-support theorem; no candidate supplies a premise.
fn smt_support_instances(writer SmtWriter) Result[Bool, Text] {
    var law_index = 0
    while law_index < length(writer.support_laws) {
        let law = get(writer.support_laws, law_index)
        var key_index = 0
        while key_index < length(writer.support_keys) {
            discard smt_step(writer, 0)?
            let key = get(writer.support_keys, key_index)
            if support_scopes_match(law.quantifiers, key.quantifiers) &&
            support_no_capture(law, key) {
                var condition = std.text.replace(law.condition, "loom_support_key", key.value)
                let binders = if length(law.quantifiers) >= length(key.quantifiers) {
                    law.quantifiers
                } else {
                    key.quantifiers
                }
                var scope = length(binders)
                while scope > 0 {
                    scope = scope - 1
                    condition = smt_binder(get(binders, scope), condition)
                }
                smt_assert(writer, condition)
            }
            key_index = key_index + 1
        }
        law_index = law_index + 1
    }
    Result.Ok(true)
}

// One scope must extend the other lexical path. Equal numeric identities in
// unrelated ranges must never capture a key or change the original premise.
fn support_scopes_match(first List[SmtBinder], second List[SmtBinder]) Bool {
    var index = 0
    while index < length(first) && index < length(second) {
        let left = get(first, index)
        let right = get(second, index)
        if left.identity != right.identity || left.start != right.start || left.end != right.end {
            return false
        }
        index = index + 1
    }
    true
}

fn support_no_capture(law SmtSupportLaw, key SmtSupportKey) Bool {
    let binders = if length(law.quantifiers) >= length(key.quantifiers) {
        law.quantifiers
    } else {
        key.quantifiers
    }
    let value = if length(law.quantifiers) >= length(key.quantifiers) {
        key.value
    } else {
        law.condition
    }
    var index = if length(law.quantifiers) < length(key.quantifiers) {
        length(law.quantifiers)
    } else {
        length(key.quantifiers)
    }
    while index < length(binders) {
        let name = concat("n", std.int.to_text(get(binders, index).identity))
        if smt_mentions(value, name) {
            return false
        }
        index = index + 1
    }
    true
}
