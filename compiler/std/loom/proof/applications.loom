import std.loom.eval.validate_closed

fn predicate_application(value Expr) Bool {
    value.kind == ExprKind.Intrinsic &&
    (value.text == "proof_function" || value.text == "proof_function_defined")
}

fn proof_logical(value Expr) Expr {
    proof_expr(value, ExprKind.Intrinsic, value.ty, "proof_logical", -1, [value])
}

fn logical_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && length(value.children) == 1 &&
    (value.text == "proof_logical" || value.text == "proof_defined")
}

// A mathematical safety formula for one operation. Operand evaluation paths
// are retained independently by expansion; this does not execute the operand.
fn operation_safety(value Expr, state State) Result[Predicate, Text] {
    match defined(value, state) {
        Result.Ok(_) => {
            return Result.Ok(Predicate.Constant(true))
        }
        Result.Err(_) => {
        }
    }
    if predicate_application(value) {
        return application_fact(value, state, true)
    }
    if enum_payload_expression(value) {
        return enum_payload_guard(value, state)
    }
    if proof_operation(value).total {
        return Result.Ok(Predicate.Constant(true))
    }
    if value.kind == ExprKind.Unary || value.kind == ExprKind.Binary {
        let guard = arithmetic_guard(value, state)?
        if holds(not(guard), state.facts) {
            return Result.Ok(Predicate.Constant(false))
        }
        let term = integer_term(pure(value, state)?)?
        return Result.Ok(Predicate.And([guard, Predicate.And([
                            integer_limit(">=", term, -9223372036854775808),
                            integer_limit("<=", term, 9223372036854775807)])]))
    }
    if value.text == "text_byte" {
        return text_byte_guard(pure(get(value.children, 0), state)?, pure(get(value.children, 1), state)?)
    }
    if value.text == "text_slice" {
        return text_slice_guard(pure(get(value.children, 0), state)?,
            pure(get(value.children, 1), state)?, pure(get(value.children, 2), state)?)
    }
    if value.text == "text_concat" {
        let size = match pure(value, state)? {
            Value.Text(text) => text_length(text)
            _ => {
                return Result.Err("Text safety needs an immutable value")
            }
        }
        return Result.Ok(Predicate.And([integer_limit(">=", size, 0),
                    integer_limit("<=", size, 9223372036854775807)]))
    }
    if list_read_expression(value) {
        let size = list_value_extent(pure(get(value.children, 0), state)?, state)?
        let index = list_value_index(pure(get(value.children, 1), state)?)?
        return Result.Ok(Predicate.And([Predicate.Compare(">=", index),
                    Predicate.Compare("<", add(index, scale(size, integer(-1))))]))
    }
    Result.Err("unsupported operation safety formula")
}

fn predicate_domain(value Expr) Expr {
    proof_expr(value, ExprKind.Intrinsic, 2, "proof_function_defined", value.index, value.children)
}

fn mentions_application(value Expr, target Int) Bool {
    if predicate_application(value) && value.index == target {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if mentions_application(get(value.children, index), target) {
            return true
        }
        index = index + 1
    }
    false
}

fn contains_application(value Expr) Bool {
    if predicate_application(value) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if contains_application(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn application_needed(proof Verification, target Int) Bool {
    application_identity_needed(proof, function_identity(proof.program, target))
}

fn application_identity_needed(proof Verification, identity Int) Bool {
    let groups = [proof.function.preconditions, proof.function.postconditions, proof.preservation]
    var group = 0
    while group < length(groups) {
        let clauses = get(groups, group)
        var index = 0
        while index < length(clauses) {
            if mentions_application(get(clauses, index), identity) {
                return true
            }
            index = index + 1
        }
        group = group + 1
    }
    // Expanded type guarantees can request a helper result even when the
    // postcondition only mentions a scalar result. This supplies demand, not
    // predicate truth: ordinary typed-entry and storage-version rules still
    // have to establish the actual facts.
    var ty = 0
    while ty < length(proof.program.types) {
        let clauses = get(proof.program.types, ty).constraint
        var index = 0
        while index < length(clauses) {
            if mentions_application(get(clauses, index), identity) {
                return true
            }
            index = index + 1
        }
        ty = ty + 1
    }
    false
}

// Finite forwarding may expose another function's result. Keep that requested
// result abstraction instead of replacing it with an unrelated body inference.
// An application's argument keys are not its result: do not inspect them here.
fn result_application_needed(proof Verification, value Expr) Bool {
    if predicate_application(value) {
        return application_identity_needed(proof, value.index)
    }
    var index = 0
    while index < length(value.children) {
        if result_application_needed(proof, get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn predicate_immutable_type(program Program, ty Int, depth Int) Bool {
    immutable_function_type(program, ty, depth, [256])
}

fn immutable_function_type(program Program, ty Int, depth Int, budget List[Int]) Bool {
    if !conjunction_step(budget) {
        return false
    }
    if scalar_type(ty) {
        return true
    }
    if depth >= 16 || ty < 0 || ty >= length(program.types) {
        return false
    }
    let shape = get(program.types, ty)
    if shape.kind == TypeKind.Enum {
        var variant = 0
        while variant < length(shape.variants) {
            let fields = get(shape.variants, variant).fields
            var field = 0
            while field < length(fields) {
                if !immutable_function_type(program, get(fields, field), depth + 1, budget) {
                    return false
                }
                field = field + 1
            }
            variant = variant + 1
        }
        return true
    }
    // Capture slots need a checked read-only footprint. Their contents must
    // also be immutable: a stable slot containing a List is still shared state.
    if shape.kind == TypeKind.Frame && !frame_input_program(program, ty) {
        return false
    }
    if shape.kind != TypeKind.Refined && shape.kind != TypeKind.Record &&
    shape.kind != TypeKind.Tuple && shape.kind != TypeKind.Frame {
        return false
    }
    var index = 0
    while index < length(shape.fields) {
        if !immutable_function_type(program, get(shape.fields, index).ty, depth + 1, budget) {
            return false
        }
        index = index + 1
    }
    true
}

fn predicate_function(program Program, target Int) Bool {
    if target < 0 || target >= length(program.functions) || function_identity(program, target) < 0 {
        return false
    }
    let function = get(program.functions, target)
    if function.is_async || !predicate_immutable_type(program, function.result, 0) || function.runtime_name != "" ||
    length(function.result_cleanup) != 0 {
        return false
    }
    let arguments = new[Expr]()
    var index = 0
    while index < length(function.params) {
        let ty = get(function.params, index)
        push(arguments, proof_expr(function.body, ExprKind.Local, ty, "", index, []))
        index = index + 1
    }
    // Mutable siblings can travel as handles only when the complete operation
    // closure cannot observe or mutate them, including in entry conditions.
    match function_input_mode(program, target) {
        Result.Err(_) => {
            return false
        }
        Result.Ok(_) => {
        }
    }
    // The validator supplies operation purity; the projection check supplies
    // isolation for every mutable part omitted from an application key.
    let call = proof_expr(function.body, ExprKind.Call, function.result, "", target, arguments)
    match std.loom.eval.validate_closed(program, call) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
}

fn function_identity(program Program, target Int) Int {
    if length(program.function_identities) == 0 {
        return target
    }
    if target < 0 || target >= length(program.function_identities) {
        return -1
    }
    get(program.function_identities, target)
}

fn predicate_keys(values List[Value], budget List[Int]) Result[List[PredicateKey], Text] {
    let output = new[PredicateKey]()
    var index = 0
    while index < length(values) {
        push(output, predicate_key(get(values, index), budget)?)
        index = index + 1
    }
    Result.Ok(output)
}

fn predicate_key(value Value, budget List[Int]) Result[PredicateKey, Text] {
    if get(budget, 0) <= 0 {
        return Result.Err("predicate argument key budget exhausted")
    }
    set(budget, 0, get(budget, 0) - 1)
    match value {
        Value.Number(term) => checked_scalar_key(PredicateKey.Integer(IntegerTerm.Linear(term)), budget)
        Value.Nonlinear(term) => checked_scalar_key(PredicateKey.Integer(term), budget)
        Value.Boolean(term) => {
            if !predicate_boolean_size(term, budget) {
                return Result.Err("predicate Boolean argument key budget exhausted")
            }
            Result.Ok(PredicateKey.Boolean([term]))
        }
        Value.Text(term) => checked_scalar_key(PredicateKey.Text(term), budget)
        Value.Float(term) => checked_scalar_key(PredicateKey.Float(term), budget)
        Value.EntryList(size, contents) => if contents >= 0 {
            Result.Ok(PredicateKey.Sequence(contents, size))
        } else {
            Result.Err("function input needs a known content version")
        }
        Value.Graph(root, heap) => Result.Ok(PredicateKey.Graph(root, heap))
        Value.Record(fields) => Result.Ok(PredicateKey.Record(predicate_keys(fields, budget)?))
        Value.Sum(ty, tag, payloads) => {
            if !integer_key_size(tag, budget) {
                return Result.Err("function enum argument key budget exhausted")
            }
            let fields = new[List[PredicateKey]]()
            let literal = match tag {
                IntegerTerm.Linear(number) => if length(number.terms) == 0 {
                    let selected = machine(number.constant)?
                    if selected < 0 || selected >= length(payloads) {
                        return Result.Err("predicate enum key has an invalid tag")
                    }
                    selected
                } else {
                    -1
                }
                _ => -1
            }
            let count = if literal >= 0 {
                literal + 1
            } else {
                length(payloads)
            }
            var index = 0
            while index < count {
                if literal >= 0 && literal != index {
                    push(fields, new[PredicateKey]())
                } else {
                    push(fields, predicate_keys(get(payloads, index), budget)?)
                }
                index = index + 1
            }
            Result.Ok(PredicateKey.Sum(ty, tag, fields))
        }
        _ => Result.Err("predicate argument has no immutable value key")
    }
}

// A Boolean argument may itself contain applications with shared subtrees.
// Charge their unfolded size before later equality/congruence traversals.
fn predicate_boolean_size(value Predicate, budget List[Int]) Bool {
    if !conjunction_step(budget) {
        return false
    }
    match value {
        Predicate.Application(value, _) => predicate_key_sizes(value.arguments, budget)
        Predicate.ValueEqual(values) => predicate_key_sizes(values, budget)
        Predicate.IntegerCompare(_, left, right) => integer_key_size(left, budget) && integer_key_size(right, budget)
        Predicate.FloatCompare(_, left, right) => float_key_size(left, budget) && float_key_size(right, budget)
        Predicate.TextEqual(left, right) => text_key_size(left, budget) && text_key_size(right, budget)
        Predicate.Not(values) => predicate_boolean_sizes(values, budget)
        Predicate.And(values) => predicate_boolean_sizes(values, budget)
        Predicate.Or(values) => predicate_boolean_sizes(values, budget)
        Predicate.Equal(values) => predicate_boolean_sizes(values, budget)
        Predicate.Forall(_, _, _, values) => predicate_boolean_sizes(values, budget)
        Predicate.ArrayRead(_, _, _, term, guards) => {
            predicate_boolean_sizes(guards, budget) && scalar_key_size(term, budget)
        }
        Predicate.ArrayWrite(_, _, _, _, term) => scalar_key_size(term, budget)
        _ => true
    }
}

fn predicate_boolean_sizes(values List[Predicate], budget List[Int]) Bool {
    var index = 0
    while index < length(values) {
        if !predicate_boolean_size(get(values, index), budget) {
            return false
        }
        index = index + 1
    }
    true
}

fn predicate_key_sizes(keys List[PredicateKey], budget List[Int]) Bool {
    var index = 0
    while index < length(keys) {
        if !conjunction_step(budget) {
            return false
        }
        let valid = match get(keys, index) {
            PredicateKey.Integer(value) => integer_key_size(value, budget)
            PredicateKey.Text(value) => text_key_size(value, budget)
            PredicateKey.Float(value) => float_key_size(value, budget)
            PredicateKey.Sequence(_, _) => true
            PredicateKey.Graph(_, _) => true
            PredicateKey.Boolean(values) => predicate_boolean_sizes(values, budget)
            PredicateKey.Record(fields) => predicate_key_sizes(fields, budget)
            PredicateKey.Sum(_, tag, variants) => {
                var variant = 0
                var valid = integer_key_size(tag, budget)
                while variant < length(variants) && valid {
                    valid = predicate_key_sizes(get(variants, variant), budget)
                    variant = variant + 1
                }
                valid
            }
        }
        if !valid {
            return false
        }
        index = index + 1
    }
    true
}

fn application_fact(value Expr, state State, domain Bool) Result[Predicate, Text] {
    Result.Ok(Predicate.Application(function_inputs(value, pure(get(value.children, 0), state)?)?, domain))
}

fn same_predicate_keys(left List[PredicateKey], right List[PredicateKey]) Bool {
    if length(left) != length(right) {
        return false
    }
    var index = 0
    while index < length(left) {
        if !same_predicate_key(get(left, index), get(right, index)) {
            return false
        }
        index = index + 1
    }
    true
}

fn same_predicate_key(left PredicateKey, right PredicateKey) Bool {
    match left {
        PredicateKey.Integer(value) => match right {
            PredicateKey.Integer(other) => same_integer_term(value, other, [1024])
            _ => false
        }
        PredicateKey.Boolean(value) => match right {
            PredicateKey.Boolean(other) => same_predicates(value, other)
            _ => false
        }
        PredicateKey.Text(value) => match right {
            PredicateKey.Text(other) => same_text(value, other)
            _ => false
        }
        PredicateKey.Float(value) => match right {
            PredicateKey.Float(other) => same_float(value, other, [256])
            _ => false
        }
        PredicateKey.Record(value) => match right {
            PredicateKey.Record(other) => same_predicate_keys(value, other)
            _ => false
        }
        PredicateKey.Sequence(contents, size) => match right {
            PredicateKey.Sequence(other, extent) => contents == other && compare(size.constant, extent.constant) == 0 && same_terms(size.terms, extent.terms)
            _ => false
        }
        PredicateKey.Graph(root, heap) => match right {
            PredicateKey.Graph(other, version) => root == other && heap == version
            _ => false
        }
        PredicateKey.Sum(ty, tag, fields) => match right {
            PredicateKey.Sum(other, selected, values) => {
                if ty != other || !same_integer_term(tag, selected, [1024]) || length(fields) != length(values) {
                    return false
                }
                var index = 0
                while index < length(fields) {
                    if !same_predicate_keys(get(fields, index), get(values, index)) {
                        return false
                    }
                    index = index + 1
                }
                true
            }
            _ => false
        }
    }
}
