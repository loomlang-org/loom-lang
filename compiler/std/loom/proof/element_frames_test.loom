fn element_frame_program() Program {
    let types = new[Type]()
    var index = 0
    while index < 6 {
        push(types, publication_shape(TypeKind.Int, []))
        index = index + 1
    }
    push(types, Type {
            fields = [Field {
                    name = "children"
                    ty = 7
                }]
            ..publication_shape(TypeKind.Record, [])
        })
    push(types, publication_shape(TypeKind.List, [6]))
    proof_program_with_types(types)
}

fn element_frame_state() State {
    with_extent(20, constant(integer(0)), true,
        with_extent(10, constant(integer(0)), true, State {
                heap = -1
                locals = [Value.List(10), Value.List(20), Value.Empty]
                facts = []
                extents = []
                observations = []
            }))
}

fn element_frames_distinguish_roots_and_widen_cycles() Result[Bool, Text] {
    let proof = verification(contract_fixture([7, 7], 0,
            expression(ExprKind.Block, 0, "", -1, []), [], []), element_frame_program())
    set(proof.fresh, 0, 100)
    var state = element_frame_state()
    assert list_element_frame(list_state(10, state)?, list_state(10, state)?)
    assert !list_graph_frame(list_state(10, state)?, list_state(10, state)?)
    // A child exclusion supplies no separation between symbolic root handles.
    let alias = separate_elements(30, 10, with_extent(30, variable(40), false, state))
    assert list_element_frame(list_state(30, alias)?, list_state(10, alias)?)
    assert extent_overlap(list_state(30, alias)?, list_state(10, alias)?)
    assert !list_state(10, published_inputs(proof, [7], [Value.List(30)], 0, alias))?.private_storage
    let child = Value.Record([Value.List(20)])
    state = stored_graph(proof, 10, 6, child, state)
    state = remember_element(10, constant(integer(0)), child,
        with_extent(10, constant(integer(1)), true, state))?
    assert list_element_frame(list_state(10, state)?, list_state(10, state)?)
    assert !list_element_frame(list_state(10, state)?, list_state(20, state)?)
    // A store into the child creates 10 -> 20 -> 10. Both the receiver and
    // its possible ancestor lose the corresponding element exclusions.
    let parent = Value.Record([Value.List(10)])
    state = stored_graph(proof, 20, 6, parent, state)
    state = remember_element(20, constant(integer(0)), parent,
        with_extent(20, constant(integer(1)), true, state))?
    assert !list_element_frame(list_state(10, state)?, list_state(10, state)?)
    assert !list_element_frame(list_state(20, state)?, list_state(20, state)?)
    let exposed = published_inputs(proof, [6], [child], 0, state)
    assert !list_state(10, exposed)?.private_storage
    assert !list_state(20, exposed)?.private_storage
    Result.Ok(true)
}

test fn element_exclusions_do_not_separate_roots_or_survive_new_cycles() {
    assert match element_frames_distinguish_roots_and_widen_cycles() {
        Result.Ok(valid) => valid
        Result.Err(_) => false
    }
}

fn unavailable_element_frame_does_not_make_a_loop_vacuous() Result[Bool, Text] {
    let proof = verification(contract_fixture([7, 7], 0,
            expression(ExprKind.Block, 0, "", -1, []), [], []), element_frame_program())
    let candidate = LoopCandidate.ElementFrame(0, [], 1, [])
    let state = element_frame_state()
    let available = loop_candidate_views(proof, [candidate], state)
    assert length(available.candidates) == 1
    let unavailable = loop_candidate_views(proof, [candidate], published_storage(state, [20]))
    assert length(unavailable.candidates) == 0
    assert !holds(Predicate.Constant(false), unavailable.state.facts)
    let unknown = with_extent(30, variable(40), false,
        assigned(state, 1, Value.List(30)))
    let changed = loop_candidate_views(proof, [candidate], unknown)
    assert length(changed.candidates) == 0
    assert !holds(Predicate.Constant(false), changed.state.facts)
    Result.Ok(true)
}

test fn element_frame_views_require_current_private_allocation_premises() {
    assert match unavailable_element_frame_does_not_make_a_loop_vacuous() {
        Result.Ok(valid) => valid
        Result.Err(_) => false
    }
}
