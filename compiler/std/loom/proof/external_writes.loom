// These synchronous primitives affect an external stream, never Loom storage.
// Keep them out of the pure expression algebra: equal inputs need not produce
// equal results, and a normal-return summary cannot remove their execution.
fn external_write(function Function, call Expr) Bool {
    if function.is_async || function.result != 1 || length(function.params) != 3 ||
    length(call.children) != 3 || get(function.params, 0) != 1 || get(function.params, 2) != 1 {
        return false
    }
    (function.runtime_name == "write" && get(function.params, 1) == 3) ||
    (function.runtime_name == "write_bytes" && get(function.params, 1) == 4)
}

fn execute_external_write(proof Verification, call Expr, state State, depth Int) Result[List[Outcome], Text] {
    let inputs = call_arguments(proof, call, state, depth)?
    let output = new[Outcome]()
    var index = 0
    while index < length(inputs) {
        let input = get(inputs, index)
        let value = fresh_result(proof, 1)
        discard add_outcome(output, Outcome {
                // A blocking write gives other workers time to change shared
                // storage. Private/readonly frames use the existing rules.
                state = bounded(value, interference(proof, input.state))
                value = value
            })?
        index = index + 1
    }
    Result.Ok(output)
}
