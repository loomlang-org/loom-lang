test fn enum_count_columns_retain_nested_selectors_and_refuse_dynamic_indices() {
    let values = expression(ExprKind.Local, 10, "", 0, [])
    let bound = expression(ExprKind.Intrinsic, 1, "proof_bound", -3, [])
    let element = expression(ExprKind.Intrinsic, 9, "list_get", -1, [values, bound])
    let field = expression(ExprKind.Field, 8, "", 1, [element])
    let tag = expression(ExprKind.Intrinsic, 1, "proof_enum_tag", -1, [field])
    let payload = expression(ExprKind.Intrinsic, 7, "proof_enum_payload", -1,
        [field, literal("1"), literal("2")])
    let nested = expression(ExprKind.Field, 2, "", 1, [payload])
    assert counted_element(tag, -3) && counted_element(nested, -3)
    assert same_projection(count_read_path(tag), [1, -1])
    assert same_projection(count_read_path(nested), [1, -2, 1, 2, 1])
    assert !counted_element(nested, -4)
    let dynamic = expression(ExprKind.Intrinsic, 1, "proof_enum_payload", -1,
        [field, local(1), literal("0")])
    let negative = expression(ExprKind.Intrinsic, 1, "proof_enum_payload", -1,
        [field, literal("-1"), literal("0")])
    assert !counted_element(dynamic, -3) && !counted_element(negative, -3)
    let overflow = expression(ExprKind.Intrinsic, 1, "proof_enum_payload", -1,
        [field, literal("9223372036854775808"), literal("0")])
    assert !counted_element(overflow, -3)
}

test fn enum_count_columns_validate_nominal_paths_without_admitting_mutable_or_float_keys() {
    let program = atomic_pair_program()
    // Reuse the existing first six scalar IDs and List[Int] at ID 6.
    std.list.set(program.types, 7, Type {
            fields = [Field {
                    name = "number"
                    ty = 1
                }, Field {
                    name = "flag"
                    ty = 2
                }]
            ..publication_shape(TypeKind.Tuple, [])
        })
    push(program.types, Type {
            variants = [Variant {
                    name = "Flag"
                    fields = [2]
                }, Variant {
                    name = "Empty"
                    fields = []
                }]
            ..publication_shape(TypeKind.Enum, [])
        })
    push(program.types, Type {
            variants = [Variant {
                    name = "Empty"
                    fields = []
                }, Variant {
                    name = "Payload"
                    fields = [1, 3, 7, 8, 6, 5]
                }]
            ..publication_shape(TypeKind.Enum, [])
        })
    push(program.types, Type {
            fields = [Field {
                    name = "key"
                    ty = 1
                }, Field {
                    name = "signal"
                    ty = 9
                }]
            ..publication_shape(TypeKind.Record, [])
        })
    push(program.types, publication_shape(TypeKind.List, [10]))
    let paths = [[1, -1], [1, -2, 1, 0], [1, -2, 1, 1], [1, -2, 1, 2, 1],
        [1, -2, 1, 3, -1], [1, -2, 1, 3, -2, 0, 0]]
    let domains = [ScalarDomain.Integer, ScalarDomain.Integer, ScalarDomain.Text,
        ScalarDomain.Boolean, ScalarDomain.Integer, ScalarDomain.Boolean]
    var index = 0
    while index < length(paths) {
        assert histogram_list_column(program, 11, [BagField {
                    path = get(paths, index)
                    domain = get(domains, index)
                }])
        index = index + 1
    }
    let invalid = [[1, -1, 0], [1, -2], [1, -2, 1], [1, -2, -1, 0], [1, -2, 2, 0],
        [1, -2, 0, 0], [1, -2, 1, 6], [1, -2, 1, 4], [1, -2, 1, 4, 0], [1, -2, 1, 5], [-1]]
    index = 0
    while index < length(invalid) {
        assert !histogram_list_column(program, 11, [BagField {
                    path = get(invalid, index)
                    domain = ScalarDomain.Integer
                }])
        index = index + 1
    }
    assert !histogram_list_column(program, 11, [BagField {
                path = [1, -1]
                domain = ScalarDomain.Boolean
            }])
}

test fn enum_count_unions_share_finite_algebra_and_keep_column_identity() {
    let program = atomic_pair_program()
    let context = Expansion {
        program = program
        list_lengths = true
        budget = [4096]
        active = []
        checks = []
        observations = []
        origins = []
        binders = []
    }
    let values = expression(ExprKind.Local, 6, "", 0, [])
    let bound = expression(ExprKind.Intrinsic, 1, "proof_bound", -3, [])
    let read = expression(ExprKind.Intrinsic, 1, "list_get", -1, [values, bound])
    let size = expression(ExprKind.Intrinsic, 1, "list_len", -1, [values])
    let first = operation("==", read, literal("0"))
    let second = operation("==", read, literal("1"))
    let ordinary = match count_formula(context, first, [operation("||", first, second)], size, -3, 0) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let guarded = match count_formula(context, first,
        [proof_not(proof_and(proof_not(first), proof_not(second)))], size, -3, 0) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert exact_expression(ordinary, guarded)
    assert match count_formula(context, first, [first, second], size, -3, 0) {
        Result.Ok(value) => value.kind == ExprKind.Integer && value.text == "0"
        Result.Err(_) => false
    }
    let column = BagField {
        path = [-1]
        domain = ScalarDomain.Integer
    }
    assert conflicting_count_fields([column, column], [literal("0"), literal("1")])
    assert !conflicting_count_fields([column, column], [literal("0"), literal("00")])
    assert !conflicting_count_fields([column, BagField {
                path = [0, -1]
                domain = ScalarDomain.Integer
            }], [literal("0"), literal("1")])
    let other = expression(ExprKind.Intrinsic, 1, "list_get", -1,
        [expression(ExprKind.Local, 6, "", 1, []), bound])
    assert match count_formula(context, first, [first, operation("==", other, literal("1"))], size, -3, 0) {
        Result.Err(_) => true
        Result.Ok(_) => false
    }
}

test fn enum_count_complements_cancel_only_identical_mathematical_bases() {
    let first = local(0)
    let second = local(1)
    let third = local(2)
    let fourth = local(3)
    let removed = count_binary(first, "-", count_binary(first, "-",
            count_binary(first, "-", first, second), third), fourth)
    let actual = count_binary(first, "-", first, removed)
    let expected = count_binary(first, "+", count_binary(first, "+", second, third), fourth)
    assert exact_expression(actual, expected)
    assert count_zero(count_binary(first, "-", first, first))
    assert !count_zero(count_binary(first, "-", first, second))
    assert exact_expression(count_binary(first, "+", literal("0"), first), first)
    assert exact_expression(count_binary(first, "-", first, literal("00")), first)
}

fn enum_count_guard(snapshot Int, read Int, tag Text) Expr {
    let values = expression(ExprKind.Local, 10, "", 0, [])
    let captured = expression(ExprKind.Intrinsic, 10, "entry_list", snapshot, [values])
    let element = expression(ExprKind.Intrinsic, 9, "list_get", read,
        [captured, expression(ExprKind.Intrinsic, 1, "proof_bound", -3, [])])
    let field = expression(ExprKind.Field, 8, "", 1, [element])
    operation("==", expression(ExprKind.Intrinsic, 1, "proof_enum_tag", -1, [field]), literal(tag))
}

fn enum_count_selected(value Expr, guard Expr, positive Bool) Expr {
    match selected_choice(value, guard, positive, [2048], 0) {
        Result.Ok(selected) => selected
        Result.Err(_) => {
            assert false
            value
        }
    }
}

test fn enum_count_choices_correlate_one_entry_projection_without_observation_identity_shortcuts() {
    let first = enum_count_guard(30, 40, "0")
    let repeated = enum_count_guard(30, 41, "0")
    let different = enum_count_guard(30, 42, "1")
    assert !exact_expression(first, repeated)
    let selected = proof_choice(repeated, literal("10"), literal("20"))
    assert exact_expression(enum_count_selected(selected, first, true), literal("10"))
    assert exact_expression(enum_count_selected(selected, first, false), literal("20"))
    assert exact_expression(enum_count_selected(selected, proof_not(first), false), literal("10"))
    let alternative = proof_choice(different, literal("10"), literal("20"))
    assert exact_expression(enum_count_selected(alternative, first, true), literal("20"))
    assert enum_count_selected(alternative, first, false).kind == ExprKind.If
    let reversed = operation("==", literal("00"), get(repeated.children, 0))
    assert exact_expression(enum_count_selected(proof_choice(reversed, literal("10"), literal("20")),
            first, true), literal("10"))
    assert exact_expression(enum_count_selected(proof_choice(proof_not(repeated), literal("10"), literal("20")),
            first, true), literal("20"))
    let other_snapshot = proof_choice(enum_count_guard(31, 41, "0"), literal("10"), literal("20"))
    assert enum_count_selected(other_snapshot, first, true).kind == ExprKind.If
}

test fn enum_count_choices_keep_independent_current_and_mutable_child_reads_distinct() {
    let first = enum_count_guard(30, 40, "0")
    let receiver = get(get(first.children, 0).children, 0)
    let values = expression(ExprKind.Local, 10, "", 0, [])
    let cursor = expression(ExprKind.Intrinsic, 1, "proof_bound", -3, [])
    let current = expression(ExprKind.Intrinsic, 9, "list_get", 50, [values, cursor])
    let next = Expr {
        index = 51
        ..current
    }
    let first_current = operation("==", expression(ExprKind.Intrinsic, 1, "proof_enum_tag", -1, [current]), literal("0"))
    let next_current = operation("==", expression(ExprKind.Intrinsic, 1, "proof_enum_tag", -1, [next]), literal("0"))
    assert enum_count_selected(proof_choice(next_current, literal("10"), literal("20")),
        first_current, true).kind == ExprKind.If
    let shared = expression(ExprKind.Intrinsic, 11, "proof_enum_payload", -1,
        [receiver, literal("1"), literal("0")])
    let child = expression(ExprKind.Intrinsic, 8, "list_get", 60, [shared, literal("0")])
    let changed = Expr {
        index = 61
        ..child
    }
    let first_child = operation("==", expression(ExprKind.Intrinsic, 1, "proof_enum_tag", -1, [child]), literal("0"))
    let next_child = operation("==", expression(ExprKind.Intrinsic, 1, "proof_enum_tag", -1, [changed]), literal("0"))
    assert enum_count_selected(proof_choice(next_child, literal("10"), literal("20")),
        first_child, true).kind == ExprKind.If
}
