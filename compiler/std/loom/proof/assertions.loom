// Evidence about the actual root body's assertions. A false entry also matters:
// a later path or a weaker induction pass must veto earlier successful evidence.
pub record AssertionCheck {
    expression Expr
    proved Bool
}

pub record ContractProof {
    postconditions List[Expr]
    assertions List[AssertionCheck]
}

fn observe_assertion(proof Verification, expression Expr, state State) {
    match proof.assertions {
        Option.Some(checks) => {
            push(checks, AssertionCheck {
                    expression = expression
                    proved = assertion_proved(proof, get(expression.children, 0), state)
                })
        }
        Option.None => {
        }
    }
}

// Check the incoming state, before evaluating the source operand. A successful
// call/read may otherwise have already supplied the very safety facts at issue.
fn assertion_proved(proof Verification, source Expr, state State) Bool {
    // Candidate expansion may use a callee's exact return summary. Such a
    // summary grants no permission to remove the call's effects or mutations
    // in an eagerly evaluated caller argument.
    if assertion_local_write(source) || !graph_readonly_expression(proof.program, source) {
        return false
    }
    // Use the ordinary contract expander's complete evaluation obligations,
    // including discarded arguments, partial calls and helper assertions.
    // An invariant suggestion alone does not certify removing source execution.
    let clauses = match contract_predicates(proof.program, proof.function.locals,
        [source], false, [256], new[Int](), new[ObservationOrigin](), proof.fresh) {
        Result.Ok(values) => values
        Result.Err(_) => {
            return false
        }
    }
    var current = state
    let query = proof_query(proof.query.backend)
    var queued = false
    var index = 0
    while index < length(clauses) {
        let expression = get(clauses, index)
        if !bounded_contract(expression) || !observation_guard_expression(expression, true) {
            return false
        }
        current = match loop_guard_views(proof, expression, current) {
            Result.Ok(value) => value
            Result.Err(_) => {
                return false
            }
        }
        let fact = match pure(expression, current) {
            Result.Ok(Value.Boolean(value)) => value
            _ => {
                return false
            }
        }
        let cheap = match defined(expression, current) {
            Result.Ok(valid) => valid && loop_holds(fact, current)
            Result.Err(_) => false
        }
        if !cheap {
            if !proof.query.backend.enabled {
                return false
            }
            // Optional evidence owns its query; no conclusion is assumed while
            // proving later obligations or added to the required proof's state.
            match solver_defined(query, expression, current, 256) {
                Result.Ok(_) => {
                    solver_fact(query, fact, current)
                    queued = true
                }
                Result.Err(_) => {
                    return false
                }
            }
        }
        index = index + 1
    }
    if !queued {
        return true
    }
    match discharge(query) {
        Result.Ok(proved) => proved
        Result.Err(_) => false
    }
}

fn assertion_local_write(value Expr) Bool {
    if value.kind == ExprKind.Assign {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if assertion_local_write(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if assertion_local_write(get(body, item)) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

// Compiler-host entry point. Callee guarantees must already be checked, as for
// verify_with_helpers. This reports evidence; it never rewrites the source body.
pub fn prove_contract(program Program, function Function, backend ProofBackend,
    shared Bool, protected List[InputGuarantee]) Result[ContractProof, Text] {
    let ordinary = contract_verification(program, function, backend, shared)?
    proved_contract(ordinary, protected)
}

fn proved_contract(ordinary Verification, protected List[InputGuarantee]) Result[ContractProof, Text] {
    let checks = new[AssertionCheck]()
    let proof = Verification {
        assertions = Option.Some(checks)
        ..ordinary
    }
    if length(proof.function.postconditions) != 0 {
        match verify_body(proof, protected) {
            Result.Ok(_) => {
            }
            Result.Err(message) => {
                return Result.Err(if proof.shared {
                        concat("required shared-state proof is not interference-safe: ", message)
                    } else {
                        message
                    })
            }
        }
    }
    Result.Ok(ContractProof {
            postconditions = proof.function.postconditions
            assertions = checks
        })
}

pub fn prove_contract(types List[Type], function Function, backend ProofBackend,
    shared Bool, protected List[InputGuarantee]) Result[ContractProof, Text] {
    let ordinary = verification(function, proof_program_with_types(types), backend)
    proved_contract(Verification {
            shared = shared
            ..ordinary
        }, protected)
}
