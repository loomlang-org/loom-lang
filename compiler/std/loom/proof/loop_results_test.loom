test fn return_paths_only_propose_clauses_and_preserve_real_result_bindings() {
    let program = empty_proof_program()
    let goal = operation("==", local(1), local(0))
    let tail = expression(ExprKind.Return, 0, "", -1, nodes(local(0)))
    let function = fixture(tail, new[Expr](), goal)
    let clauses = loop_postconditions(verification(function, program))
    assert exact_expression(get(clauses, 0), operation("==", local(0), local(0)))
    assert exact_expression(get(function.postconditions, 0), goal)
    let field = expression(ExprKind.Field, 1, "", 2, nodes(local(0)))
    let aggregate = fixture(field, new[Expr](), goal)
    assert exact_expression(get(loop_postconditions(verification(aggregate, program)), 0), operation("==", field, local(0)))
    let computed = fixture(operation("+", local(0), literal("1")), new[Expr](), goal)
    assert exact_expression(get(loop_postconditions(verification(computed, program)), 0), goal)
    let choice = expression(ExprKind.If, 1, "", -1,
        [expression(ExprKind.Bool, 2, "true", -1, []), local(0), literal("1")])
    assert exact_expression(get(loop_postconditions(verification(fixture(choice, [], goal), program)), 0), operation("==", local(0), local(0)))
}

test fn nested_returns_propose_distinct_paths_without_rewriting_real_contracts() {
    let program = empty_proof_program()
    let goal = operation("==", local(1), local(0))
    let field = expression(ExprKind.Field, 1, "", 0, [local(0)])
    let returning = expression(ExprKind.Return, 0, "", -1, [field])
    let branches = Expr {
        kind = ExprKind.Match
        ty = 0
        span = local(0).span
        text = ""
        index = -1
        children = [local(0)]
        arms = [Arm {
                variant = 0
                bindings = []
                whole = -1
                body = [returning]
            }, Arm {
                variant = 1
                bindings = []
                whole = -1
                body = [returning, expression(ExprKind.Return, 0, "", -1, [local(0)])]
            }]
        falls = true
    }
    let body = expression(ExprKind.While, 0, "", -1,
        [expression(ExprKind.Bool, 2, "true", -1, []), branches])
    let function = fixture(body, [], goal)
    let clauses = loop_postconditions(verification(function, program))
    assert length(clauses) == 2
    assert exact_expression(get(clauses, 0), operation("==", field, local(0)))
    assert exact_expression(get(clauses, 1), operation("==", local(0), local(0)))
    assert exact_expression(get(function.postconditions, 0), goal)
    let choice = expression(ExprKind.If, 1, "", -1,
        [expression(ExprKind.Bool, 2, "true", -1, []), field, local(0)])
    let implicit = Expr {
        ty = 1
        arms = [Arm {
                variant = 0
                bindings = []
                whole = -1
                body = [local(3), choice]
            }, Arm {
                variant = 1
                bindings = []
                whole = -1
                body = [field]
            }]
        ..branches
    }
    let selected = loop_postconditions(verification(fixture(implicit, [], goal), program))
    assert length(selected) == 2
    assert exact_expression(get(selected, 0), get(clauses, 0))
    assert exact_expression(get(selected, 1), get(clauses, 1))
    let explicit = expression(ExprKind.Return, 0, "", -1, [choice])
    let returned = loop_postconditions(verification(fixture(explicit, [], goal), program))
    assert length(returned) == 2
    assert exact_expression(get(returned, 0), get(clauses, 0))
    assert exact_expression(get(returned, 1), get(clauses, 1))
}

test fn helper_result_paths_reuse_bounded_suggestions_not_undeclared_guarantees() {
    let goal = operation("==", local(1), local(0))
    let call = expression(ExprKind.Call, 1, "", 0, [local(0)])
    let helper = Function {
        body = expression(ExprKind.Block, 1, "", -1, [local(0)])
        postconditions = []
        ..fixture(local(0), [], goal)
    }
    let function = fixture(call, [], goal)
    let program = Program {
        functions = [helper]
        ..empty_proof_program()
    }
    let clauses = loop_postconditions(verification(function, program))
    assert exact_expression(get(clauses, 0), operation("==", local(0), local(0)))
    assert exact_expression(get(function.postconditions, 0), goal)
    let exact = Program {
        functions = [Function {
                postconditions = [goal]
                ..helper
            }]
        ..program
    }
    assert exact_expression(get(loop_postconditions(verification(function, exact)), 0), get(clauses, 0))
    let weak = Program {
        functions = [Function {
                postconditions = [operation(">=", local(1), local(0))]
                ..helper
            }]
        ..program
    }
    assert exact_expression(get(loop_postconditions(verification(function, weak)), 0), goal)
    let recursive = Program {
        functions = [Function {
                body = expression(ExprKind.Block, 1, "", -1, [call])
                ..helper
            }]
        ..program
    }
    assert exact_expression(get(loop_postconditions(verification(function, recursive)), 0), goal)
}
