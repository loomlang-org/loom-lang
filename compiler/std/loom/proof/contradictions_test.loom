test fn contradiction_search_preserves_numeric_and_structural_pairs_in_both_orders() {
    let term = add(scale(variable(10), integer(3)), scale(variable(11), integer(-2)))
    let facts = [Predicate.Compare("<", term),
        Predicate.Compare("!=", term),
        Predicate.Variable(10),
        Predicate.And([Predicate.Variable(10), Predicate.Variable(11)]),
        Predicate.IntegerCompare("==", IntegerTerm.Select(7, [], variable(10)),
            IntegerTerm.Linear(constant(integer(3))))]
    var index = 0
    while index < length(facts) {
        let fact = get(facts, index)
        assert holds(Predicate.Constant(false), [fact, not(fact)])
        assert holds(Predicate.Constant(false), [not(fact), fact])
        assert !holds(Predicate.Constant(false), [fact])
        index = index + 1
    }
    assert !holds(Predicate.Constant(false), [Predicate.Variable(10), not(Predicate.Variable(11))])
    assert holds(Predicate.Variable(12), [Predicate.Constant(false)])
}

test fn unreachable_snapshots_recheck_changed_facts_and_keep_ancestor_states() {
    let function = contract_fixture([], 0, literal("0"), [], [])
    let proof = verification(function, empty_proof_program())
    let term = variable(10)
    let state = State {
        heap = -1
        locals = []
        facts = [Predicate.Compare(">=", term), Predicate.Compare("<=", term)]
        extents = []
        observations = []
    }
    assert !unreachable(proof, state)
    assert !unreachable(proof, state)
    let conflicting = State {
        facts = [Predicate.Compare(">", term), Predicate.Compare("<=", term)]
        ..state
    }
    assert unreachable(proof, conflicting)
    assert !unreachable(proof, state)
    assert unreachable(proof, assume(state, Predicate.Constant(false)))
    assert !unreachable(proof, state)
    assert length(proof.fact_check) == 1
}

test fn unreachable_paths_use_only_proved_linear_contradictions() {
    let function = contract_fixture([], 0, literal("0"), [], [])
    let proof = verification(function, empty_proof_program())
    let width = variable(10)
    let count = variable(11)
    let middle = variable(12)
    let doubled = scale(width, integer(2))
    let state = State {
        heap = -1
        locals = []
        facts = [Predicate.Compare(">", width),
            Predicate.Compare("==", add(middle, scale(width, integer(-1)))),
            Predicate.Compare("<=", add(add(count, scale(middle, integer(-1))), scale(width, integer(-1))))]
        extents = []
        observations = []
    }
    assert !unreachable(proof, state)
    assert !loop_holds(Predicate.Constant(false), state)
    let impossible = assume(state, Predicate.Compare("<", add(doubled, scale(count, integer(-1)))))
    assert unreachable(proof, impossible)
    assert loop_holds(Predicate.Constant(false), impossible)
    assert !unreachable(proof, state)
    // Equality at the boundary remains feasible. No strict edge may be lost.
    let boundary = assume(state, Predicate.Compare("==", add(doubled, scale(count, integer(-1)))))
    assert !unreachable(proof, boundary)
    assert !loop_holds(Predicate.Constant(false), boundary)
}
