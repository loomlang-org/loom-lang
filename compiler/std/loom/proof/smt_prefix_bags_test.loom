import std.text.contains

test fn prefix_histograms_require_the_frame_and_an_included_extent() {
    let query = encoding([Obligation {
                facts = [Predicate.ArrayPrefix(10, 11, variable(1))]
                conclusion = Predicate.BagEqual(bag_column(10), variable(2), bag_column(11), variable(2))
            }])
    assert contains(query, "(=> (and loom_prefix_0 (<= 0 (+ 0 (* 1 n2))) (<= (+ 0 (* 1 n2)) (+ 0 (* 1 n1)))) (= (loom_bag a10 (+ 0 (* 1 n2))) (loom_bag a11 (+ 0 (* 1 n2)))))")
}

test fn histogram_frame_scope_unions_binders_without_arithmetic_cancellation() {
    assert bag_bound_scope("body", [variable(-7), scale(variable(-7), integer(-1)), variable(-8)]) ==
    "(forall ((n-7 Int)(n-8 Int)) body)"
    let query = encoding([Obligation {
                facts = [Predicate.Forall(-7, constant(integer(0)), constant(integer(3)),
                        [Predicate.ArrayPrefix(10, 11, variable(-7))])]
                conclusion = Predicate.Forall(-8, constant(integer(0)), constant(integer(3)),
                    [Predicate.BagEqual(bag_column(10), variable(-8), bag_column(11), variable(-8))])
            }])
    assert contains(query, "(assert (forall ((n-7 Int)(n-8 Int)) (=> (and (loom_prefix_0 n-7) (<= 0 (+ 0 (* 1 n-8))) (<= (+ 0 (* 1 n-8)) (+ 0 (* 1 n-7))))")
}

fn prefix_store_query(index Linear, size Linear) Text {
    encoding([Obligation {
                facts = [Predicate.ArrayWrite(10, 11, [], index,
                        ArrayScalar.Integer(IntegerTerm.Linear(variable(2))))]
                conclusion = Predicate.BagEqual(bag_column(10), size, bag_column(11), size)
            }])
}

test fn histogram_frontier_store_requires_the_exact_preceding_prefix_and_keeps_its_guard() {
    let cursor = variable(1)
    let end = add(cursor, constant(integer(1)))
    let appended = "(store (loom_bag a10 (+ 0 (* 1 n1))) (+ 0 (* 1 n2)) (+ (select (loom_bag a10 (+ 0 (* 1 n1))) (+ 0 (* 1 n2))) 1))"
    let query = prefix_store_query(cursor, end)
    assert contains(query, appended)
    assert contains(query, "(ite (and (<= 0 (+ 0 (* 1 n1))) (< (+ 0 (* 1 n1)) (+ 1 (* 1 n1))))")
    assert !contains(prefix_store_query(cursor, cursor), appended)
    assert !contains(prefix_store_query(variable(3), end), appended)
    let empty = prefix_store_query(constant(integer(-1)), constant(integer(0)))
    assert contains(empty, "(ite (and (<= 0 (+ (- 1))) (< (+ (- 1)) (+ 0)))")
    let bound = prefix_store_query(variable(-7), add(variable(-7), constant(integer(1))))
    assert contains(bound, "(forall ((n-7 Int)) (= (loom_bag (store a10")
}
