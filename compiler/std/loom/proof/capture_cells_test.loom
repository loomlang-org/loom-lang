fn capture_cell_program() Program {
    let types = new[Type]()
    var index = 0
    while index < 6 {
        push(types, publication_shape(TypeKind.Int, []))
        index = index + 1
    }
    push(types, Type {
            kind = TypeKind.Frame
            symbol = -1
            arguments = [1]
            pack_widths = []
            fields = [Field {
                    name = "value"
                    ty = 1
                }]
            variants = []
            constraint = []
        })
    proof_program_with_types(types)
}

test fn capture_value_snapshots_require_coherence_and_keep_past_values() {
    let proof = verification(contract_fixture([], 1, literal("0"), [], []), capture_cell_program())
    let shape = expression(ExprKind.Intrinsic, 6, "proof_cell_value", -1, [local(0)])
    let state = match remember_element(10, constant(integer(0)), Value.Number(constant(integer(7))),
        fixed_capture_cell(10, State {
                heap = -1
                locals = [Value.List(10)]
                facts = []
                extents = []
                observations = []
            })) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let snapshot = match cell_function_argument(shape, Value.List(10), state) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    let shared = Verification {
        shared = true
        ..proof
    }
    assert match function_argument_state(shared, shape, Value.List(10), state) {
        Result.Err(_) => true
        _ => false
    }
    let cell = expression(ExprKind.Local, 6, "", 0, [])
    let write = expression(ExprKind.FrameStore, 0, "", 0, [cell, literal("0")])
    let changed = match execute_cell_store(proof, write, state, 32) {
        Result.Ok(values) => get(values, 0).state
        Result.Err(_) => {
            assert false
            return
        }
    }
    let current = match cell_function_argument(shape, Value.List(10), changed) {
        Result.Ok(value) => value
        Result.Err(_) => {
            assert false
            return
        }
    }
    assert match predicate_key(snapshot, [256]) {
        Result.Ok(left) => match predicate_key(current, [256]) {
            Result.Ok(right) => !same_predicate_key(left, right)
            _ => false
        }
        _ => false
    }
    assert match function_argument_state(shared, shape, snapshot, changed) {
        Result.Ok(_) => true
        _ => false
    }
    assert match cell_function_argument(shape, snapshot, changed) {
        Result.Ok(value) => match predicate_key(snapshot, [256]) {
            Result.Ok(left) => match predicate_key(value, [256]) {
                Result.Ok(right) => same_predicate_key(left, right)
                _ => false
            }
            _ => false
        }
        _ => false
    }
    assert match function_argument_state(proof, shape, Value.Opaque(10, []), state) {
        Result.Err(_) => true
        _ => false
    }
}

test fn capture_value_snapshots_check_shared_descendants_too() {
    let program = capture_cell_program()
    push(program.types, publication_shape(TypeKind.List, [1]))
    push(program.types, Type {
            arguments = [7]
            fields = [Field {
                    name = "value"
                    ty = 7
                }]
            ..get(program.types, 6)
        })
    let proof = verification(contract_fixture([], 1, literal("0"), [], []), program)
    let shape = expression(ExprKind.Intrinsic, 8, "proof_cell_value", -1,
        [expression(ExprKind.Intrinsic, 7, "proof_sequence", -1, [])])
    let state = with_contents(20, 40, list_bounds(Value.List(20), State {
                heap = -1
                locals = []
                facts = []
                extents = []
                observations = []
            }))
    let input = Value.Record([Value.List(20)])
    assert match function_argument_state(proof, shape, input, state) {
        Result.Ok(_) => true
        _ => false
    }
    assert match function_argument_state(Verification {
            shared = true
            ..proof
        }, shape, input, state) {
        Result.Err(_) => true
        _ => false
    }
}

test fn capture_cell_stores_and_reads_share_versions_without_freezing_contents() {
    let program = capture_cell_program()
    let cell = expression(ExprKind.Local, 6, "", 0, [])
    let write = expression(ExprKind.FrameStore, 0, "", 0, [cell, literal("2")])
    let read = expression(ExprKind.Intrinsic, 1, "cell_get", -1, [cell])
    let function = contract_fixture([6], 1, expression(ExprKind.Block, 1, "", -1, [write, read]), [],
        [operation("==", local(1), literal("2"))])
    assert helpers_verified(program, function)
    assert match verify_shared(program, function, no_proof_backend()) {
        Result.Ok(_) => false
        Result.Err(_) => true
    }
    assert proof_operation(read).heap
    assert !entry_guard_expression(read)
    let proof = verification(function, program)
    let value = record_parameter_value(proof, 6, 0)
    let state = typed_value_state(proof, 6, value, State {
            heap = -1
            locals = [value]
            facts = []
            extents = []
            observations = []
        })
    let extent = get(state.extents, 0)
    assert extent.fixed_extent && !extent.read_only && !extent.private_storage
    assert compare(extent.size.constant, integer(1)) == 0 && length(extent.size.terms) == 0
}

test fn capture_cell_loops_and_call_frames_use_the_actual_write_footprint() {
    let program = capture_cell_program()
    let cell = expression(ExprKind.Local, 6, "", 0, [])
    let read = expression(ExprKind.Intrinsic, 1, "cell_get", -1, [cell])
    let write = expression(ExprKind.FrameStore, 0, "", 0, [cell, operation("+", read, literal("1"))])
    let body = expression(ExprKind.Block, 1, "", -1, [
            expression(ExprKind.While, 0, "", -1, [operation("<", read, local(1)), write]), read])
    let function = contract_fixture([6, 1], 1, body, [operation("<=", read, local(1))],
        [operation("==", local(2), local(1))])
    assert helpers_verified(program, function)
    assert extent_preserving(program, write) && !elements_preserving(program, write)
    assert match verify_shared(program, function, no_proof_backend()) {
        Result.Ok(_) => false
        Result.Err(_) => true
    }
    let setter = contract_fixture([6], 0, write, [], [])
    let state = fixed_capture_cell(10, list_bounds(Value.List(10), State {
                heap = -1
                locals = [Value.List(10)]
                facts = []
                extents = []
                observations = []
            }))
    let writes = new[ElementWrite]()
    assert frame_function(program, setter, [Value.List(10)], state, writes, [256], 0)
    assert length(writes) == 1 && get(writes, 0).identity == 10
    assert match get(writes, 0).index {
        Value.Number(index) => length(index.terms) == 0 && compare(index.constant, integer(0)) == 0
        _ => false
    }
    let modified = new[Int]()
    assert match loop_storage_writes(verification(function, program), write, state, modified, true, 64) {
        Result.Ok(_) => true
        Result.Err(_) => false
    }
    assert length(modified) == 1 && get(modified, 0) == 10
    let invalid = expression(ExprKind.FrameStore, 0, "", 1, [cell, literal("0")])
    assert !extent_preserving(program, invalid)
    let changed = expression(ExprKind.FrameStore, 0, "", 0, [cell, literal("2")])
    push(program.functions, contract_fixture([6], 0, changed, [], [proof_bool(changed, true)]))
    let stale = contract_fixture([6], 1,
        expression(ExprKind.Block, 1, "", -1, [helper_call(0, 0, [cell]), read]),
        [operation("==", read, literal("1"))], [operation("==", local(1), literal("1"))])
    assert !helpers_verified(program, stale)
}
