// A terminal access path proposes postcondition-shaped loop invariants. It does
// not identify the function result before it is evaluated: the ordinary entry,
// backedge and return checks remain authoritative, including after rebinding,
// early returns and cleanup. Conditional tails contribute their access-path
// leaves. Bounded helper expansion can suggest paths, never call guarantees.
fn loop_result_path(value Expr, result_local Int, depth Int) Option[Expr] {
    if depth <= 0 {
        return Option.None
    }
    if value.kind == ExprKind.Local && value.index != result_local {
        return Option.Some(value)
    }
    if (value.kind == ExprKind.Field || value.kind == ExprKind.Coerce) && length(value.children) == 1 {
        let receiver = get(value.children, 0)
        if receiver.kind != ExprKind.Local && receiver.kind != ExprKind.Field && receiver.kind != ExprKind.Coerce {
            return Option.None
        }
        return match loop_result_path(receiver, result_local, depth - 1) {
            Option.Some(_) => Option.Some(value)
            Option.None => Option.None
        }
    }
    Option.None
}

fn loop_replace_result(value Expr, result_local Int, replacement Expr) Expr {
    if value.kind == ExprKind.Local && value.index == result_local {
        return replacement
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, loop_replace_result(get(value.children, index), result_local, replacement))
        index = index + 1
    }
    proof_expr(value, value.kind, value.ty, value.text, value.index, children)
}

fn loop_add_result_paths(proof Verification, paths List[Expr], value Expr, budget List[Int], depth Int) {
    if depth <= 0 || length(paths) >= 16 {
        return
    }
    if value.kind == ExprKind.Block && length(value.children) != 0 {
        loop_add_result_paths(proof, paths, get(value.children, length(value.children) - 1), budget, depth - 1)
        return
    }
    if value.kind == ExprKind.Return && length(value.children) == 1 {
        loop_add_result_paths(proof, paths, get(value.children, 0), budget, depth - 1)
        return
    }
    if value.kind == ExprKind.If && length(value.children) == 3 {
        loop_add_result_paths(proof, paths, get(value.children, 1), budget, depth - 1)
        loop_add_result_paths(proof, paths, get(value.children, 2), budget, depth - 1)
        return
    }
    if value.kind == ExprKind.Match {
        var arm = 0
        while arm < length(value.arms) && length(paths) < 16 {
            let body = get(value.arms, arm).body
            if length(body) != 0 {
                loop_add_result_paths(proof, paths, get(body, length(body) - 1), budget, depth - 1)
            }
            arm = arm + 1
        }
        return
    }
    if get(budget, 0) > 0 && !loop_call_free(value) {
        // This isolated suggestion does not execute the call, satisfy its
        // requirements or import effects into the caller's proof state.
        match loop_affine_suggestion(proof, value, budget) {
            Result.Ok(hint) => {
                if !exact_expression(hint, value) {
                    loop_add_result_paths(proof, paths, hint, budget, depth - 1)
                    return
                }
            }
            Result.Err(_) => {
            }
        }
    }
    match loop_result_path(value, proof.function.result_local, depth) {
        Option.Some(path) => {
            var index = 0
            while index < length(paths) {
                if exact_expression(get(paths, index), path) {
                    return
                }
                index = index + 1
            }
            if length(paths) < 16 {
                push(paths, path)
            }
        }
        Option.None => {
        }
    }
}

fn loop_return_paths(proof Verification, value Expr, paths List[Expr], budget List[Int], depth Int) {
    if depth <= 0 || length(paths) >= 16 {
        return
    }
    if value.kind == ExprKind.Return {
        loop_add_result_paths(proof, paths, value, budget, depth)
        return
    }
    var index = 0
    while index < length(value.children) {
        loop_return_paths(proof, get(value.children, index), paths, budget, depth - 1)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            loop_return_paths(proof, get(body, item), paths, budget, depth - 1)
            item = item + 1
        }
        index = index + 1
    }
}

fn loop_postconditions(proof Verification) List[Expr] {
    let function = proof.function
    if function.result == 0 || length(function.postconditions) == 0 {
        return function.postconditions
    }
    let paths = new[Expr]()
    let budget = [256]
    loop_add_result_paths(proof, paths, function.body, budget, 256)
    loop_return_paths(proof, function.body, paths, budget, 256)
    if length(paths) == 0 {
        return function.postconditions
    }
    let clauses = new[Expr]()
    var index = 0
    while index < length(function.postconditions) {
        let value = get(function.postconditions, index)
        if scan_mentions(value, function.result_local) {
            var path = 0
            while path < length(paths) {
                push(clauses, loop_replace_result(value, function.result_local, get(paths, path)))
                path = path + 1
            }
        } else {
            push(clauses, value)
        }
        index = index + 1
    }
    clauses
}
