// Local scalar rules stay cheap. Admitted integer, quantified and IEEE obligations
// share the existing solver; theory combinations still need exact encoding.
fn loop_solver_fact(value Predicate) Bool {
    match value {
        Predicate.Application(_, _) => true
        Predicate.Forall(_, _, _, _) => true
        Predicate.BagEqual(_, _, _, _) => true
        Predicate.ArrayPrefix(_, _, _) => true
        Predicate.FloatCompare(_, _, _) => true
        Predicate.IntegerCompare(_, _, _) => true
        Predicate.And(values) => loop_solver_fact(get(values, 0)) || loop_solver_fact(get(values, 1))
        Predicate.Or(values) => loop_solver_fact(get(values, 0)) || loop_solver_fact(get(values, 1))
        Predicate.Not(values) => loop_solver_fact(get(values, 0))
        _ => false
    }
}

fn loop_entails(proof Verification, fact Predicate, state State) Bool {
    loop_entails(proof, fact, state, false)
}

fn loop_entails(proof Verification, fact Predicate, state State, extended Bool) Bool {
    if loop_holds(fact, state) {
        return true
    }
    if !proof.query.backend.enabled || (!extended && !loop_solver_fact(fact)) {
        return false
    }
    let query = proof_query(proof.query.backend)
    solver_fact(query, fact, state)
    match discharge(query, extended) {
        Result.Ok(value) => value
        Result.Err(_) => false
    }
}

fn loop_query_views(proof Verification, clauses List[Expr], state State) State {
    var current = state
    var index = 0
    while index < length(clauses) {
        match quantified_views(proof, get(clauses, index), current, false, 256) {
            Result.Ok(next) => {
                current = next
            }
            Result.Err(_) => {
                // Result/body-local paths can be unavailable at a loop head.
            }
        }
        index = index + 1
    }
    current
}

// Automatic guesses use the base theories; leading source assertions opt into
// extended search. A failed guess cannot make required verification optional.
fn propose_quantified(proof Verification, candidates List[LoopCandidate], value Expr, entry State) {
    propose_quantified(proof, candidates, value, entry, false)
}

fn propose_quantified(proof Verification, candidates List[LoopCandidate], value Expr, entry State, extended Bool) {
    if length(candidates) >= 64 {
        return
    }
    let current = match loop_guard_views(proof, value, entry) {
        Result.Ok(current) => current
        Result.Err(_) => {
            return
        }
    }
    match pure(value, current) {
        Result.Ok(observed) => match boolean(observed) {
            Result.Ok(fact) => {
                if loop_entails(proof, fact, current, extended) {
                    push(candidates, LoopCandidate.Guard(value, extended))
                }
            }
            Result.Err(_) => {
            }
        }
        Result.Err(_) => {
        }
    }
}

// Leading source assertions can suggest relations beyond the automatic affine
// rules. They supply no facts before entry and backedge validation succeeds.
// Reuse entry/backedge validation and versioned observations. The condition
// remains immutable: a body-entry observation cannot move before its effects.
fn loop_assertion_candidates(proof Verification, guard Expr, body Expr,
    candidates List[LoopCandidate], entry State) {
    if !entry_guard_expression(guard) {
        return
    }
    discard loop_assertion_prefix(proof, body, candidates, entry, 64)
}

fn loop_assertion_prefix(proof Verification, body Expr,
    candidates List[LoopCandidate], entry State, depth Int) Bool {
    if depth <= 0 || length(candidates) >= 64 {
        return false
    }
    if body.kind == ExprKind.Assert {
        let value = loop_candidate_guard(proof, get(body.children, 0))
        if !bounded_contract(value) || !observation_guard_expression(value, true) {
            return false
        }
        propose_quantified(proof, candidates, value, entry, true)
        return true
    }
    if body.kind != ExprKind.Block {
        return false
    }
    // Cleanup lowering can wrap the original body in another lexical block.
    // Traverse that prefix only; never cross an assignment or a cleanup.
    var index = 0
    while index < length(body.children) && length(candidates) < 64 {
        if !loop_assertion_prefix(proof, get(body.children, index), candidates, entry, depth - 1) {
            return false
        }
        index = index + 1
    }
    true
}

fn loop_replace_bound(value Expr, identity Int, replacement Expr) Expr {
    if bound_expression(value) && value.index == identity {
        return replacement
    }
    if quantified_expression(value) && value.index == identity {
        return value
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, loop_replace_bound(get(value.children, index), identity, replacement))
        index = index + 1
    }
    proof_expr(value, value.kind, value.ty, value.text, value.index, children)
}

fn loop_relation_boundary(value Expr, identity Int, replacement Expr, side Int) Option[Expr] {
    if value.kind == ExprKind.Unary && value.text == "!" {
        return match loop_relation_boundary(get(value.children, 0), identity, replacement, side) {
            Option.Some(condition) => Option.Some(proof_not(condition))
            Option.None => Option.None
        }
    }
    if value.kind != ExprKind.Binary || length(value.children) != 2 ||
    (value.text != "<" && value.text != "<=" && value.text != ">" && value.text != ">=" && value.text != "==") {
        return Option.None
    }
    let first = get(value.children, 0)
    let second = get(value.children, 1)
    if !list_read_expression(first) || !list_read_expression(second) ||
    !has_bound(first, identity) || !has_bound(second, identity) {
        return Option.None
    }
    let children = clone(value.children)
    set(children, side, loop_replace_bound(get(children, side), identity, replacement))
    Option.Some(proof_expr(value, value.kind, value.ty, value.text, value.index, children))
}

fn loop_counted_relation(value Expr) Bool {
    if count_expression(value) {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if loop_counted_relation(get(value.children, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn loop_boundary_relations(proof Verification, value Expr, candidates List[LoopCandidate],
    boundary Expr, entry State) {
    let endpoint = proof_expr(boundary, ExprKind.Binary, 1, "-", -1,
        proof_children(boundary, proof_expr(boundary, ExprKind.Integer, 1, "1", -1, new[Expr]())))
    var side = 0
    while side < 2 {
        match loop_relation_boundary(get(value.children, 2), value.index, endpoint, side) {
            Option.Some(condition) => {
                let prefix = quantified_value(value, value.index, get(value.children, 0), boundary, condition)
                propose_quantified(proof, candidates, prefix, entry)
                let valid = proof_expr(value, ExprKind.Binary, 2, "<", -1,
                    proof_children(endpoint, get(value.children, 1)))
                propose_quantified(proof, candidates, guarded_value(valid, prefix), entry)
            }
            Option.None => {
            }
        }
        side = side + 1
    }
}

// Quantified postconditions propose prefix/suffix relations at mutable cursor
// boundaries. Proposals are mathematical invariants, not evaluated source code;
// every one must hold initially and on all backedges before it may be assumed.
fn loop_quantified_clauses(proof Verification, value Expr, candidates List[LoopCandidate],
    boundaries List[Expr], entry State, depth Int) {
    if depth <= 0 || length(candidates) >= 64 {
        return
    }
    if value.kind == ExprKind.Intrinsic && value.text == "proof_logical" {
        loop_quantified_clauses(proof, get(value.children, 0), candidates, boundaries, entry, depth - 1)
        return
    }
    if value.kind == ExprKind.Intrinsic && value.text == "proof_scan_checks" {
        // Sufficient scan safety is proved separately, not an invariant hint.
        return
    }
    if contains_application(value) {
        propose_quantified(proof, candidates, value, entry)
    }
    if value.kind == ExprKind.Binary && value.text == "&&" {
        propose_quantified(proof, candidates, value, entry)
    }
    if quantified_expression(value) {
        propose_quantified(proof, candidates, value, entry)
        if loop_counted_relation(get(value.children, 2)) {
            // Histogram equality is already a whole-sequence invariant.
            return
        }
        var index = 0
        while index < length(boundaries) && length(candidates) < 64 {
            let boundary = get(boundaries, index)
            propose_quantified(proof, candidates, quantified_value(value, value.index,
                    get(value.children, 0), boundary, get(value.children, 2)), entry)
            propose_quantified(proof, candidates, quantified_value(value, value.index,
                    boundary, get(value.children, 1), get(value.children, 2)), entry)
            loop_boundary_relations(proof, value, candidates, boundary, entry)
            index = index + 1
        }
    }
    var index = 0
    while index < length(value.children) {
        loop_quantified_clauses(proof, get(value.children, index), candidates, boundaries, entry, depth - 1)
        index = index + 1
    }
}

fn loop_quantified_candidates(proof Verification, clauses List[Expr], candidates List[LoopCandidate], writes List[Bool], loop Expr, entry State) {
    let cursors = clone(writes)
    var local = 0
    while local < length(cursors) {
        if scan_mentions(get(loop.children, 0), local) {
            set(cursors, local, true)
        }
        local = local + 1
    }
    let boundaries = new[Expr]()
    let source = if loop_call_free(loop) {
        loop
    } else {
        match loop_affine_suggestion(proof, loop, [256]) {
            Result.Ok(value) => value
            Result.Err(_) => loop
        }
    }
    loop_boundaries(source, cursors, entry, boundaries, 64)
    var index = 0
    while index < length(clauses) {
        loop_quantified_clauses(proof, get(clauses, index), candidates, boundaries, entry, 64)
        index = index + 1
    }
}

fn quantified_candidate_preserved(proof Verification, candidate LoopCandidate, state State) Bool {
    match candidate {
        LoopCandidate.Guard(value, extended) => {
            match loop_guard_views(proof, value, state) {
                Result.Ok(current) => match loop_predicate(candidate, current) {
                    Result.Ok(fact) => loop_entails(proof, fact, current, extended)
                    Result.Err(_) => loop_holds(Predicate.Constant(false), current)
                }
                Result.Err(_) => false
            }
        }
        _ => loop_candidate_preserved(proof, candidate, state)
    }
}
