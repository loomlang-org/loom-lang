test fn inline_terms_scaled_pairs_match_original_composition() {
    let zero = integer(0)
    let large = decimal("123456789012345678901234567890123456789012345678901234567890123456789")
    let rows = [constant(zero), constant(large), variable(2), Linear {
            constant = negate(large)
            terms = terms_from_list([Term {
                        id = -1,
                        factor = zero
                    },
                    Term {
                        id = 2,
                        factor = integer(-3)
                    }, Term {
                        id = 7,
                        factor = large
                    }])
        }, Linear {
            constant = large
            terms = terms_from_list([Term {
                        id = 2,
                        factor = zero
                    },
                    Term {
                        id = 2,
                        factor = integer(3)
                    }, Term {
                        id = 8,
                        factor = zero
                    }])
        }, Linear {
            constant = large
            terms = terms_from_list([Term {
                        id = 2,
                        factor = zero
                    }])
        }]
    let factors = [zero, integer(1), integer(-1), integer(2), large, negate(large)]
    var left = 0
    while left < length(rows) {
        var right = 0
        while right < length(rows) {
            var first = 0
            while first < length(factors) {
                var second = 0
                while second < length(factors) {
                    let a = get(rows, left)
                    let b = get(rows, right)
                    let original = add(scale(a, get(factors, first)), scale(b, get(factors, second)))
                    let fused = add_scaled_pair(a, get(factors, first), b, get(factors, second))
                    assert compare(original.constant, fused.constant) == 0
                    assert same_terms(original.terms, fused.terms)
                    second = second + 1
                }
                first = first + 1
            }
            right = right + 1
        }
        left = left + 1
    }
    assert term_count(get(rows, 3).terms) == 3
    assert compare(term_at(get(rows, 3).terms, 1).factor, integer(-3)) == 0
    assert term_count(get(rows, 4).terms) == 3
    assert number_size(term_at(get(rows, 4).terms, 0).factor) == 0
    assert compare(term_at(get(rows, 4).terms, 1).factor, integer(3)) == 0
}
