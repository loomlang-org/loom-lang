import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result
import std.option.Option
import std.text.byte
import std.text.length

// Proof arithmetic is mathematical, not machine arithmetic. Little-endian
// base-1e9 digits keep every intermediate digit operation inside checked Int.
// Canonical large digits are read-only after construction, including shared
// results. Six base-1e9 digits fit in three inline base-1e18 chunks. Larger
// magnitudes retain the exact, unbounded digit representation.
record Number {
    negative Bool
    small Int
    middle Int
    upper Int
    digits Option[List[Int]]
}

fn packed_digits(digits List[Int], start Int, size Int) Int {
    let low = if start < size {
        get(digits, start)
    } else {
        0
    }
    let high = if start + 1 < size {
        get(digits, start + 1)
    } else {
        0
    }
    low + high * 1000000000
}

fn number(negative Bool, digits List[Int]) Number {
    var size = length(digits)
    while size > 0 && get(digits, size - 1) == 0 {
        size = size - 1
    }
    if size <= 6 {
        return Number {
            negative = negative && size != 0
            small = packed_digits(digits, 0, size)
            middle = packed_digits(digits, 2, size)
            upper = packed_digits(digits, 4, size)
            digits = Option.None
        }
    }
    if size == length(digits) {
        return Number {
            negative = negative
            small = 0
            middle = 0
            upper = 0
            digits = Option.Some(digits)
        }
    }
    let trimmed = new[Int]()
    var index = 0
    while index < size {
        push(trimmed, get(digits, index))
        index = index + 1
    }
    Number {
        negative = negative
        small = 0
        middle = 0
        upper = 0
        digits = Option.Some(trimmed)
    }
}

fn integer(value Int) Number {
    let remaining = if value > 0 {
        -value
    } else {
        value
    }
    Number {
        negative = value < 0
        small = -(remaining % 1000000000000000000)
        middle = -(remaining / 1000000000000000000)
        upper = 0
        digits = Option.None
    }
}

// Logical base-1e9 width, including the existing proof precision limits.
// The inline chunks change storage, not mathematical width or proof budgets.
fn number_size(value Number) Int {
    match value.digits {
        Option.None => if value.upper != 0 {
            if value.upper < 1000000000 {
                5
            } else {
                6
            }
        } else if value.middle != 0 {
            if value.middle < 1000000000 {
                3
            } else {
                4
            }
        } else if value.small == 0 {
            0
        }
        else if value.small < 1000000000 {
            1
        } else {
            2
        }
        Option.Some(digits) => length(digits)
    }
}

fn negate(value Number) Number {
    Number {
        negative = !value.negative && number_size(value) != 0
        small = value.small
        middle = value.middle
        upper = value.upper
        digits = value.digits
    }
}

fn magnitude(a Number, b Number) Int {
    if number_size(a) < number_size(b) {
        return -1
    }
    if number_size(a) > number_size(b) {
        return 1
    }
    var index = number_size(a)
    while index > 0 {
        index = index - 1
        if digit(a, index) < digit(b, index) {
            return -1
        }
        if digit(a, index) > digit(b, index) {
            return 1
        }
    }
    0
}

fn compare(a Number, b Number) Int {
    if a.negative != b.negative {
        return if a.negative {
            -1
        } else {
            1
        }
    }
    let order = magnitude(a, b)
    if a.negative {
        -order
    } else {
        order
    }
}

fn digit(value Number, index Int) Int {
    match value.digits {
        Option.None => if index < 6 {
            let chunk = if index < 2 {
                value.small
            }
            else if index < 4 {
                value.middle
            } else {
                value.upper
            }
            if index % 2 == 0 {
                chunk % 1000000000
            } else {
                chunk / 1000000000
            }
        } else {
            0
        }
        Option.Some(digits) => if index < length(digits) {
            get(digits, index)
        } else {
            0
        }
    }
}

// Construction-only update: every caller starts from a fresh inline zero.
// A spilled buffer belongs only to that builder until finish_number publishes
// it. Input Numbers and their read-only digit buffers are never passed here.
fn building_digit(value Number, index Int, coefficient Int) Number {
    match value.digits {
        Option.Some(digits) => {
            if coefficient == 0 && index >= length(digits) {
                return value
            }
            while length(digits) <= index {
                push(digits, 0)
            }
            set(digits, index, coefficient)
            value
        }
        Option.None => {
            if index < 6 {
                let original = if index < 2 {
                    value.small
                }
                else if index < 4 {
                    value.middle
                } else {
                    value.upper
                }
                let packed = if index % 2 == 0 {
                    original / 1000000000 * 1000000000 + coefficient
                } else {
                    original % 1000000000 + coefficient * 1000000000
                }
                return Number {
                    negative = false
                    small = if index < 2 {
                        packed
                    } else {
                        value.small
                    }
                    middle = if index >= 2 && index < 4 {
                        packed
                    } else {
                        value.middle
                    }
                    upper = if index >= 4 {
                        packed
                    } else {
                        value.upper
                    }
                    digits = Option.None
                }
            }
            if coefficient == 0 {
                return value
            }
            let digits = [digit(value, 0), digit(value, 1), digit(value, 2),
                digit(value, 3), digit(value, 4), digit(value, 5)]
            while length(digits) <= index {
                push(digits, 0)
            }
            set(digits, index, coefficient)
            Number {
                negative = false
                small = 0
                middle = 0
                upper = 0
                digits = Option.Some(digits)
            }
        }
    }
}

fn finish_number(value Number, negative Bool) Number {
    match value.digits {
        Option.Some(digits) => number(negative, digits)
        Option.None => Number {
            negative = negative && number_size(value) != 0
            small = value.small
            middle = value.middle
            upper = value.upper
            digits = Option.None
        }
    }
}

fn unit(value Number) Bool {
    number_size(value) == 1 && value.small == 1
}

fn sum(a Number, b Number) Number {
    if number_size(a) == 0 {
        return b
    }
    if number_size(b) == 0 {
        return a
    }
    if number_size(a) == 1 && number_size(b) == 1 {
        let left = if a.negative {
            -a.small
        } else {
            a.small
        }
        let right = if b.negative {
            -b.small
        } else {
            b.small
        }
        return integer(left + right)
    }
    if a.negative != b.negative {
        if magnitude(a, b) < 0 {
            return difference(b, a)
        }
        return difference(a, b)
    }
    var output = integer(0)
    var carry = 0
    var index = 0
    while index < number_size(a) || index < number_size(b) || carry != 0 {
        let value = digit(a, index) + digit(b, index) + carry
        output = building_digit(output, index, value % 1000000000)
        carry = value / 1000000000
        index = index + 1
    }
    finish_number(output, a.negative)
}

// Absolute subtraction, with |a| >= |b|; keep the sign of a.
fn difference(a Number, b Number) Number {
    if number_size(b) == 0 {
        return a
    }
    if number_size(a) <= 1 && number_size(b) <= 1 {
        return integer(if a.negative {
                b.small - a.small
            } else {
                a.small - b.small
            })
    }
    var output = integer(0)
    var borrow = 0
    var index = 0
    while index < number_size(a) {
        var value = digit(a, index) - digit(b, index) - borrow
        borrow = if value < 0 {
            1
        } else {
            0
        }
        if value < 0 {
            value = value + 1000000000
        }
        output = building_digit(output, index, value)
        index = index + 1
    }
    finish_number(output, a.negative)
}

fn subtract(a Number, b Number) Number {
    sum(a, negate(b))
}

fn product(a Number, b Number) Number {
    if number_size(a) == 0 {
        return a
    }
    if number_size(b) == 0 {
        return b
    }
    if unit(a) {
        return if a.negative {
            negate(b)
        } else {
            b
        }
    }
    if unit(b) {
        return if b.negative {
            negate(a)
        } else {
            a
        }
    }
    if number_size(a) == 1 && number_size(b) == 1 {
        // Both magnitudes are below 1e9, so the exact product fits Int.
        let value = a.small * b.small
        return integer(if a.negative != b.negative {
                -value
            } else {
                value
            })
    }
    var output = integer(0)
    var index = 0
    while index < number_size(a) {
        var other = 0
        var carry = 0
        while other < number_size(b) {
            let value = digit(output, index + other) + digit(a, index) * digit(b, other) + carry
            output = building_digit(output, index + other, value % 1000000000)
            carry = value / 1000000000
            other = other + 1
        }
        if carry != 0 {
            output = building_digit(output, index + other, carry)
        }
        index = index + 1
    }
    finish_number(output, a.negative != b.negative)
}

fn decimal(text Text) Number {
    var value = integer(0)
    var index = 0
    let negative = length(text) > 0 && byte(text, 0) == 45
    if negative {
        index = 1
    }
    while index < length(text) {
        value = sum(product(value, integer(10)), integer(byte(text, index) - 48))
        index = index + 1
    }
    if negative {
        negate(value)
    } else {
        value
    }
}

fn machine(value Number) Result[Int, Text] {
    if number_size(value) <= 1 {
        return Result.Ok(if value.negative {
                -value.small
            } else {
                value.small
            })
    }
    if compare(value, integer(-9223372036854775808)) < 0 || compare(value, integer(9223372036854775807)) > 0 {
        return Result.Err("proof integer is outside Int")
    }
    var remaining = 0
    var index = number_size(value)
    while index > 0 {
        index = index - 1
        remaining = remaining * 1000000000 - digit(value, index)
    }
    Result.Ok(if value.negative {
            remaining
        } else {
            -remaining
        })
}
