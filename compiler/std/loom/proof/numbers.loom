import std.list.new
import std.list.get
import std.list.push
import std.list.set
import std.list.length
import std.result.Result
import std.option.Option
import std.text.byte
import std.text.length

// Proof arithmetic is mathematical, not machine arithmetic. Little-endian
// base-1e9 digits keep every intermediate digit operation inside checked Int.
// Canonical large digits are read-only after construction, including shared
// results. Zero and one-digit magnitudes use the inline small field instead.
record Number {
    negative Bool
    small Int
    digits Option[List[Int]]
}

fn number(negative Bool, digits List[Int]) Number {
    var size = length(digits)
    while size > 0 && get(digits, size - 1) == 0 {
        size = size - 1
    }
    if size <= 1 {
        return Number {
            negative = negative && size != 0
            small = if size == 0 {
                0
            } else {
                get(digits, 0)
            }
            digits = Option.None
        }
    }
    if size == length(digits) {
        return Number {
            negative = negative
            small = 0
            digits = Option.Some(digits)
        }
    }
    let trimmed = new[Int]()
    var index = 0
    while index < size {
        push(trimmed, get(digits, index))
        index = index + 1
    }
    Number {
        negative = negative
        small = 0
        digits = Option.Some(trimmed)
    }
}

fn integer(value Int) Number {
    if value > -1000000000 && value < 1000000000 {
        return Number {
            negative = value < 0
            small = if value < 0 {
                -value
            } else {
                value
            }
            digits = Option.None
        }
    }
    var remaining = if value > 0 {
        -value
    } else {
        value
    }
    let digits = new[Int]()
    while remaining < 0 {
        push(digits, -(remaining % 1000000000))
        remaining = remaining / 1000000000
    }
    number(value < 0, digits)
}

// Logical base-1e9 width, including the existing proof precision limits.
// Zero and one-digit magnitudes are stored inline without a List allocation.
fn number_size(value Number) Int {
    match value.digits {
        Option.None => if value.small == 0 {
            0
        } else {
            1
        }
        Option.Some(digits) => length(digits)
    }
}

fn negate(value Number) Number {
    Number {
        negative = !value.negative && number_size(value) != 0
        small = value.small
        digits = value.digits
    }
}

fn magnitude(a Number, b Number) Int {
    if number_size(a) < number_size(b) {
        return -1
    }
    if number_size(a) > number_size(b) {
        return 1
    }
    var index = number_size(a)
    while index > 0 {
        index = index - 1
        if digit(a, index) < digit(b, index) {
            return -1
        }
        if digit(a, index) > digit(b, index) {
            return 1
        }
    }
    0
}

fn compare(a Number, b Number) Int {
    if a.negative != b.negative {
        return if a.negative {
            -1
        } else {
            1
        }
    }
    let order = magnitude(a, b)
    if a.negative {
        -order
    } else {
        order
    }
}

fn digit(value Number, index Int) Int {
    match value.digits {
        Option.None => if index == 0 {
            value.small
        } else {
            0
        }
        Option.Some(digits) => if index < length(digits) {
            get(digits, index)
        } else {
            0
        }
    }
}

fn unit(value Number) Bool {
    number_size(value) == 1 && value.small == 1
}

fn sum(a Number, b Number) Number {
    if number_size(a) == 0 {
        return b
    }
    if number_size(b) == 0 {
        return a
    }
    if number_size(a) == 1 && number_size(b) == 1 {
        let left = if a.negative {
            -a.small
        } else {
            a.small
        }
        let right = if b.negative {
            -b.small
        } else {
            b.small
        }
        return integer(left + right)
    }
    if a.negative != b.negative {
        if magnitude(a, b) < 0 {
            return difference(b, a)
        }
        return difference(a, b)
    }
    let digits = new[Int]()
    var carry = 0
    var index = 0
    while index < number_size(a) || index < number_size(b) || carry != 0 {
        let value = digit(a, index) + digit(b, index) + carry
        push(digits, value % 1000000000)
        carry = value / 1000000000
        index = index + 1
    }
    number(a.negative, digits)
}

// Absolute subtraction, with |a| >= |b|; keep the sign of a.
fn difference(a Number, b Number) Number {
    if number_size(b) == 0 {
        return a
    }
    if number_size(a) <= 1 && number_size(b) <= 1 {
        return integer(if a.negative {
                b.small - a.small
            } else {
                a.small - b.small
            })
    }
    let digits = new[Int]()
    var borrow = 0
    var index = 0
    while index < number_size(a) {
        var value = digit(a, index) - digit(b, index) - borrow
        borrow = if value < 0 {
            1
        } else {
            0
        }
        if value < 0 {
            value = value + 1000000000
        }
        push(digits, value)
        index = index + 1
    }
    number(a.negative, digits)
}

fn subtract(a Number, b Number) Number {
    sum(a, negate(b))
}

fn product(a Number, b Number) Number {
    if number_size(a) == 0 {
        return a
    }
    if number_size(b) == 0 {
        return b
    }
    if unit(a) {
        return if a.negative {
            negate(b)
        } else {
            b
        }
    }
    if unit(b) {
        return if b.negative {
            negate(a)
        } else {
            a
        }
    }
    if number_size(a) == 1 && number_size(b) == 1 {
        // Both magnitudes are below 1e9, so the exact product fits Int.
        let value = a.small * b.small
        return integer(if a.negative != b.negative {
                -value
            } else {
                value
            })
    }
    let digits = new[Int]()
    var index = 0
    while index < number_size(a) + number_size(b) {
        push(digits, 0)
        index = index + 1
    }
    index = 0
    while index < number_size(a) {
        var other = 0
        var carry = 0
        while other < number_size(b) {
            let value = get(digits, index + other) + digit(a, index) * digit(b, other) + carry
            set(digits, index + other, value % 1000000000)
            carry = value / 1000000000
            other = other + 1
        }
        if carry != 0 {
            set(digits, index + other, carry)
        }
        index = index + 1
    }
    number(a.negative != b.negative, digits)
}

fn decimal(text Text) Number {
    var value = integer(0)
    var index = 0
    let negative = length(text) > 0 && byte(text, 0) == 45
    if negative {
        index = 1
    }
    while index < length(text) {
        value = sum(product(value, integer(10)), integer(byte(text, index) - 48))
        index = index + 1
    }
    if negative {
        negate(value)
    } else {
        value
    }
}

fn machine(value Number) Result[Int, Text] {
    if number_size(value) <= 1 {
        return Result.Ok(if value.negative {
                -value.small
            } else {
                value.small
            })
    }
    if compare(value, integer(-9223372036854775808)) < 0 || compare(value, integer(9223372036854775807)) > 0 {
        return Result.Err("proof integer is outside Int")
    }
    var remaining = 0
    var index = number_size(value)
    while index > 0 {
        index = index - 1
        remaining = remaining * 1000000000 - digit(value, index)
    }
    Result.Ok(if value.negative {
            remaining
        } else {
            -remaining
        })
}
