record LoopHistogramTerm {
    receiver Expr
    end Expr
    fields List[BagField]
    factor Number
}

fn loop_body_bindings(value Expr, declared List[Bool], budget List[Int], depth Int) {
    if depth <= 0 || !conjunction_step(budget) {
        return
    }
    if value.kind == ExprKind.Let && value.index >= 0 && value.index < length(declared) {
        set(declared, value.index, true)
    }
    var index = 0
    while index < length(value.children) {
        loop_body_bindings(get(value.children, index), declared, budget, depth - 1)
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var child = 0
        while child < length(body) {
            loop_body_bindings(get(body, child), declared, budget, depth - 1)
            child = child + 1
        }
        index = index + 1
    }
}

// Body declarations do not carry values between iterations in source scope.
// Exclude them from optional proposals; actual execution and havoc are intact.
fn loop_proposal_entry(proof Verification, body Expr, entry State) State {
    let declared = new[Bool]()
    var index = 0
    while index < length(entry.locals) {
        push(declared, false)
        index = index + 1
    }
    loop_body_bindings(body, declared, [256], 64)
    let locals = new[Value]()
    index = 0
    while index < length(entry.locals) {
        push(locals, if get(declared, index) {
                Value.Empty
            } else {
                get(entry.locals, index)
            })
        index = index + 1
    }
    State {
        locals = locals
        ..entry
    }
}

fn loop_histogram_requested(clauses List[Expr]) Bool {
    var index = 0
    while index < length(clauses) {
        if loop_counted_relation(get(clauses, index)) {
            return true
        }
        index = index + 1
    }
    false
}

fn loop_histogram_keys(clauses List[Expr]) List[List[BagField]] {
    let paths = new[List[BagField]]()
    var index = 0
    while index < length(clauses) {
        loop_histogram_keys(get(clauses, index), paths, 64)
        index = index + 1
    }
    paths
}

fn loop_histogram_keys(value Expr, paths List[List[BagField]], depth Int) {
    if depth <= 0 {
        return
    }
    if count_expression(value) {
        let path = count_fields(value)
        var index = 0
        while index < length(paths) {
            if same_bag_fields(path, get(paths, index)) {
                return
            }
            index = index + 1
        }
        push(paths, path)
    }
    var index = 0
    while index < length(value.children) {
        loop_histogram_keys(get(value.children, index), paths, depth - 1)
        index = index + 1
    }
}

fn histogram_column(program Program, ty Int, path List[Int], domain ScalarDomain, field Int, depth Int) Bool {
    if depth >= 16 || ty < 0 || ty >= length(program.types) {
        return false
    }
    let shape = get(program.types, ty)
    if shape.kind == TypeKind.Refined && length(shape.fields) == 1 {
        return histogram_column(program, get(shape.fields, 0).ty, path, domain, field, depth + 1)
    }
    if field == length(path) {
        return (ty == 1 || ty == 2 || ty == 3) && bag_domain(ty) == domain
    }
    if shape.kind == TypeKind.Enum {
        let selected = get(path, field)
        if selected == -1 {
            return field + 1 == length(path) && domain == ScalarDomain.Integer
        }
        if selected != -2 || field + 2 >= length(path) {
            return false
        }
        let variant = get(path, field + 1)
        let payload = get(path, field + 2)
        if variant < 0 || variant >= length(shape.variants) {
            return false
        }
        let fields = get(shape.variants, variant).fields
        return payload >= 0 && payload < length(fields) &&
        histogram_column(program, get(fields, payload), path, domain, field + 3, depth + 1)
    }
    if shape.kind != TypeKind.Record && shape.kind != TypeKind.Tuple {
        return false
    }
    let selected = get(path, field)
    selected >= 0 && selected < length(shape.fields) &&
    histogram_column(program, get(shape.fields, selected).ty, path, domain, field + 1, depth + 1)
}

fn histogram_list_column(program Program, ty Int, fields List[BagField]) Bool {
    if !proof_list_type(program, ty) || length(fields) == 0 {
        return false
    }
    let element = get(get(program.types, ty).arguments, 0)
    var index = 0
    while index < length(fields) {
        let field = get(fields, index)
        if !histogram_column(program, element, field.path, field.domain, 0, 0) {
            return false
        }
        index = index + 1
    }
    true
}

fn loop_histogram_needles(source Expr, fields List[BagField]) List[Expr] {
    let values = new[Expr]()
    var index = 0
    while index < length(fields) {
        let domain = get(fields, index).domain
        push(values, if domain == ScalarDomain.Boolean {
                proof_bool(source, false)
            }
            else if domain == ScalarDomain.Text {
                proof_expr(source, ExprKind.Text, 3, "", -1, [])
            }
            else {
                proof_expr(source, ExprKind.Integer, 1, "0", -1, [])
            })
        index = index + 1
    }
    values
}

fn loop_histogram_root(proof Verification, loop Expr, entry State, local Int) Bool {
    let ty = get(proof.function.locals, local).ty
    if !proof_list_type(proof.program, ty) ||
    !scan_mentions(loop, local) {
        return false
    }
    match get(entry.locals, local) {
        Value.List(_) => true
        _ => false
    }
}

// Signed prefix transfer search needs an actual indexed copy, including
// append copies. Scans do not need unrelated buffer hypotheses.
fn loop_histogram_enabled(proof Verification, loop Expr) Bool {
    if !proof.histograms || !proof.query.backend.enabled {
        return false
    }
    if loop_count_hint(proof, get(loop.children, 1), 64) {
        return false
    }
    var column = 0
    while column < length(proof.histogram_keys) {
        let terms = new[LoopHistogramTerm]()
        loop_histogram_transfers(proof, get(loop.children, 1), terms, get(proof.histogram_keys, column), 64, true)
        if length(terms) != 0 {
            return true
        }
        column = column + 1
    }
    false
}

// Explicit count invariants already provide the requested content relation.
// Do not add a second, stronger buffer hypothesis to that source proof.
fn loop_count_hint(proof Verification, body Expr, depth Int) Bool {
    if depth <= 0 {
        return false
    }
    if body.kind == ExprKind.Assert {
        return loop_counted_relation(loop_candidate_guard(proof, get(body.children, 0)))
    }
    if body.kind != ExprKind.Block {
        return false
    }
    var index = 0
    while index < length(body.children) {
        let item = get(body.children, index)
        if item.kind != ExprKind.Assert && item.kind != ExprKind.Block {
            return false
        }
        if loop_count_hint(proof, item, depth - 1) {
            return true
        }
        index = index + 1
    }
    false
}

fn loop_histogram_entry(proof Verification, loop Expr, entry State) State {
    if !proof.histograms || !proof.query.backend.enabled {
        return entry
    }
    var current = entry
    var index = 0
    while index < length(entry.locals) && index < length(proof.function.locals) {
        if loop_histogram_root(proof, loop, entry, index) {
            let receiver = proof_expr(loop, ExprKind.Local, get(proof.function.locals, index).ty, "", index, [])
            var column = 0
            while column < length(proof.histogram_keys) {
                let path = get(proof.histogram_keys, column)
                if histogram_list_column(proof.program, receiver.ty, path) {
                    let term = LoopHistogramTerm {
                        receiver = receiver
                        end = proof_expr(loop, ExprKind.Intrinsic, 1, "list_len", -1, [receiver])
                        fields = path
                        factor = integer(1)
                    }
                    match loop_histogram_views(proof, [term], current) {
                        Result.Ok(viewed) => {
                            current = viewed
                        }
                        _ => {
                        }
                    }
                }
                column = column + 1
            }
        }
        index = index + 1
    }
    current
}

fn loop_histogram_views(proof Verification, terms List[LoopHistogramTerm], state State) Result[State, Text] {
    var current = state
    var index = 0
    while index < length(terms) {
        let term = get(terms, index)
        let value = count_value(term.receiver, term.receiver,
            loop_histogram_needles(term.receiver, term.fields), term.end, term.fields)
        current = loop_guard_views(proof, value, current)?
        index = index + 1
    }
    Result.Ok(current)
}

fn loop_histogram_terms(terms List[LoopHistogramTerm], state State) Result[List[BagTerm], Text] {
    let output = new[BagTerm]()
    var index = 0
    while index < length(terms) {
        let term = get(terms, index)
        let value = count_value(term.receiver, term.receiver,
            loop_histogram_needles(term.receiver, term.fields), term.end, term.fields)
        match integer_term(counted_value(value, state)?)? {
            IntegerTerm.Count(column, _) => {
                push(output, BagTerm {
                        column = column
                        size = list_value_index(pure(term.end, state)?)?
                        factor = term.factor
                    })
            }
            _ => {
                return Result.Err("histogram needs a tracked finite sequence")
            }
        }
        index = index + 1
    }
    Result.Ok(output)
}

fn loop_histogram_add(proof Verification, candidates List[LoopCandidate], terms List[LoopHistogramTerm], entry State) {
    if length(terms) == 0 || length(candidates) >= 64 {
        return
    }
    match loop_histogram_views(proof, terms, entry) {
        Result.Ok(viewed) => match loop_histogram_terms(terms, viewed) {
            Result.Ok(initial) => push(candidates, LoopCandidate.Histogram(terms, initial))
            Result.Err(_) => {
            }
        }
        Result.Err(_) => {
        }
    }
}

fn loop_histogram_term(terms List[LoopHistogramTerm], receiver Expr, end Expr, path List[BagField], factor Int) {
    var index = 0
    while index < length(terms) {
        let term = get(terms, index)
        if exact_expression(term.receiver, receiver) && exact_expression(term.end, end) && same_bag_fields(term.fields, path) &&
        compare(term.factor, integer(factor)) == 0 {
            return
        }
        index = index + 1
    }
    push(terms, LoopHistogramTerm {
            receiver = receiver
            end = end
            fields = path
            factor = integer(factor)
        })
}

// Reads and writes suggest prefix conservation. This is never an operation
// summary: every actual backedge, alias effect and fault still gets checked.
fn loop_histogram_transfers(proof Verification, value Expr, terms List[LoopHistogramTerm], path List[BagField], depth Int, nested Bool) {
    if depth <= 0 || (!nested && value.kind == ExprKind.While) || length(terms) >= 8 {
        return
    }
    let operation = loop_storage_primitive(proof, value)
    let indexed = operation == "list_set" && length(value.children) == 3
    let appended = operation == "list_push" && length(value.children) == 2
    if indexed || appended {
        let read = get(value.children, if indexed {
                2
            } else {
                1
            })
        let element = count_read(read)
        if loop_storage_primitive(proof, element) == "list_get" && length(element.children) == 2 {
            let receiver = get(value.children, 0)
            let end = if indexed {
                get(value.children, 1)
            } else {
                proof_expr(value, ExprKind.Intrinsic, 1, "list_len", -1, [receiver])
            }
            let prefix = count_read_path(read)
            let source_path = new[BagField]()
            var field = 0
            while field < length(path) {
                let selected = get(path, field)
                let projected = clone(prefix)
                var index = 0
                while index < length(selected.path) {
                    push(projected, get(selected.path, index))
                    index = index + 1
                }
                push(source_path, BagField {
                        path = projected,
                        domain = selected.domain
                    })
                field = field + 1
            }
            if histogram_list_column(proof.program, receiver.ty, path) &&
            histogram_list_column(proof.program, get(element.children, 0).ty, source_path) {
                loop_histogram_term(terms, receiver, end, path, 1)
                loop_histogram_term(terms, get(element.children, 0), get(element.children, 1), source_path, -1)
            }
        }
    }
    var index = 0
    while index < length(value.children) {
        loop_histogram_transfers(proof, get(value.children, index), terms, path, depth - 1, nested)
        index = index + 1
    }
}

fn loop_histogram_candidates(proof Verification, loop Expr,
    candidates List[LoopCandidate], writes List[Bool], entry State) {
    if !proof.query.backend.enabled || !proof.histograms {
        return
    }
    var index = 0
    var transferred = false
    var column = 0
    while column < length(proof.histogram_keys) {
        let transfers = new[LoopHistogramTerm]()
        loop_histogram_transfers(proof, get(loop.children, 1), transfers, get(proof.histogram_keys, column), 64, false)
        loop_histogram_add(proof, candidates, transfers, entry)
        transferred = transferred || length(transfers) != 0
        column = column + 1
    }
    let roots = new[Expr]()
    index = 0
    while index < length(entry.locals) && index < length(proof.function.locals) {
        let ty = get(proof.function.locals, index).ty
        if proof_list_type(proof.program, ty) &&
        scan_mentions(loop, index) {
            match get(entry.locals, index) {
                Value.List(_) => {
                    let receiver = proof_expr(loop, ExprKind.Local, ty, "", index, [])
                    push(roots, receiver)
                    let size = proof_expr(loop, ExprKind.Intrinsic, 1, "list_len", -1, [receiver])
                    var column = 0
                    while column < length(proof.histogram_keys) {
                        let path = get(proof.histogram_keys, column)
                        if get(writes, index) && histogram_list_column(proof.program, ty, path) {
                            loop_histogram_add(proof, candidates, [LoopHistogramTerm {
                                        receiver = receiver
                                        end = size
                                        fields = path
                                        factor = integer(1)
                                    }], entry)
                        }
                        column = column + 1
                    }
                }
                _ => {
                }
            }
        }
        index = index + 1
    }
    // A guard cursor partitions two initialized buffers at the same cut.
    if transferred {
        return
    }
    var cursor = 0
    while cursor < length(writes) && cursor < length(proof.function.locals) {
        if get(writes, cursor) && get(proof.function.locals, cursor).ty == 1 &&
        scan_mentions(get(loop.children, 0), cursor) {
            let cut = proof_expr(loop, ExprKind.Local, 1, "", cursor, [])
            var first = 0
            while first < length(roots) {
                var second = first + 1
                while second < length(roots) {
                    let a = get(roots, first)
                    let b = get(roots, second)
                    if !get(writes, a.index) && !get(writes, b.index) {
                        var column = 0
                        while column < length(proof.histogram_keys) {
                            let path = get(proof.histogram_keys, column)
                            if histogram_list_column(proof.program, a.ty, path) &&
                            histogram_list_column(proof.program, b.ty, path) {
                                loop_histogram_add(proof, candidates, [
                                        LoopHistogramTerm {
                                            receiver = a
                                            end = cut
                                            fields = path
                                            factor = integer(1)
                                        },
                                        LoopHistogramTerm {
                                            receiver = b
                                            end = cut
                                            fields = path
                                            factor = integer(-1)
                                        },
                                    ], entry)
                            }
                            column = column + 1
                        }
                    }
                    second = second + 1
                }
                first = first + 1
            }
        }
        cursor = cursor + 1
    }
}
