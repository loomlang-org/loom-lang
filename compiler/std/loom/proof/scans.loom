// Derive bounded quantification from checked source control flow, never from a
// helper's name or declared result. Runtime helpers keep their ordinary loops.
fn scan_block(value Expr) Bool {
    var index = 0
    while index < length(value.children) {
        if get(value.children, index).kind == ExprKind.While {
            return true
        }
        index = index + 1
    }
    false
}

fn scan_mentions(value Expr, local Int) Bool {
    if value.kind == ExprKind.Local && value.index == local {
        return true
    }
    var index = 0
    while index < length(value.children) {
        if scan_mentions(get(value.children, index), local) {
            return true
        }
        index = index + 1
    }
    index = 0
    while index < length(value.arms) {
        let body = get(value.arms, index).body
        var item = 0
        while item < length(body) {
            if scan_mentions(get(body, item), local) {
                return true
            }
            item = item + 1
        }
        index = index + 1
    }
    false
}

fn scan_unit_step(value Expr, local Int) Bool {
    if value.kind != ExprKind.Assign || value.index != local || length(value.children) != 1 {
        return false
    }
    let step = get(value.children, 0)
    if step.kind != ExprKind.Binary || step.text != "+" || length(step.children) != 2 {
        return false
    }
    let first = get(step.children, 0)
    let second = get(step.children, 1)
    first.kind == ExprKind.Local && first.index == local && second.kind == ExprKind.Integer && second.text == "1"
}

fn scan_return(value Expr, truth Bool) Bool {
    if value.kind == ExprKind.Block && length(value.children) == 1 {
        return scan_return(get(value.children, 0), truth)
    }
    if value.kind == ExprKind.Return && length(value.children) == 1 {
        return scan_return(get(value.children, 0), truth)
    }
    is_bool(value, truth)
}

fn scan_binder(context Expansion) Int {
    let identity = get(context.binders, 0)
    set(context.binders, 0, identity + 1)
    -1 - identity
}

fn quantified_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && (value.text == "proof_all" || value.text == "proof_scan_checks") && length(value.children) == 3
}

fn bound_expression(value Expr) Bool {
    value.kind == ExprKind.Intrinsic && value.text == "proof_bound" && length(value.children) == 0
}

fn quantified_value(source Expr, identity Int, start Expr, end Expr, condition Expr) Expr {
    let children = proof_children(start, end)
    push(children, condition)
    proof_expr(source, ExprKind.Intrinsic, 2,
        if source.text == "proof_scan_checks" {
            "proof_scan_checks"
        } else {
            "proof_all"
        }, identity, children)
}

fn rename_bound(value Expr, before Int, after Int) Expr {
    if bound_expression(value) && value.index == before {
        return proof_expr(value, value.kind, value.ty, value.text, after, value.children)
    }
    if quantified_expression(value) && value.index == before {
        return value
    }
    let children = new[Expr]()
    var index = 0
    while index < length(value.children) {
        push(children, rename_bound(get(value.children, index), before, after))
        index = index + 1
    }
    proof_expr(value, value.kind, value.ty, value.text, value.index, children)
}

fn scan_checks(context Expansion, inner Expansion, source Expr, guard Expr,
    identity Int, start Expr, end Expr, member Expr) Result[Bool, Text] {
    var index = 0
    while index < length(inner.checks) {
        let check = get(inner.checks, index)
        let condition = if check.required {
            check.value
        } else {
            proof_expr(check.value, ExprKind.Binary, 2, "==", -1, proof_children(check.value, check.value))
        }
        if length(context.checks) >= 256 {
            return Result.Err("helper evaluation budget exhausted")
        }
        let checks = quantified_value(source, identity, start, end,
            guarded_value(proof_and(member, check.guard), condition))
        push(context.checks, Evaluation {
                guard = guard
                value = proof_expr(checks, checks.kind, checks.ty, "proof_scan_checks", checks.index, checks.children)
                required = true
                universal = true
            })
        index = index + 1
    }
    Result.Ok(true)
}

fn scan_context(context Expansion) Expansion {
    Expansion {
        program = context.program
        list_lengths = context.list_lengths
        budget = context.budget
        active = context.active
        checks = new[Evaluation]()
        observations = context.observations
        origins = context.origins
        binders = context.binders
    }
}

fn expanded_quantifier(context Expansion, value Expr, guard Expr,
    bindings List[ExpansionBinding], locals List[Local], self Bool,
    calls Int, depth Int) Result[Expr, Text] {
    let identity = scan_binder(context)
    let start = expanded(context, get(value.children, 0), guard, bindings, locals, self, calls, depth + 1)?
    let end = expanded(context, get(value.children, 1), guard, bindings, locals, self, calls, depth + 1)?
    let inner = scan_context(context)
    let condition = expanded(inner, rename_bound(get(value.children, 2), value.index, identity),
        proof_bool(value, true), bindings, locals, self, calls, depth + 1)?
    discard scan_checks(context, inner, value, guard, identity, start, end, proof_bool(value, true))?
    Result.Ok(quantified_value(value, identity, start, end, condition))
}

fn expanded_scan(context Expansion, value Expr, guard Expr,
    bindings List[ExpansionBinding], locals List[Local], self Bool,
    calls Int, depth Int) Result[Expr, Text] {
    var position = 0
    while position < length(value.children) && get(value.children, position).kind == ExprKind.Let {
        discard expanded_binding(context, get(value.children, position), guard,
            bindings, locals, self, calls, depth + 1)?
        position = position + 1
    }
    if position + 2 != length(value.children) {
        return Result.Err("pure loop proof needs a bounded Boolean scan")
    }
    let tail = scan_tail(get(value.children, position + 1))
    let counting = tail.kind == ExprKind.Local && tail.ty == 1
    if !counting && tail.ty != 2 {
        return Result.Err("pure scan must return its Boolean result or zero-based count")
    }
    let iteration = get(value.children, position)
    if iteration.kind != ExprKind.While || length(iteration.children) != 2 {
        return Result.Err("pure loop proof needs one bounded scan")
    }
    let limit_test = match scan_exclusive_test(get(iteration.children, 0)) {
        Option.Some(value) => value
        Option.None => {
            return Result.Err("pure loop proof needs a directed integer bound")
        }
    }
    let body = get(iteration.children, 1)
    if body.kind != ExprKind.Block {
        return Result.Err("pure loop proof needs a block body")
    }
    var prefix = 0
    while prefix < length(body.children) && get(body.children, prefix).kind == ExprKind.Let {
        prefix = prefix + 1
    }
    if length(body.children) == 0 || (counting && prefix + 2 != length(body.children)) {
        return Result.Err("pure scan needs local observations, one test and a unit step")
    }
    let cursor = get(limit_test.children, 0)
    if cursor.kind != ExprKind.Local || cursor.ty != 1 ||
    scan_mentions(get(limit_test.children, 1), cursor.index) ||
    scan_outer_write(get(limit_test.children, 1), bindings, 256) {
        return Result.Err("pure loop proof needs a stable bound and integer cursor")
    }
    let update = get(body.children, length(body.children) - 1)
    let stride = match scan_step(update, cursor.index, limit_test.text == ">") {
        Option.Some(value) => value
        Option.None => {
            return Result.Err("pure scan needs a stable directed cursor step")
        }
    }
    if scan_outer_write(stride, bindings, 256) {
        return Result.Err("pure scan cursor step cannot rebind outer state")
    }
    if counting && (limit_test.text != "<" || !scan_unit_step(update, cursor.index)) {
        return Result.Err("count scan needs a forward unit step")
    }
    if !counting && scan_mentions(tail, cursor.index) {
        return Result.Err("pure Boolean scan tail must not observe its updated cursor")
    }
    let branch = get(body.children, prefix)
    if counting && (branch.kind != ExprKind.If || length(branch.children) != 2) {
        return Result.Err("pure Boolean scan needs one constant early return")
    }
    let simple = prefix + 2 == length(body.children) && branch.kind == ExprKind.If &&
    length(branch.children) == 2 && (scan_return(get(branch.children, 1), true) ||
        scan_return(get(branch.children, 1), false))
    if counting {
        let arm = get(branch.children, 1)
        var observation = 0
        while observation < prefix {
            if scan_mentions(get(body.children, observation), tail.index) {
                return Result.Err("count scan observations must not depend on its updated accumulator")
            }
            observation = observation + 1
        }
        let initial = expanded(context, tail, guard, bindings, locals, self, calls, depth + 1)?
        if tail.index == cursor.index || arm.kind != ExprKind.Block || length(arm.children) != 1 ||
        !scan_unit_step(get(arm.children, 0), tail.index) || initial.kind != ExprKind.Integer || initial.text != "0" ||
        scan_mentions(get(branch.children, 0), tail.index) || scan_mentions(get(limit_test.children, 1), tail.index) {
            return Result.Err("count scan needs a zero-based independent accumulator")
        }
    }
    let initial = expanded(context, cursor, guard, bindings, locals, self, calls, depth + 1)?
    let limit = expanded(context, get(limit_test.children, 1), guard, bindings, locals, self, calls, depth + 1)?
    // Inspect a stable step without claiming it ran. Empty scans and paths
    // returning before their update never evaluate it. Actual requirements
    // and faults are retained below, under the continuing iteration guard.
    let step = expanded(scan_context(context), stride, guard, clone(bindings), locals, self, calls, depth + 1)?
    let identity = scan_binder(context)
    let domain = scan_domain(context, value, initial, limit, step, identity, limit_test.text == ">", guard)?
    let start = domain.start
    let end = domain.end
    let items = clone(bindings)
    push(items, ExpansionBinding {
            local = cursor.index
            value = proof_expr(cursor, ExprKind.Intrinsic, 1, "proof_bound", identity, new[Expr]())
        })
    let inner = scan_context(context)
    let exits = if counting || simple {
        var observation = 0
        while observation < prefix {
            if scan_outer_write(get(body.children, observation), bindings, 256) {
                return Result.Err("pure scan observations cannot rebind outer state")
            }
            discard expanded_binding(inner, get(body.children, observation), proof_bool(value, true),
                items, locals, self, calls, depth + 1)?
            observation = observation + 1
        }
        if scan_outer_write(get(branch.children, 0), bindings, 256) {
            return Result.Err("pure scan conditions cannot rebind outer state")
        }
        let condition = expanded(inner, get(branch.children, 0), proof_bool(value, true),
            items, locals, self, calls, depth + 1)?
        let early_true = scan_return(get(branch.children, 1), true)
        ScanExit {
            condition = condition
            accepted = if early_true {
                condition
            } else {
                proof_bool(value, false)
            }
            all_false = !early_true
            all_true = early_true
        }
    } else {
        scan_branches(inner, body, items, locals, self, calls, depth + 1)?
    }
    // Only paths reaching the recursive call / cursor assignment evaluate its
    // arithmetic. This safety obligation belongs to the source transition.
    discard expanded(inner, get(update.children, 0), if counting {
            proof_bool(value, true)
        } else {
            proof_not(exits.condition)
        },
        items, locals, self, calls, depth + 1)?
    let summary = ScanExit {
        condition = proof_and(domain.member, exits.condition)
        accepted = proof_and(domain.member, exits.accepted)
        all_false = exits.all_false
        all_true = exits.all_true
    }
    discard scan_checks(context, inner, value, guard, identity, start, end, domain.member)?
    if counting {
        if start.kind != ExprKind.Integer || start.text != "0" {
            return Result.Err("count scan must start at the beginning of the List")
        }
        return counted_scan(context, value, summary.condition, end, identity)
    }
    let scanned = quantified_value(value, identity, start, end, proof_not(summary.condition))
    let continuation = expanded(context, tail, proof_and(guard, scanned),
        bindings, locals, self, calls, depth + 1)?
    Result.Ok(scan_result(context, value, summary, identity, start, end, continuation, domain.reverse))
}
