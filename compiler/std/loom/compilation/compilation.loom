import std.loom.typed.Program
import std.loom.project.BuildOption
import std.loom.binding.Program
import std.loom.proof.ProofBackend
import std.loom.checking.optimize_loop_assertions
import std.loom.lowering.lower
import std.loom.artifact.encode
import std.list.new
import std.list.get
import std.list.push
import std.list.length

pub record NativeInput {
    text Text
    entry Int
    tests Int
}

// The native compiler and public analysis use this same preparation boundary.
// Callers provide ordinarily checked IR. Analysis supplies a private copy so
// later lowering cannot mutate its published state.
pub fn prepare_native(program std.loom.typed.Program, targets List[BuildOption],
    bindings std.loom.binding.Program, backend ProofBackend, filter Text) NativeInput {
    let optimized = optimize_loop_assertions(program, backend)
    let selected = select_tests(optimized, filter)
    NativeInput {
        text = encode(lower(selected), targets, bindings)
        entry = selected.entry
        tests = length(selected.tests)
    }
}

import std.text.contains

// Selection changes executable roots, not checking or package visibility.
// Preserve IDs and declaration order so lowering and native reachability reuse
// the ordinary checked program, including its contracts and test isolation.
pub fn select_tests(program std.loom.typed.Program, filter Text) std.loom.typed.Program {
    if filter == "" {
        return program
    }
    let tests = new[Int]()
    let names = new[Text]()
    var index = 0
    while index < length(program.tests) {
        let name = get(program.test_names, index)
        if contains(name, filter) {
            push(tests, get(program.tests, index))
            push(names, name)
        }
        index = index + 1
    }
    std.loom.typed.Program {
        function_identities = program.function_identities
        types = program.types
        functions = program.functions
        entry = program.entry
        tests = tests
        test_names = names
        exports = program.exports
        interfaces = program.interfaces
        witnesses = program.witnesses
    }
}
