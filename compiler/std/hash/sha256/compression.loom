import std.bytes.new
import std.bytes.get
import std.bytes.set
import std.bytes.push
import std.list.new
import std.list.get
import std.list.set
import std.list.push

record Chain {
    h0 Int
    h1 Int
    h2 Int
    h3 Int
    h4 Int
    h5 Int
    h6 Int
    h7 Int
}

fn initial() Chain {
    Chain {
        h0 = 1779033703
        h1 = 3144134277
        h2 = 1013904242
        h3 = 2773480762
        h4 = 1359893119
        h5 = 2600822924
        h6 = 528734635
        h7 = 1541459225
    }
}

fn new_words() List[Int] {
    let words = std.list.new[Int]()
    var index = 0
    while index < 64 {
        push(words, 0)
        index = index + 1
    }
    words
}

fn zeroes(size Int) Bytes {
    let value = std.bytes.new()
    var index = 0
    while index < size {
        push(value, 0)
        index = index + 1
    }
    value
}

// Words stay in 0..2^32-1. Masking makes additions modulo 2^32 explicit;
// even the five-word round sum fits Int before masking.
fn rotate(value Int, count Int) Int {
    ((value >> count) | (value << (32 - count))) & 4294967295
}

fn load_block(words List[Int], value Bytes, start Int) {
    var index = 0
    while index < 16 {
        let position = start + index * 4
        set(words, index, (get(value, position) << 24) |
            (get(value, position + 1) << 16) |
            (get(value, position + 2) << 8) | get(value, position + 3))
        index = index + 1
    }
}

fn padded_byte(value Bytes, start Int, index Int, size Int, end Int, message_size Int) Int {
    if index < size {
        return get(value, start + index)
    }
    if index == size {
        return 128
    }
    if index < end - 8 {
        return 0
    }
    // FIPS 180-4 sections 5.1.1 and 6.2.2: encode the entire message length,
    // not just this tail. Shift rather than multiply when its high bit is set.
    ((message_size << 3) >> ((end - 1 - index) * 8)) & 255
}

fn compress(chain Chain, words List[Int], k List[Int]) Chain {
    var index = 16
    while index < 64 {
        let x = get(words, index - 15)
        let y = get(words, index - 2)
        let sigma0 = rotate(x, 7) ^ rotate(x, 18) ^ (x >> 3)
        let sigma1 = rotate(y, 17) ^ rotate(y, 19) ^ (y >> 10)
        set(words, index, (get(words, index - 16) + sigma0 + get(words, index - 7) + sigma1) & 4294967295)
        index = index + 1
    }
    var a = chain.h0
    var b = chain.h1
    var c = chain.h2
    var d = chain.h3
    var e = chain.h4
    var f = chain.h5
    var g = chain.h6
    var h = chain.h7
    // Eight rounds rotate the scalar roles back to their original names.
    // Only the two changed words are assigned in each round; the SHA-256
    // schedule, constants and modulo-2^32 arithmetic are unchanged.
    index = 0
    while index < 64 {
        let sum1_0 = rotate(e, 6) ^ rotate(e, 11) ^ rotate(e, 25)
        let choose_0 = (e & f) ^ (~e & g)
        let first_0 = (h + sum1_0 + choose_0 + get(k, index) + get(words, index)) & 4294967295
        let sum0_0 = rotate(a, 2) ^ rotate(a, 13) ^ rotate(a, 22)
        let majority_0 = (a & b) ^ (a & c) ^ (b & c)
        let second_0 = (sum0_0 + majority_0) & 4294967295
        d = (d + first_0) & 4294967295
        h = (first_0 + second_0) & 4294967295
        let sum1_1 = rotate(d, 6) ^ rotate(d, 11) ^ rotate(d, 25)
        let choose_1 = (d & e) ^ (~d & f)
        let first_1 = (g + sum1_1 + choose_1 + get(k, index + 1) + get(words, index + 1)) & 4294967295
        let sum0_1 = rotate(h, 2) ^ rotate(h, 13) ^ rotate(h, 22)
        let majority_1 = (h & a) ^ (h & b) ^ (a & b)
        let second_1 = (sum0_1 + majority_1) & 4294967295
        c = (c + first_1) & 4294967295
        g = (first_1 + second_1) & 4294967295
        let sum1_2 = rotate(c, 6) ^ rotate(c, 11) ^ rotate(c, 25)
        let choose_2 = (c & d) ^ (~c & e)
        let first_2 = (f + sum1_2 + choose_2 + get(k, index + 2) + get(words, index + 2)) & 4294967295
        let sum0_2 = rotate(g, 2) ^ rotate(g, 13) ^ rotate(g, 22)
        let majority_2 = (g & h) ^ (g & a) ^ (h & a)
        let second_2 = (sum0_2 + majority_2) & 4294967295
        b = (b + first_2) & 4294967295
        f = (first_2 + second_2) & 4294967295
        let sum1_3 = rotate(b, 6) ^ rotate(b, 11) ^ rotate(b, 25)
        let choose_3 = (b & c) ^ (~b & d)
        let first_3 = (e + sum1_3 + choose_3 + get(k, index + 3) + get(words, index + 3)) & 4294967295
        let sum0_3 = rotate(f, 2) ^ rotate(f, 13) ^ rotate(f, 22)
        let majority_3 = (f & g) ^ (f & h) ^ (g & h)
        let second_3 = (sum0_3 + majority_3) & 4294967295
        a = (a + first_3) & 4294967295
        e = (first_3 + second_3) & 4294967295
        let sum1_4 = rotate(a, 6) ^ rotate(a, 11) ^ rotate(a, 25)
        let choose_4 = (a & b) ^ (~a & c)
        let first_4 = (d + sum1_4 + choose_4 + get(k, index + 4) + get(words, index + 4)) & 4294967295
        let sum0_4 = rotate(e, 2) ^ rotate(e, 13) ^ rotate(e, 22)
        let majority_4 = (e & f) ^ (e & g) ^ (f & g)
        let second_4 = (sum0_4 + majority_4) & 4294967295
        h = (h + first_4) & 4294967295
        d = (first_4 + second_4) & 4294967295
        let sum1_5 = rotate(h, 6) ^ rotate(h, 11) ^ rotate(h, 25)
        let choose_5 = (h & a) ^ (~h & b)
        let first_5 = (c + sum1_5 + choose_5 + get(k, index + 5) + get(words, index + 5)) & 4294967295
        let sum0_5 = rotate(d, 2) ^ rotate(d, 13) ^ rotate(d, 22)
        let majority_5 = (d & e) ^ (d & f) ^ (e & f)
        let second_5 = (sum0_5 + majority_5) & 4294967295
        g = (g + first_5) & 4294967295
        c = (first_5 + second_5) & 4294967295
        let sum1_6 = rotate(g, 6) ^ rotate(g, 11) ^ rotate(g, 25)
        let choose_6 = (g & h) ^ (~g & a)
        let first_6 = (b + sum1_6 + choose_6 + get(k, index + 6) + get(words, index + 6)) & 4294967295
        let sum0_6 = rotate(c, 2) ^ rotate(c, 13) ^ rotate(c, 22)
        let majority_6 = (c & d) ^ (c & e) ^ (d & e)
        let second_6 = (sum0_6 + majority_6) & 4294967295
        f = (f + first_6) & 4294967295
        b = (first_6 + second_6) & 4294967295
        let sum1_7 = rotate(f, 6) ^ rotate(f, 11) ^ rotate(f, 25)
        let choose_7 = (f & g) ^ (~f & h)
        let first_7 = (a + sum1_7 + choose_7 + get(k, index + 7) + get(words, index + 7)) & 4294967295
        let sum0_7 = rotate(b, 2) ^ rotate(b, 13) ^ rotate(b, 22)
        let majority_7 = (b & c) ^ (b & d) ^ (c & d)
        let second_7 = (sum0_7 + majority_7) & 4294967295
        e = (e + first_7) & 4294967295
        a = (first_7 + second_7) & 4294967295
        index = index + 8
    }
    Chain {
        h0 = (chain.h0 + a) & 4294967295
        h1 = (chain.h1 + b) & 4294967295
        h2 = (chain.h2 + c) & 4294967295
        h3 = (chain.h3 + d) & 4294967295
        h4 = (chain.h4 + e) & 4294967295
        h5 = (chain.h5 + f) & 4294967295
        h6 = (chain.h6 + g) & 4294967295
        h7 = (chain.h7 + h) & 4294967295
    }
}

fn write_word(output Bytes, index Int, value Int) {
    set(output, index, (value >> 24) & 255)
    set(output, index + 1, (value >> 16) & 255)
    set(output, index + 2, (value >> 8) & 255)
    set(output, index + 3, value & 255)
}

fn finish(chain Chain, value Bytes, start Int, size Int, message_size Int,
    words List[Int], k List[Int]) Bytes {
    let end = if size < 56 {
        64
    } else {
        128
    }
    var current = chain
    var offset = 0
    while offset < end {
        var index = 0
        while index < 16 {
            var word = 0
            var part = 0
            while part < 4 {
                word = (word << 8) | padded_byte(value, start, offset + index * 4 + part, size, end, message_size)
                part = part + 1
            }
            set(words, index, word)
            index = index + 1
        }
        current = compress(current, words, k)
        offset = offset + 64
    }
    let output = zeroes(32)
    write_word(output, 0, current.h0)
    write_word(output, 4, current.h1)
    write_word(output, 8, current.h2)
    write_word(output, 12, current.h3)
    write_word(output, 16, current.h4)
    write_word(output, 20, current.h5)
    write_word(output, 24, current.h6)
    write_word(output, 28, current.h7)
    output
}
