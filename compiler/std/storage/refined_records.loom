import std.reflect.describe
import std.reflect.Kind

// Derive the visible base record's ordinary mapping, then construct the whole
// refined value after decoding its fields. Field codecs alone do not establish
// a predicate relating several fields. No implicit copy or alias protection is
// added; construction follows the language's continuing constraint rules.
fn refined_record_codec[T, Base](table Table, aliases List[(Text, Text)]) Result[PreparedRowCodec[T], CodecError] {
    comptime if std.reflect.describe[Base]().types[0].kind == Kind.Record && refined_codec_base[T, Base]() {
        let underlying = record_codec[Base](table, aliases)?
        let encoder = fn(value T) Result[List[Value], CodecError] {
            let base Base = value
            encode_prepared_row(underlying, base)
        }
        let decoder = fn(row List[Value]) Result[T, CodecError] {
            checked_refined_value[T, Base](decode_prepared_row(underlying, row)?)
        }
        Result.Ok(PreparedRowCodec {
                state = PreparedState {
                    table = codec_table(underlying)
                    encode_value = encoder
                    decode_value = decoder
                }
            })
    } else {
        Result.Err(CodecError.InvalidSchema)
    }
}
